{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.mjs",
    "e2e/**/*.spec.ts",
    "src/scripts/*.ts",
    "src/dev-pages/*.astro"
  ],
  "project": [
    "src/**/*.{ts,tsx,astro}",
    "scripts/**/*.mjs",
    "e2e/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-public"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "ignoreDependencies": [
    "tslib"
  ]
}
