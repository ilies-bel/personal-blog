{
  "name": "personal-blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:cockpit-plate": "node scripts/generate-cockpit-plate.mjs --check",
    "knip": "knip",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lhci": "lhci autorun",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshot": "node scripts/screenshot.mjs",
    "capture:mobile-hero": "node scripts/capture-mobile-hero.mjs",
    "bench": "node bench/run-bench.mjs",
    "bench:docker": "docker build -f bench/Dockerfile -t blog-bench . && docker run --rm -v \"$PWD/evidence:/app/evidence\" blog-bench",
    "bench:docker:4gb": "docker build -f bench/Dockerfile -t blog-bench . && docker run --rm --memory=4g --memory-swap=4g --cpus=2 -e BENCH_TAG=4gb -v \"$PWD/evidence:/app/evidence\" blog-bench",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/react": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "esbuild": "^0.25.12",
    "html-validate": "^11.5.5",
    "knip": "^6.14.2",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "packageExtensions": {
      "intl-messageformat": {
        "dependencies": {
          "tslib": "^2.6.0"
        }
      }
    }
  }
}
