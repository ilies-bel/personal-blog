# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# lighthouse ci local results (lab numbers fold into src/data/perf-report.json)
/.lighthouseci/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/screenshots/
/.playwright-mcp/

# local capture artifacts (density/nebula stage screenshots, not versioned)
/density-stage-*.png

# third-party Claude skill bundles (installed locally, not version-controlled)
/.claude/skills/

# agent git worktrees (local-only checkouts, not version-controlled)
/.claude/worktrees/

# local scratch: throwaway probe scripts + capture artifacts (not versioned)
/scratchpad/

# local agent/project context notes
/AGENTS.md
/CLAUDE.md
/DESIGN.md
/PRODUCT.md

# local MCP server registration (machine-specific)
/.mcp.json

# codegraph local index (regenerable via `codegraph init`)
/.codegraph/
