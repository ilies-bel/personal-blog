---
// DEV BLUEPRINT — a direct plate/reference comparison bench. Production never
// emits this route. The generated plate is the runtime source of truth; an
// optional worktree-root reference-v3.png is layered beneath it for iteration.
import { readFileSync } from 'node:fs';
import cockpitPlateHref from '../assets/cockpit/cockpit-plate.png?url';

const dev = import.meta.env.DEV;
let refHref = '';
if (dev) {
  try {
    refHref = `data:image/png;base64,${readFileSync(new URL('../../reference-v3.png', import.meta.url)).toString('base64')}`;
  } catch {
    refHref = '';
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>cockpit plate blueprint</title>
  </head>
  <body>
    {dev && (
      <figure id="overlay" aria-label="Cockpit plate comparison">
        {refHref && <img class="reference" src={refHref} alt="" />}
        <img class:list={['plate', { comparing: refHref }]} src={cockpitPlateHref} alt="" />
      </figure>
    )}
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  body { margin: 0; background: #050506; }
  figure {
    position: relative;
    width: 1920px;
    height: 1080px;
    margin: 0;
    overflow: hidden;
  }
  img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .plate.comparing { opacity: 0.56; }
</style>
