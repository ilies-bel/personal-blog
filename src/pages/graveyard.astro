---
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleScene from '../hero/components/ArticleScene.tsx';
import RouteEnding from '../components/RouteEnding.astro';
import { SITE_TITLE } from '../consts';
import { ogCardFor } from '../lib/ogCard';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// SPECIMEN LEDGER — P6: the specimens are a CONTENT COLLECTION
// (src/content/graveyard/*.mdx, schema in src/lib/contentSchemas.ts). The
// drawer record (interred/cause/lesson/…) is frontmatter; the story paragraphs
// are the MDX body. Order is the visual order of the cabinet drawers — oldest
// interment first, so the descent through the list IS the descent through the
// stellar-lifecycle journey [2.05 (red giant) → 0 (black hole)] driven by
// ArticleScene.
const specimens = (await getCollection('graveyard')).sort(
  (a, b) => a.data.interred.localeCompare(b.data.interred) || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  specimens.map(async (s) => ({ s, Content: (await render(s)).Content })),
);

// SCREENSHOT DELIVERY — the specimen screenshots ship through astro:assets
// (P5): AVIF/WebP sources + WebP fallback, sized for the figure column. The
// entry-body grid gives the figure ~26rem on desktop (1fr of a 1:1.5 split of
// the 68rem ledger) and ≤36rem when the grid stacks under 58rem — so 1x/2x of
// 36rem (576/1152px) plus a desktop-1x rung is every pixel any device paints.
// Never the raw pngs again: heydaniel.png shipped 679KB, keywordlens.png 509KB.
const SCREENSHOT_WIDTHS = [432, 864, 1152];
// The fallback <img src> rung. Also why this is a hardcoded number and not
// Math.min(src.width, …): reading ANY property off imported image metadata
// marks the original as referenced and ships the raw png into dist (see
// src/components/mdx/Img.astro). The service never upscales, so a narrower
// future screenshot would simply cap at its own width.
const SCREENSHOT_FALLBACK_WIDTH = 1152;
const SCREENSHOT_SIZES = '(max-width: 58rem) min(100vw - 2rem, 36rem), 26rem';

// SCREENSHOT RESOLUTION — frontmatter declares a validated FILENAME (schema:
// assetFilename), resolved here against src/assets/graveyard/ via
// import.meta.glob. NOT the content-collection image() helper: that route
// statically imports every original through .astro/content-assets.mjs and
// ships the raw pngs into dist (P5 gate violation) — this glob + <Picture>
// path emits only the transformed rungs, exactly like the pre-P6 direct
// import did. A filename that misses the glob throws HERE, at prerender, so a
// bad reference still fails the build with a named error.
const specimenShots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/graveyard/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const resolveShot = (filename: string): ImageMetadata => {
  const mod = specimenShots[`../assets/graveyard/${filename}`];
  if (!mod) {
    throw new Error(
      `graveyard specimen image "${filename}" not found in src/assets/graveyard/ ` +
        `(known: ${Object.keys(specimenShots).join(', ')})`,
    );
  }
  return mod.default;
};
---

<BaseLayout
  title="Graveyard"
  description={`Projects that didn't survive, by ${SITE_TITLE}. Not everything I start makes it. Here's what didn't, and what it taught me.`}
  ogImage={ogCardFor('graveyard')}
  type="website"
  bodyClass="graveyard-page"
>
  {/* BACKDROP — the same live hero engine the article scene-JOURNEY uses, here
      pinned to a SOMBER lifecycle window: descending the list of dead projects
      descends the stellar lifecycle from the RED GIANT (the bloated, dying
      star, stage 2.05) down through collapse to the BLACK HOLE itself (stage
      0). client:only so the page text + the corner chrome read fully without
      JS — the canvas is atmosphere, never the content. The dim wash + somber
      column-ellipse live in hero.css under body.graveyard-page .bh-backdrop. */}
  <ArticleScene client:only="react" journey={[2.05, 0]} />

  <section class="graveyard-hero" aria-labelledby="graveyard-title">
    <p class="graveyard-kicker">Graveyard</p>
    <h1 id="graveyard-title">Not everything survives.</h1>
    <p>Not everything I start makes it. Here is what didn't, and what it taught me.</p>
  </section>

  {/* role="group" legitimizes the aria-label (a bare div can't carry one). */}
  <div class="graveyard-list" role="group" aria-label="Failed and abandoned projects">
    {rendered.map(({ s, Content }) => (
      <article class="graveyard-entry" id={s.id}>
        {/* SPECIMEN DRAWER LABEL — the mono-caps record row above the headline,
            reading like the label slot on a cabinet drawer. Carries the real
            record (year of death, cause) — content, not a page counter. */}
        <p class="graveyard-entry-specimen">
          <span class="sr-only">Specimen record: </span>
          <span>INTERRED {s.data.interred}</span>
          <span class="graveyard-entry-specimen-sep" aria-hidden="true">·</span>
          <span>CAUSE: {s.data.cause}</span>
        </p>

        <header class="graveyard-entry-header">
          <h2 class="graveyard-entry-name"><span data-decode>{s.data.name}</span></h2>
          <div class="graveyard-entry-links">
            <a href={s.data.link.href} class="graveyard-link" target="_blank" rel="noopener noreferrer">
              {s.data.link.label}
            </a>
          </div>
        </header>

        <div class="graveyard-entry-body">
          <figure class="graveyard-figure">
            <Picture
              src={resolveShot(s.data.image.src)}
              alt={s.data.image.alt}
              class="graveyard-screenshot"
              width={SCREENSHOT_FALLBACK_WIDTH}
              widths={SCREENSHOT_WIDTHS}
              sizes={SCREENSHOT_SIZES}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              quality={70}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{s.data.image.caption}</figcaption>
          </figure>

          <div class="graveyard-copy">
            {/* THE BET (P13) — the hypothesis stated before the story, so the
                miss is auditable against what I believed going in. A real
                record from the specimen's frontmatter → mono-caps label. */}
            {s.data.hypothesis && (
              <dl class="graveyard-record graveyard-record-bet">
                <div class="graveyard-record-row">
                  <dt>Hypothesis</dt>
                  <dd>{s.data.hypothesis}</dd>
                </div>
              </dl>
            )}

            <Content />

            {/* THE AUTOPSY ROWS (P13) — what was visible before the end, and
                what outlived the death. Rows render only when the specimen's
                record carries them; both fields are optional in the schema. */}
            {(s.data.warningSigns.length > 0 || s.data.survivingInsight) && (
              <dl class="graveyard-record">
                {s.data.warningSigns.length > 0 && (
                  <div class="graveyard-record-row">
                    <dt>Warning signs</dt>
                    <dd>
                      <ul>
                        {s.data.warningSigns.map((sign) => <li>{sign}</li>)}
                      </ul>
                    </dd>
                  </div>
                )}
                {s.data.survivingInsight && (
                  <div class="graveyard-record-row">
                    <dt>What survived</dt>
                    <dd>{s.data.survivingInsight}</dd>
                  </div>
                )}
              </dl>
            )}

            <p class="graveyard-lesson">
              <span class="graveyard-lesson-label">What it taught me:</span>
              {' '}{s.data.lesson}
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>

  {/* ROUTE ENDING (P9) — the graveyard hands off to Writing: what survived the
      dead ends became the lessons on the shelf. */}
  <RouteEnding
    width="ledger"
    eyebrow="What survived"
    title="The dead ends became lessons"
    note="Every specimen here paid for a rule I now build by. The writing shelf is where those rules live on."
    href={href('writing')}
  />

  {/* NO-JS FALLBACK — the entries are hidden-by-default in graveyard.css so the
      reveal transition can run; without JS the IntersectionObserver never sets
      data-revealed, so we force them visible. Same defensive trick as the
      project's other client:only branches. */}
  <noscript>
    <style is:inline>{`
      .graveyard-entry { opacity: 1 !important; transform: none !important; }
    `}</style>
  </noscript>
</BaseLayout>

{/* SCROLL REVEAL — entries fade + rise into place as they enter the spy window.
    Pure inline IO; honours the resolved reduced-motion preference (skips the
    transition by setting data-revealed immediately on every entry, while the CSS
    html[data-motion='reduced'] block gates the transition off so the swap is
    instant). Re-runs on ClientRouter swaps so a back-nav into /graveyard re-arms
    the observer on the fresh DOM. */}
<script>
  import { getMotion } from '../lib/motion';

  function initGraveyardReveal() {
    if (!document.body.classList.contains('graveyard-page')) return;
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>('.graveyard-entry'),
    );
    if (entries.length === 0) return;

    const reduceMotion = getMotion() === 'reduced';
    if (reduceMotion || typeof IntersectionObserver === 'undefined') {
      // Reduced motion or no observer support: ship them all in instantly.
      entries.forEach((el) => el.setAttribute('data-revealed', 'true'));
      return;
    }

    const observer = new IntersectionObserver(
      (records) => {
        records.forEach((record) => {
          if (record.isIntersecting) {
            record.target.setAttribute('data-revealed', 'true');
            observer.unobserve(record.target);
          }
        });
      },
      // Trigger as the entry's top edge crosses ~85% of the viewport — early
      // enough that the rise feels generous, not jumpy. Margin is asymmetric:
      // we want to reveal as the entry RISES into view from below, not as it
      // exits past the top.
      { rootMargin: '0px 0px -15% 0px', threshold: 0 },
    );
    entries.forEach((el) => observer.observe(el));
  }
  document.addEventListener('astro:page-load', initGraveyardReveal);
  initGraveyardReveal();
</script>

<style>
  .graveyard-page .wrap {
    padding-bottom: 7rem;
  }

  .graveyard-hero,
  .graveyard-list {
    width: min(68rem, calc(100vw - var(--gutter) - var(--gutter)));
    margin-inline: auto;
  }

  .graveyard-hero {
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(4rem, 11vw, 7.5rem);
    margin-bottom: clamp(2.5rem, 8vw, 5.5rem);
  }

  /* Page-hero block snapped to the sitewide ladder (tokens.css) so Writing /
     Projects / Graveyard open at the same scale and tracking — the old local
     clamps ran a full rung louder than every other reading page. */
  /* Kicker — quiet plain dim text (P9 typography hygiene): the page name is
     scaffolding; mono caps stay reserved for the SPECIMEN RECORDS below
     (INTERRED / CAUSE — real archival state, graveyard.css). */
  .graveyard-kicker {
    margin: 0;
    width: max-content;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    letter-spacing: 0.01em;
    color: var(--fg-chrome-dim);
  }

  .graveyard-hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .graveyard-hero p {
    max-width: 42rem;
    margin: 0;
    color: var(--fg-dim);
    font-size: var(--text-subtitle);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .graveyard-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .graveyard-entry {
    padding: clamp(2rem, 6vw, 3.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .graveyard-entry-header {
    margin-bottom: 1.75rem;
  }

  .graveyard-entry-name {
    margin: 0 0 0.5rem;
    /* Entry headline — the shared secondary display rung (cards, rows). */
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .graveyard-entry-links {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .graveyard-link {
    color: var(--fg-faint);
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .graveyard-link:hover {
    color: var(--fg-dim);
    text-decoration: underline;
  }

  .graveyard-entry-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
  }

  .graveyard-figure {
    margin: 0;
    position: sticky;
    top: 5rem;
  }

  .graveyard-screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
    /* Slightly desaturated to signal these are past projects */
    filter: saturate(0.75);
    transition: filter 0.22s ease;
  }

  .graveyard-screenshot:hover {
    filter: saturate(1);
  }

  .graveyard-figure figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--fg-faint);
    line-height: 1.4;
  }

  .graveyard-copy {
    display: grid;
    gap: 0;
  }

  /* The story paragraphs are MDX body content (rendered <Content/>), so they
     carry no Astro scope attribute — matched via :global from the scoped
     .graveyard-copy wrapper. Same rendered CSS as the old inline markup; the
     page-rendered lesson <p> below is matched identically too. */
  .graveyard-copy :global(p) {
    margin: 0 0 1.15rem;
    color: var(--fg-dim);
    font-size: 1.04rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .graveyard-copy :global(p:last-child) {
    margin-bottom: 0;
  }

  /* SPECIMEN RECORD ROWS (P13) — hypothesis / warning signs / what survived,
     straight from the specimen's frontmatter. Quiet hairline rows in the
     drawer-label grammar: mono-caps term (a real archival record, same ramp as
     INTERRED/CAUSE above), plain dim description. */
  .graveyard-record {
    display: grid;
    gap: 0;
    margin: 0 0 1.4rem;
    border-top: 1px solid var(--line);
  }

  /* The bet reads BEFORE the story; the autopsy rows read after it. */
  .graveyard-record:not(.graveyard-record-bet) {
    margin-top: 1.4rem;
  }

  .graveyard-record-row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.35rem 1.1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .graveyard-record dt {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-faint);
    /* Optical alignment with the first description line. */
    padding-top: 0.2em;
  }

  .graveyard-record dd {
    margin: 0;
    color: var(--fg-dim);
    font-size: var(--text-body-sm);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .graveyard-record dd ul {
    margin: 0;
    padding-left: 1.1em;
  }

  .graveyard-record dd li {
    margin: 0 0 0.3rem;
  }

  .graveyard-record dd li:last-child {
    margin-bottom: 0;
  }

  .graveyard-record dd li::marker {
    color: var(--fg-faint);
  }

  @media (max-width: 34rem) {
    .graveyard-record-row {
      grid-template-columns: 1fr;
    }

    .graveyard-record dt {
      padding-top: 0;
    }
  }

  .graveyard-lesson {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    /* Slight lift off the live backdrop: the panel reads as a specimen-card
       drawer, distinct from the page surface, without crushing readability. */
    background: color-mix(in oklch, var(--bg) 78%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    font-size: 0.96rem !important;
  }

  .graveyard-lesson-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--highlight);
    display: block;
    margin-bottom: 0.4rem;
  }

  @media (max-width: 58rem) {
    .graveyard-entry-body {
      grid-template-columns: 1fr;
    }

    .graveyard-figure {
      position: static;
      max-width: 36rem;
    }
  }

  @media (max-width: 40rem) {
    .graveyard-hero,
    .graveyard-list {
      width: min(100%, calc(100vw - 2rem));
    }

    .graveyard-hero {
      margin-top: 2.75rem;
    }
    /* --text-hero is a fluid clamp, so it already scales on narrow widths —
       no per-breakpoint font-size override needed (mirrors writing.css). */
  }
</style>
