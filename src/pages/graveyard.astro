---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleScene from '../hero/components/ArticleScene.tsx';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const img = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// Build a responsive srcset string for an optimised raster.
// name:   bare filename stem (e.g. 'keywordlens') — matches the collection entry id
// widths: breakpoints that were generated by scripts/optimize-media.mjs
// fmt:    image format ('avif' | 'webp' | 'jpeg')
const optSrcset = (name: string, widths: number[], fmt: string): string => {
  const ext = fmt === 'jpeg' ? 'jpg' : fmt;
  return widths
    .map(w => `${img(`opt/graveyard/${name}-${w}.${ext}`)} ${w}w`)
    .join(', ');
};

// SPECIMEN LEDGER — loaded from the graveyard content collection. The entries
// render the list and the templating below stays flat. Order is the visual
// order of the cabinet drawers; the descent through the list IS the descent
// through the stellar-lifecycle journey [2.05 (red giant) → 0 (black hole)]
// driven by ArticleScene. Images render from the optimised pipeline
// (public/opt/graveyard/<id>-<w>.<fmt>, PERF-006), keyed by the entry id.
const specimens = (await getCollection('graveyard')).sort(
  (a, b) => a.data.order - b.data.order,
);

---

<BaseLayout
  title="Graveyard"
  description={`Projects that didn't survive, by ${SITE_TITLE}. Not everything I start makes it. Here's what didn't, and what it taught me.`}
  type="website"
  bodyClass="graveyard-page"
>
  {/* BACKDROP — the same live hero engine the article scene-JOURNEY uses, here
      pinned to a SOMBER lifecycle window: descending the list of dead projects
      descends the stellar lifecycle from the RED GIANT (the bloated, dying
      star, stage 2.05) down through collapse to the BLACK HOLE itself (stage
      0). client:only so the page text + the corner chrome read fully without
      JS — the canvas is atmosphere, never the content. The dim wash + somber
      column-ellipse live in hero.css under body.graveyard-page .bh-backdrop. */}
  <ArticleScene client:only="react" journey={[2.05, 0]} />

  <section class="graveyard-hero" aria-labelledby="graveyard-title">
    <p class="graveyard-kicker">Graveyard</p>
    <h1 id="graveyard-title">Not everything survives.</h1>
    <p>Not everything I start makes it. Here is what didn't, and what it taught me.</p>
  </section>

  <div class="graveyard-list" aria-label="Failed and abandoned projects">
    {specimens.map((s) => (
      <article class="graveyard-entry" id={s.id}>
        {/* SPECIMEN DRAWER LABEL — the mono-caps record row above the headline,
            reading like the label slot on a cabinet drawer. Carries the real
            record (year of death, cause) — content, not a page counter. */}
        <p class="graveyard-entry-specimen" aria-label="Specimen record">
          <span>INTERRED {s.data.interred}</span>
          <span class="graveyard-entry-specimen-sep" aria-hidden="true">·</span>
          <span>CAUSE: {s.data.cause}</span>
        </p>

        <header class="graveyard-entry-header">
          <h2 class="graveyard-entry-name"><span data-decode>{s.data.name}</span></h2>
          <div class="graveyard-entry-links">
            <a href={s.data.link.href} class="graveyard-link" target="_blank" rel="noopener noreferrer">
              {s.data.link.label}
            </a>
          </div>
        </header>

        <div class="graveyard-entry-body">
          <figure class="graveyard-figure">
            {/* Responsive <picture>: AVIF → WebP → JPEG fallback.
                Two widths (480, 768) match the breakpoints generated by
                scripts/optimize-media.mjs.  The bare filename stem is the
                collection entry id (s.id).  The fallback <img> carries the
                intrinsic width/height from the collection to reserve space
                and prevent CLS (PERF-006). */}
            <picture>
              <source
                type="image/avif"
                srcset={optSrcset(s.id, [480, 768], 'avif')}
                sizes="(max-width: 58rem) 100vw, (max-width: 1200px) 50vw, 680px"
              />
              <source
                type="image/webp"
                srcset={optSrcset(s.id, [480, 768], 'webp')}
                sizes="(max-width: 58rem) 100vw, (max-width: 1200px) 50vw, 680px"
              />
              <img
                src={img(`opt/graveyard/${s.id}-768.jpg`)}
                alt={s.data.image.alt}
                class="graveyard-screenshot"
                loading="lazy"
                width={s.data.image.width}
                height={s.data.image.height}
              />
            </picture>
            <figcaption>{s.data.image.caption}</figcaption>
          </figure>

          {/* FORENSIC RECORD — five structured fields that replace the undifferentiated
              body-copy model. Each field is a <dt>/<dd> pair inside a <dl> so
              keyboard and screen-reader users can navigate the record field by
              field. data-forensic-field drives E2E assertions (EXP-030). */}
          <div class="graveyard-copy">
            <dl class="graveyard-forensic">
              {s.data.premise && (
                <div class="forensic-field" data-forensic-field="hypothesis">
                  <dt class="forensic-label">Hypothesis</dt>
                  <dd class="forensic-value">{s.data.premise}</dd>
                </div>
              )}
              {s.data.warningSign && (
                <div class="forensic-field" data-forensic-field="warning-sign">
                  <dt class="forensic-label">Warning sign</dt>
                  <dd class="forensic-value">{s.data.warningSign}</dd>
                </div>
              )}
              {s.data.causeOfDeath && (
                <div class="forensic-field" data-forensic-field="cause-of-death">
                  <dt class="forensic-label">Cause of death</dt>
                  <dd class="forensic-value">{s.data.causeOfDeath}</dd>
                </div>
              )}
              <div class="forensic-field forensic-field--lesson" data-forensic-field="lesson">
                <dt class="forensic-label">Lesson</dt>
                <dd class="forensic-value">{s.data.lesson}</dd>
              </div>
              {s.data.survivingInsight && (
                <div class="forensic-field" data-forensic-field="surviving-insight">
                  <dt class="forensic-label">Surviving insight</dt>
                  <dd class="forensic-value">{s.data.survivingInsight}</dd>
                </div>
              )}
            </dl>
          </div>
        </div>
      </article>
    ))}
  </div>

  {/* NO-JS FALLBACK — the entries are hidden-by-default in graveyard.css so the
      reveal transition can run; without JS the IntersectionObserver never sets
      data-revealed, so we force them visible. Same defensive trick as the
      project's other client:only branches. */}
  <noscript>
    <style is:inline>{`
      .graveyard-entry { opacity: 1 !important; transform: none !important; }
    `}</style>
  </noscript>
</BaseLayout>

{/* SCROLL REVEAL — entries fade + rise into place as they enter the spy window.
    Pure inline IO; honours OS reduced-motion (skips the transition by setting
    data-revealed immediately on every entry, while the CSS @media query gates
    the transition off so the swap is instant). Re-runs on ClientRouter swaps so
    a back-nav into /graveyard re-arms the observer on the fresh DOM. */}
<script>
  function initGraveyardReveal() {
    if (!document.body.classList.contains('graveyard-page')) return;
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>('.graveyard-entry'),
    );
    if (entries.length === 0) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || typeof IntersectionObserver === 'undefined') {
      // Reduced motion or no observer support: ship them all in instantly.
      entries.forEach((el) => el.setAttribute('data-revealed', 'true'));
      return;
    }

    const observer = new IntersectionObserver(
      (records) => {
        records.forEach((record) => {
          if (record.isIntersecting) {
            record.target.setAttribute('data-revealed', 'true');
            observer.unobserve(record.target);
          }
        });
      },
      // Trigger as the entry's top edge crosses ~85% of the viewport — early
      // enough that the rise feels generous, not jumpy. Margin is asymmetric:
      // we want to reveal as the entry RISES into view from below, not as it
      // exits past the top.
      { rootMargin: '0px 0px -15% 0px', threshold: 0 },
    );
    entries.forEach((el) => observer.observe(el));
  }
  document.addEventListener('astro:page-load', initGraveyardReveal);
  initGraveyardReveal();
</script>

<style>
  .graveyard-page .wrap {
    padding-bottom: 7rem;
  }

  .graveyard-hero,
  .graveyard-list {
    width: min(68rem, calc(100vw - var(--gutter) - var(--gutter)));
    margin-inline: auto;
  }

  .graveyard-hero {
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(4rem, 11vw, 7.5rem);
    margin-bottom: clamp(2.5rem, 8vw, 5.5rem);
  }

  /* Page-hero block snapped to the sitewide ladder (tokens.css) so Writing /
     Projects / Graveyard open at the same scale and tracking — the old local
     clamps ran a full rung louder than every other reading page. */
  .graveyard-kicker {
    margin: 0;
    width: max-content;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-chrome-dim);
  }

  .graveyard-hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .graveyard-hero p {
    max-width: 42rem;
    margin: 0;
    color: var(--fg-dim);
    font-size: var(--text-subtitle);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .graveyard-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .graveyard-entry {
    padding: clamp(2rem, 6vw, 3.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .graveyard-entry-header {
    margin-bottom: 1.75rem;
  }

  .graveyard-entry-name {
    margin: 0 0 0.5rem;
    /* Entry headline — the shared secondary display rung (cards, rows). */
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .graveyard-entry-links {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .graveyard-link {
    color: var(--fg-faint);
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .graveyard-link:hover {
    color: var(--fg-dim);
    text-decoration: underline;
  }

  .graveyard-entry-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
  }

  .graveyard-figure {
    margin: 0;
    position: sticky;
    top: 5rem;
  }

  .graveyard-screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
    /* Slightly desaturated to signal these are past projects */
    filter: saturate(0.75);
    transition: filter 0.22s ease;
  }

  .graveyard-screenshot:hover {
    filter: saturate(1);
  }

  .graveyard-figure figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--fg-faint);
    line-height: 1.4;
  }

  /* FORENSIC RECORD — structured five-field layout (EXP-030).
     The <dl>/<dt>/<dd> pattern is natively navigable by keyboard and screen
     readers; the visual stacking mirrors the severity ladder top-to-bottom
     (hypothesis → warning → death → lesson → insight). */
  .graveyard-forensic {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .forensic-field {
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--bg) 60%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  /* Lesson field: slightly more prominent — same frosted panel, accent label. */
  .forensic-field--lesson {
    background: color-mix(in oklch, var(--bg) 78%, transparent);
  }

  .forensic-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--highlight);
    margin-bottom: 0.45rem;
  }

  .forensic-value {
    margin: 0;
    color: var(--fg-dim);
    font-size: 0.98rem;
    line-height: 1.68;
    text-wrap: pretty;
  }

  @media (max-width: 58rem) {
    .graveyard-entry-body {
      grid-template-columns: 1fr;
    }

    .graveyard-figure {
      position: static;
      max-width: 36rem;
    }
  }

  @media (max-width: 40rem) {
    .graveyard-hero,
    .graveyard-list {
      width: min(100%, calc(100vw - 2rem));
    }

    .graveyard-hero {
      margin-top: 2.75rem;
    }
    /* --text-hero is a fluid clamp, so it already scales on narrow widths —
       no per-breakpoint font-size override needed (mirrors writing.css). */
  }
</style>
