---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleScene from '../hero/components/ArticleScene.tsx';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const img = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// SPECIMEN LEDGER — the source of truth for the page. The entries render the
// list and the templating below stays flat. Order is the visual order of the
// cabinet drawers; the descent through the list IS the descent through the
// stellar-lifecycle journey [2.05 (red giant) → 0 (black hole)] driven by
// ArticleScene.
interface Specimen {
  id: string;
  name: string;          // mono-caps display name (HUD readout + entry header)
  link: { href: string; label: string };
  image: { src: string; alt: string; caption: string };
  interred: string;      // year of death / abandonment (mono caps)
  cause: string;         // short mono-caps cause-of-death tag
  body: readonly string[];   // ordered paragraphs of running copy
  lesson: string;        // the one-line "what it taught me" — rendered last
}

const specimens: readonly Specimen[] = [
  {
    id: 'keywordlens',
    name: 'KeywordLens',
    link: { href: 'https://getkeywordlens.com/', label: 'getkeywordlens.com' },
    image: {
      src: img('graveyard/keywordlens.png'),
      alt: 'KeywordLens interface showing keyword demand analysis for stock media platforms',
      caption: 'KeywordLens: stock media keyword demand tool',
    },
    interred: '2023',
    cause: 'Market collapsed',
    body: [
      'A SEMrush for stock media. It analyzed searches across the major stock platforms to surface high-demand, low-competition niches, so photographers could shoot what actually sells instead of guessing.',
      "It died the month generative AI went mainstream. The whole premise was helping people find the right photo to shoot. When anyone could generate the exact image they needed on demand, the market I was optimizing for stopped existing. Not a pivot. The ground moved.",
    ],
    lesson:
      "you can execute well and still be on the wrong side of a shift you didn't see coming. Timing isn't a detail. It's the whole bet.",
  },
  {
    id: 'heydaniel',
    name: 'HeyDaniel',
    link: { href: 'https://heydaniel.app/', label: 'heydaniel.app' },
    image: {
      src: img('graveyard/heydaniel.png'),
      alt: 'HeyDaniel app interface showing context-aware reminders and task capture',
      caption: 'HeyDaniel: context-aware reminder assistant',
    },
    interred: '2024',
    cause: 'No market validation',
    body: [
      "A context-aware reminder assistant. You'd send it a task by Telegram, a screenshot, or a note, and it would surface the right one based on where you were and what your day looked like. Walk into a shop, your list appears. Capturing cost nothing, remembering cost nothing.",
      "It worked. For me. Generalizing it for other people would have meant a lot more engineering, and I never got any market validation to justify the work. So I stopped building it as a product. I still use it every day.",
    ],
    lesson:
      "I'll happily pour engineering into a problem before checking whether anyone else has it. Validation first, build second. (Also: a tool that only serves you isn't a failure. It just isn't a business.)",
  },
];

---

<BaseLayout
  title="Graveyard"
  description={`Projects that didn't survive, by ${SITE_TITLE}. Not everything I start makes it. Here's what didn't, and what it taught me.`}
  type="website"
  bodyClass="graveyard-page"
>
  {/* BACKDROP — the same live hero engine the article scene-JOURNEY uses, here
      pinned to a SOMBER lifecycle window: descending the list of dead projects
      descends the stellar lifecycle from the RED GIANT (the bloated, dying
      star, stage 2.05) down through collapse to the BLACK HOLE itself (stage
      0). client:only so the page text + the corner chrome read fully without
      JS — the canvas is atmosphere, never the content. The dim wash + somber
      column-ellipse live in hero.css under body.graveyard-page .bh-backdrop. */}
  <ArticleScene client:only="react" journey={[2.05, 0]} />

  <section class="graveyard-hero" aria-labelledby="graveyard-title">
    <p class="graveyard-kicker">Graveyard</p>
    <h1 id="graveyard-title">Not everything survives.</h1>
    <p>Not everything I start makes it. Here is what didn't, and what it taught me.</p>
  </section>

  <div class="graveyard-list" aria-label="Failed and abandoned projects">
    {specimens.map((s) => (
      <article class="graveyard-entry" id={s.id}>
        {/* SPECIMEN DRAWER LABEL — the mono-caps record row above the headline,
            reading like the label slot on a cabinet drawer. Carries the real
            record (year of death, cause) — content, not a page counter. */}
        <p class="graveyard-entry-specimen" aria-label="Specimen record">
          <span>INTERRED {s.interred}</span>
          <span class="graveyard-entry-specimen-sep" aria-hidden="true">·</span>
          <span>CAUSE: {s.cause}</span>
        </p>

        <header class="graveyard-entry-header">
          <h2 class="graveyard-entry-name"><span data-decode>{s.name}</span></h2>
          <div class="graveyard-entry-links">
            <a href={s.link.href} class="graveyard-link" target="_blank" rel="noopener noreferrer">
              {s.link.label}
            </a>
          </div>
        </header>

        <div class="graveyard-entry-body">
          <figure class="graveyard-figure">
            <img
              src={s.image.src}
              alt={s.image.alt}
              class="graveyard-screenshot"
              loading="lazy"
            />
            <figcaption>{s.image.caption}</figcaption>
          </figure>

          <div class="graveyard-copy">
            {s.body.map((paragraph) => <p>{paragraph}</p>)}
            <p class="graveyard-lesson">
              <span class="graveyard-lesson-label">What it taught me:</span>
              {' '}{s.lesson}
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>

  {/* NO-JS FALLBACK — the entries are hidden-by-default in graveyard.css so the
      reveal transition can run; without JS the IntersectionObserver never sets
      data-revealed, so we force them visible. Same defensive trick as the
      project's other client:only branches. */}
  <noscript>
    <style is:inline>{`
      .graveyard-entry { opacity: 1 !important; transform: none !important; }
    `}</style>
  </noscript>
</BaseLayout>

{/* SCROLL REVEAL — entries fade + rise into place as they enter the spy window.
    Pure inline IO; honours OS reduced-motion (skips the transition by setting
    data-revealed immediately on every entry, while the CSS @media query gates
    the transition off so the swap is instant). Re-runs on ClientRouter swaps so
    a back-nav into /graveyard re-arms the observer on the fresh DOM. */}
<script>
  function initGraveyardReveal() {
    if (!document.body.classList.contains('graveyard-page')) return;
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>('.graveyard-entry'),
    );
    if (entries.length === 0) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || typeof IntersectionObserver === 'undefined') {
      // Reduced motion or no observer support: ship them all in instantly.
      entries.forEach((el) => el.setAttribute('data-revealed', 'true'));
      return;
    }

    const observer = new IntersectionObserver(
      (records) => {
        records.forEach((record) => {
          if (record.isIntersecting) {
            record.target.setAttribute('data-revealed', 'true');
            observer.unobserve(record.target);
          }
        });
      },
      // Trigger as the entry's top edge crosses ~85% of the viewport — early
      // enough that the rise feels generous, not jumpy. Margin is asymmetric:
      // we want to reveal as the entry RISES into view from below, not as it
      // exits past the top.
      { rootMargin: '0px 0px -15% 0px', threshold: 0 },
    );
    entries.forEach((el) => observer.observe(el));
  }
  document.addEventListener('astro:page-load', initGraveyardReveal);
  initGraveyardReveal();
</script>

<style>
  .graveyard-page .wrap {
    padding-bottom: 7rem;
  }

  .graveyard-hero,
  .graveyard-list {
    width: min(68rem, calc(100vw - var(--gutter) - var(--gutter)));
    margin-inline: auto;
  }

  .graveyard-hero {
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(4rem, 11vw, 7.5rem);
    margin-bottom: clamp(2.5rem, 8vw, 5.5rem);
  }

  /* Page-hero block snapped to the sitewide ladder (tokens.css) so Writing /
     Projects / Graveyard open at the same scale and tracking — the old local
     clamps ran a full rung louder than every other reading page. */
  .graveyard-kicker {
    margin: 0;
    width: max-content;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-chrome-dim);
  }

  .graveyard-hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .graveyard-hero p {
    max-width: 42rem;
    margin: 0;
    color: var(--fg-dim);
    font-size: var(--text-subtitle);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .graveyard-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .graveyard-entry {
    padding: clamp(2rem, 6vw, 3.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .graveyard-entry-header {
    margin-bottom: 1.75rem;
  }

  .graveyard-entry-name {
    margin: 0 0 0.5rem;
    /* Entry headline — the shared secondary display rung (cards, rows). */
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .graveyard-entry-links {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .graveyard-link {
    color: var(--fg-faint);
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .graveyard-link:hover {
    color: var(--fg-dim);
    text-decoration: underline;
  }

  .graveyard-entry-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
  }

  .graveyard-figure {
    margin: 0;
    position: sticky;
    top: 5rem;
  }

  .graveyard-screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
    /* Slightly desaturated to signal these are past projects */
    filter: saturate(0.75);
    transition: filter 0.22s ease;
  }

  .graveyard-screenshot:hover {
    filter: saturate(1);
  }

  .graveyard-figure figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--fg-faint);
    line-height: 1.4;
  }

  .graveyard-copy {
    display: grid;
    gap: 0;
  }

  .graveyard-copy p {
    margin: 0 0 1.15rem;
    color: var(--fg-dim);
    font-size: 1.04rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .graveyard-copy p:last-child {
    margin-bottom: 0;
  }

  .graveyard-lesson {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    /* Slight lift off the live backdrop: the panel reads as a specimen-card
       drawer, distinct from the page surface, without crushing readability. */
    background: color-mix(in oklch, var(--bg) 78%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    font-size: 0.96rem !important;
  }

  .graveyard-lesson-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--highlight);
    display: block;
    margin-bottom: 0.4rem;
  }

  @media (max-width: 58rem) {
    .graveyard-entry-body {
      grid-template-columns: 1fr;
    }

    .graveyard-figure {
      position: static;
      max-width: 36rem;
    }
  }

  @media (max-width: 40rem) {
    .graveyard-hero,
    .graveyard-list {
      width: min(100%, calc(100vw - 2rem));
    }

    .graveyard-hero {
      margin-top: 2.75rem;
    }
    /* --text-hero is a fluid clamp, so it already scales on narrow widths —
       no per-breakpoint font-size override needed (mirrors writing.css). */
  }
</style>
