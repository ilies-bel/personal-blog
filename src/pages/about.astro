---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHole from '../hero/BlackHole.tsx';
import { SITE_TITLE, SOCIALS } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
const home = href('').replace(/\/+$/, '') || '/';
---

{/* About reads as an overlay panel floating in the same room as the hero: the
    signature 3D object sits dimmed and pushed back behind a single calm reading
    column, with the persistent brand top-left and a bracket-framed Close
    top-right. `bare` strips the standard reading chrome so this composition
    owns the viewport — see BaseLayout's bare branch and .about-* in global.css. */}
<BaseLayout
  title="About"
  description={`About ${SITE_TITLE}: engineer, writer, and builder of small clever things on the web.`}
  type="website"
  bare
  bodyClass="about-page"
>
  {/* Our signature object, pinned to its calm nebula frame and dimmed by CSS —
     the same asset as the hero, here as quiet atmosphere, not the showpiece. */}
  <BlackHole client:only="react" backdrop />

  {/* Close: returns to the hero scene this panel floats over. Bracket framing
     echoes a viewfinder readout; it replaces the standard nav for this page. */}
  <a class="about-close" href={home} aria-label="Close and return to the home scene">
    <span class="about-close-bracket" aria-hidden="true"></span>
    <span class="about-close-label">Close</span>
    <span class="about-close-bracket about-close-bracket--end" aria-hidden="true"></span>
  </a>

  <main class="about-shell">
    <article class="about-panel">
      <p class="about-kicker">About</p>

      <p class="about-lead">
        Hi, I'm {SITE_TITLE}. I build software for the web and write about how it
        works underneath.
      </p>

      <p class="about-body">
        This is my corner of the internet: technical articles, notes from rabbit
        holes, and the occasional opinion about tooling. I care about software that
        stays fast, stays accessible, and still makes sense to the next person who
        opens it.
      </p>

      <p class="about-body">
        The homepage is a scroll-controlled stellar lifecycle: a small visual
        argument for restraint, pressure, collapse, and the kind of work that
        keeps its shape.
      </p>

      <div class="about-principles" aria-label="Working principles">
        <div>
          <span>Fast by default</span>
          <p>Interactivity earns its bytes, and text should not wait for JavaScript.</p>
        </div>
        <div>
          <span>Readable later</span>
          <p>The next person in the codebase gets names, structure, and tradeoffs.</p>
        </div>
        <div>
          <span>Usable by habit</span>
          <p>The fancy parts still need real text, keyboard access, and reduced motion.</p>
        </div>
      </div>

      <section class="about-contact" id="get-in-touch">
        <h2 class="about-contact-title">Get in touch</h2>
        <ul class="about-contact-list">
          {SOCIALS.github && <li><a href={SOCIALS.github}>GitHub</a></li>}
          {SOCIALS.twitter && <li><a href={SOCIALS.twitter}>Twitter / X</a></li>}
          {SOCIALS.email && <li><a href={`mailto:${SOCIALS.email}`}>Email</a></li>}
        </ul>
      </section>
    </article>
  </main>
</BaseLayout>
