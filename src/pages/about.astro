---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHole from '../hero/BlackHole.tsx';
import { SITE_TITLE, SOCIALS } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
const home = href('').replace(/\/+$/, '') || '/';
---

{/* About reads as an overlay panel floating in the same room as the hero: the
    signature 3D object sits dimmed and pushed back behind a single calm reading
    column, with the persistent brand top-left and a bracket-framed Close
    top-right. `bare` strips the standard reading chrome so this composition
    owns the viewport — see BaseLayout's bare branch and .about-* in global.css. */}
<BaseLayout
  title="About"
  description={`About ${SITE_TITLE}: engineer, writer, and builder of small clever things on the web.`}
  type="website"
  bare
  bodyClass="about-page"
>
  {/* Our signature object, pinned to its calm nebula frame and dimmed by CSS —
     the same asset as the hero, here as quiet atmosphere, not the showpiece. */}
  <BlackHole client:only="react" backdrop />

  {/* Close: returns to the hero scene this panel floats over. Plain mono label
     with gold-accent hover — the bracket gesture is reserved for current/locked
     targets (subnav lock, StarMarker reticle). */}
  <a class="about-close" href={home} aria-label="Close and return to the home scene">
    <span class="about-close-label">Close</span>
  </a>

  <main class="about-shell">
    <article class="about-panel">
      <p class="about-kicker">About</p>

      <h1 class="about-lead">
        Hi, I'm {SITE_TITLE}. I build software for the web and write about how it
        works underneath.
      </h1>

      <p class="about-body">
        This is my corner of the internet: technical articles, notes from rabbit
        holes, and the occasional opinion about tooling. I care about software that
        stays fast, stays accessible, and still makes sense to the next person who
        opens it.
      </p>

      <p class="about-body">
        The homepage is a scroll-controlled stellar lifecycle: a small visual
        argument for restraint, pressure, collapse, and the kind of work that
        keeps its shape.
      </p>

      <div class="about-principles" aria-label="Working principles">
        <div>
          <span>Fast by default</span>
          <p>Interactivity earns its bytes, and text should not wait for JavaScript.</p>
        </div>
        <div>
          <span>Readable later</span>
          <p>The next person in the codebase gets names, structure, and tradeoffs.</p>
        </div>
        <div>
          <span>Usable by habit</span>
          <p>The fancy parts still need real text, keyboard access, and reduced motion.</p>
        </div>
      </div>

      {/* The personal moment: a sign-off in Instrument Serif italic with a hand-
         drawn flourish underline. Reads as "this is a person, with a name", not a
         styled bio. On view, the name reveals (clip-path) and the flourish strokes
         itself in; under prefers-reduced-motion or no-JS, both render statically
         from the first frame — same composition, no movement. The screen-reader
         label flattens it to "Signed, Iliès" so it isn't read as a stray word. */}
      <p class="about-signature" aria-label="Signed, Iliès">
        <span class="about-signature-name" aria-hidden="true">Iliès</span>
        <svg
          class="about-signature-flourish"
          viewBox="0 0 220 22"
          aria-hidden="true"
          focusable="false"
          preserveAspectRatio="xMinYMid meet"
        >
          {/* A flowing underline with a small upward curl at the tail — pathLength
             is normalized to 1 so the stroke-draw animation works regardless of
             the actual path length. */}
          <path
            d="M 4 14 C 38 4, 78 22, 128 12 S 198 6, 216 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            pathLength="1"
          />
        </svg>
      </p>

      <section class="about-contact" id="get-in-touch">
        <h2 class="about-contact-title">Get in touch</h2>
        <ul class="about-contact-list">
          {SOCIALS.github && <li><a href={SOCIALS.github}>GitHub</a></li>}
          {SOCIALS.twitter && <li><a href={SOCIALS.twitter}>Twitter / X</a></li>}
          {SOCIALS.email && <li><a href={`mailto:${SOCIALS.email}`}>Email</a></li>}
        </ul>
      </section>
    </article>
  </main>
</BaseLayout>

{/* Overlay focus management: this page reads as a pseudo-modal floating over the
    hero scene, so move initial focus to the Close link on load — keyboard users
    start inside the overlay, with the natural "return to the scene" action in
    hand. This is a real page (real nav, real links), not a JS dialog, so we do
    NOT trap focus; just the one initial focus move, which is instant. */}
<script>
  // Overlay focus: pull initial keyboard focus into the Close affordance so the
  // first keystroke is the natural "return to the scene" action. Instant, not a
  // motion concern.
  document.querySelector<HTMLAnchorElement>('.about-close')?.focus();

  // The personal moment: tag <body> with .has-signature-anim so the signature
  // starts hidden (clip-path collapsed, flourish stroke offset), then drop the
  // .is-drawn class on the signature when it enters the viewport. Under
  // prefers-reduced-motion we skip the whole branch — the static state in CSS is
  // the reduced-motion equivalent (signature visible from frame one). No-JS gets
  // the same static state for free, since the tag is what *hides* the signature.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    document.body.classList.add('has-signature-anim');
    const sig = document.querySelector('.about-signature');
    if (sig) {
      const reveal = () => sig.classList.add('is-drawn');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              reveal();
              observer.disconnect();
              return;
            }
          }
        }, { threshold: 0.55 });
        io.observe(sig);
      } else {
        reveal();
      }
    }
  }
</script>
