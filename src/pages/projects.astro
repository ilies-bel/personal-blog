---
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientBackdrop from '../components/AmbientBackdrop.astro';
import MarsTopology from '../components/MarsTopology.astro';
import RouteEnding from '../components/RouteEnding.astro';
import { SITE_TITLE } from '../consts';
import { ogCardFor } from '../lib/ogCard';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// P6: the entries are a CONTENT COLLECTION (src/content/projects/*.mdx) behind
// the evidence-enforcing schema in src/lib/contentSchemas.ts — every factual
// claim in the copy is either evidenced or explicitly flagged as debt
// (draftEvidence), and a shipped project must name its limitations, all
// checked at build time. This page is pure rendering: header/meta/figure from
// frontmatter, the running copy from the MDX body. Order is the authored
// `order` field (ascending), id as the tiebreak.
const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

// Hand-authored diagram components a project can declare as its figure
// (media.kind 'diagram'). The enum in the schema and this registry must agree —
// a typo'd name fails schema validation before it can reach this map.
const DIAGRAMS = { 'mars-topology': MarsTopology } as const;

// SCREENSHOT RESOLUTION — frontmatter declares a validated FILENAME (schema:
// assetFilename), resolved here against src/assets/projects/ via
// import.meta.glob. NOT the content-collection image() helper: that route
// statically imports every original through .astro/content-assets.mjs and
// ships the raw pngs into dist (P5 gate violation) — this glob + <Picture>
// path emits only the transformed rungs, exactly like the pre-P6 direct
// import did. A filename that misses the glob throws HERE, at prerender, so a
// bad reference still fails the build with a named error.
const projectShots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const resolveShot = (filename: string): ImageMetadata => {
  const mod = projectShots[`../assets/projects/${filename}`];
  if (!mod) {
    throw new Error(
      `projects media image "${filename}" not found in src/assets/projects/ ` +
        `(known: ${Object.keys(projectShots).join(', ')})`,
    );
  }
  return mod.default;
};

// SCREENSHOT DELIVERY — same astro:assets contract as the graveyard specimens
// (P5): AVIF/WebP + WebP fallback, sized for the figure column of the 1:1.5
// entry-body grid (~26rem desktop, ≤36rem stacked under 58rem → 1x/2x rungs).
const SCREENSHOT_WIDTHS = [432, 864, 1152];
// Hardcoded fallback rung, NOT Math.min(image.width, …): reading any
// property off imported image metadata marks the original as referenced and
// ships the raw png into dist (see src/components/mdx/Img.astro).
const SCREENSHOT_FALLBACK_WIDTH = 1152;
const SCREENSHOT_SIZES = '(max-width: 58rem) min(100vw - 2rem, 36rem), 26rem';

// Mono display label for a repo link: the URL minus its protocol.
const linkLabel = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<BaseLayout
  title="Projects"
  description={`Shipped tools and products by ${SITE_TITLE}. The work that held.`}
  ogImage={ogCardFor('projects')}
  type="website"
  bodyClass="projects-page"
>
  {/* Static celestial backdrop — the YELLOW STAR frame (stage 2.9, Projects'
      own celestial body in the nav model) as a build-time capture of the live
      engine, heavily dimmed behind the ledger. Zero JS, zero WebGL (P4); the
      corner scene-toggle circle still switches it off (body.backdrop-off). */}
  <AmbientBackdrop variant="star" />

  <section class="projects-hero" aria-labelledby="projects-title">
    <h1 id="projects-title">The work that held.</h1>
    <p>Tools I built, shipped, and still stand behind.</p>
  </section>

  {/* role="group" legitimizes the aria-label (a bare div can't carry one). */}
  <div class="projects-list" role="group" aria-label="Shipped projects">
    {rendered.map(({ entry, Content }) => {
      const { data } = entry;
      const Diagram =
        data.media?.kind === 'diagram' ? DIAGRAMS[data.media.diagram] : null;
      return (
        <article class="projects-entry" id={entry.id}>
          <header class="projects-entry-header">
            <h2 class="projects-entry-name">
              <span data-decode>{data.title}</span>
              {data.status === 'private' && <span class="projects-badge">private</span>}
            </h2>
            {(data.links?.github || data.links?.npm) && (
              <div class="projects-entry-links">
                {data.links.github && (
                  <a href={data.links.github} class="projects-link" target="_blank" rel="noopener noreferrer">{linkLabel(data.links.github)}</a>
                )}
                {data.links.github && data.links.npm && (
                  <span class="projects-link-sep" aria-hidden="true">/</span>
                )}
                {data.links.npm && (
                  <span class="projects-pkg"><span class="projects-pkg-label">npm</span> {data.links.npm}</span>
                )}
              </div>
            )}
            {data.privateNote && <span class="projects-private-note">{data.privateNote}</span>}
            <dl class="projects-meta">
              <div class="projects-meta-item">
                <dt>Role</dt>
                <dd>{data.role}</dd>
              </div>
              <div class="projects-meta-item">
                <dt>Stack</dt>
                <dd>{data.stack.join(' · ')}</dd>
              </div>
              <div class="projects-meta-item">
                <dt>Status</dt>
                <dd>{data.statusLabel}</dd>
              </div>
            </dl>
          </header>

          <div class="projects-entry-body">
            {data.media && (
              <figure class="projects-figure">
                {data.media.kind === 'image' ? (
                  <Picture
                    src={resolveShot(data.media.image)}
                    alt={data.media.alt}
                    class="projects-screenshot"
                    width={SCREENSHOT_FALLBACK_WIDTH}
                    widths={SCREENSHOT_WIDTHS}
                    sizes={SCREENSHOT_SIZES}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    quality={70}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  Diagram && <Diagram />
                )}
                <figcaption>{data.media.caption}</figcaption>
              </figure>
            )}

            <div class="projects-copy">
              <Content />
            </div>
          </div>
        </article>
      );
    })}
  </div>

  {/* ROUTE ENDING (P9) — Work hands off to Contact: the ledger closes on the
      continuation the evidence was building toward, not a copyright line. */}
  <RouteEnding
    width="ledger"
    eyebrow="The continuation"
    title="Want this on your team?"
    note="I take on a few engagements at a time. Availability, timezone, and a direct line are one page away."
    href={href('contact')}
  />
</BaseLayout>

<style>
  .projects-page .wrap {
    padding-bottom: 7rem;
  }

  .projects-hero,
  .projects-list {
    width: min(68rem, calc(100vw - var(--gutter) - var(--gutter)));
    margin-inline: auto;
  }

  .projects-hero {
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(4rem, 11vw, 7.5rem);
    margin-bottom: clamp(2.5rem, 8vw, 5.5rem);
  }

  /* Page-hero block snapped to the sitewide ladder (tokens.css) so Writing /
     Projects / Graveyard open at the same scale and tracking — the old local
     clamps ran a full rung louder than every other reading page. */
  .projects-hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .projects-hero p {
    max-width: 42rem;
    margin: 0;
    color: var(--fg-dim);
    font-size: var(--text-subtitle);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .projects-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .projects-entry {
    padding: clamp(2rem, 6vw, 3.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .projects-entry-header {
    margin-bottom: 1.75rem;
  }

  .projects-entry-name {
    margin: 0 0 0.5rem;
    /* Entry headline — the shared secondary display rung (cards, rows). */
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .projects-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-chrome-faint);
    vertical-align: middle;
  }

  .projects-entry-links {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .projects-link {
    color: var(--accent-strong);
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .projects-link:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  .projects-link-sep {
    color: var(--fg-chrome-faint);
  }

  .projects-pkg {
    color: var(--fg-dim);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .projects-pkg-label {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-chrome-faint);
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .projects-private-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--fg-chrome-faint);
  }

  .projects-entry-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
  }

  .projects-figure {
    margin: 0;
    position: sticky;
    top: 5rem;
  }

  .projects-screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    /* Square-cut instrument plate — the room's corner grammar. */
    border-radius: 2px;
    background: var(--bg-soft);
  }

  .projects-figure figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--fg-chrome-faint);
    line-height: 1.4;
  }

  .projects-copy {
    display: grid;
    gap: 0;
  }

  /* The running copy is MDX body content (rendered <Content/>), so its
     paragraphs carry no Astro scope attribute — matched via :global from the
     scoped .projects-copy wrapper. Compiled output targets the exact same
     elements the old inline markup did; the rendered CSS is unchanged. */
  .projects-copy :global(p) {
    margin: 0 0 1.15rem;
    color: var(--fg-dim);
    font-size: 1.04rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .projects-copy :global(p:last-child) {
    margin-bottom: 0;
  }

  .projects-copy :global(.projects-proud) {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: color-mix(in oklch, var(--bg-soft) 70%, transparent);
    font-size: 0.96rem !important;
  }

  .projects-copy :global(.projects-proud-label) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--highlight);
    display: block;
    margin-bottom: 0.4rem;
  }

  /* Metadata strip — quiet mono fact row under each project headline.
     Mirrors .projects-pkg-label / .projects-proud-label token style;
     intentionally quieter (fg-faint labels, no box). */
  .projects-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0;
    margin: 0.6rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
  }

  .projects-meta-item {
    display: flex;
    align-items: baseline;
    gap: 0.45em;
    padding: 0 0.75rem;
  }

  .projects-meta-item:first-child {
    padding-left: 0;
  }

  .projects-meta-item:not(:first-child) {
    border-left: 1px solid var(--line);
  }

  .projects-meta dt {
    font-size: 0.65rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--fg-chrome-faint);
    font-weight: 400;
    margin: 0;
    padding: 0;
  }

  .projects-meta dd {
    color: var(--fg-chrome-dim);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 58rem) {
    .projects-entry-body {
      grid-template-columns: 1fr;
    }

    .projects-figure {
      position: static;
      max-width: 36rem;
    }
  }

  @media (max-width: 40rem) {
    .projects-hero,
    .projects-list {
      width: min(100%, calc(100vw - 2rem));
    }

    .projects-hero {
      margin-top: 2.75rem;
    }
    /* --text-hero is a fluid clamp, so it already scales on narrow widths —
       no per-breakpoint font-size override needed (mirrors writing.css). */
  }
</style>
