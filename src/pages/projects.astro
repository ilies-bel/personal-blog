---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientBackdrop from '../components/AmbientBackdrop.astro';
import CaseStudy from '../components/CaseStudy.astro';
import RouteEnding from '../components/RouteEnding.astro';
import { SITE_TITLE } from '../consts';
import { ogCardFor } from '../lib/ogCard';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// P6: the entries are a CONTENT COLLECTION (src/content/projects/*.mdx) behind
// the evidence-enforcing schema in src/lib/contentSchemas.ts — every factual
// claim in the copy is either evidenced or explicitly flagged as debt
// (draftEvidence), and a shipped project must name its limitations, all
// checked at build time. P13: each entry renders through CaseStudy.astro as a
// proof-first case study — problem → decisive choice → outcome from the MDX
// body, then the claims ledger (evidence adjacent to every claim) and the
// decisions-&-consequences record, all straight from frontmatter. Order is the
// authored `order` field (ascending), id as the tiebreak.
const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout
  title="Projects"
  description={`Shipped tools and products by ${SITE_TITLE}. The work that held.`}
  ogImage={ogCardFor('projects')}
  type="website"
  bodyClass="projects-page"
>
  {/* Static celestial backdrop — the YELLOW STAR frame (stage 2.9, Projects'
      own celestial body in the nav model) as a build-time capture of the live
      engine, heavily dimmed behind the ledger. Zero JS, zero WebGL (P4); the
      corner scene-toggle circle still switches it off (body.backdrop-off). */}
  <AmbientBackdrop variant="star" />

  <section class="projects-hero" aria-labelledby="projects-title">
    <h1 id="projects-title">The work that held.</h1>
    <p>Tools I built, shipped, and still stand behind.</p>
  </section>

  {/* role="group" legitimizes the aria-label (a bare div can't carry one). */}
  <div class="projects-list" role="group" aria-label="Shipped projects">
    {rendered.map(({ entry, Content }) => (
      <CaseStudy entry={entry}>
        <Content />
      </CaseStudy>
    ))}
  </div>

  {/* ROUTE ENDING (P9) — Work hands off to Contact: the ledger closes on the
      continuation the evidence was building toward, not a copyright line. */}
  <RouteEnding
    width="ledger"
    eyebrow="The continuation"
    title="Want this on your team?"
    note="I take on a few engagements at a time. Availability, timezone, and a direct line are one page away."
    href={href('contact')}
  />
</BaseLayout>

<style>
  .projects-page .wrap {
    padding-bottom: 7rem;
  }

  .projects-hero,
  .projects-list {
    width: min(68rem, calc(100vw - var(--gutter) - var(--gutter)));
    margin-inline: auto;
  }

  .projects-hero {
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(4rem, 11vw, 7.5rem);
    margin-bottom: clamp(2.5rem, 8vw, 5.5rem);
  }

  /* Page-hero block snapped to the sitewide ladder (tokens.css) so Writing /
     Projects / Graveyard open at the same scale and tracking — the old local
     clamps ran a full rung louder than every other reading page. */
  .projects-hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .projects-hero p {
    max-width: 42rem;
    margin: 0;
    color: var(--fg-dim);
    font-size: var(--text-subtitle);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .projects-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 40rem) {
    .projects-hero,
    .projects-list {
      width: min(100%, calc(100vw - 2rem));
    }

    .projects-hero {
      margin-top: 2.75rem;
    }
    /* --text-hero is a fluid clamp, so it already scales on narrow widths —
       no per-breakpoint font-size override needed (mirrors writing.css). */
  }
</style>
