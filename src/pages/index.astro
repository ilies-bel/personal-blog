---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHole from '../hero/BlackHole.tsx';
import { BEATS, SCROLL_SECTION_COUNT } from '../hero/beats';
import { SCENE_READY_EVENT, SCENE_READY_BODY_CLASS } from '../hero/lib/constants';
import { SITE_TITLE, SITE_DESCRIPTION, BRAND_NAME, BRAND_ROLE } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} type="website" bare>
  {/* The home page's live (JS-on) top-level heading. The cinematic hero carries
      the identity VISUALLY (the corner wordmark lockup + the manifesto <h2> beats
      that cross-fade per state), so there is no on-design element that should be
      the page <h1> — every visible candidate is either a non-heading lockup or one
      of several cross-fading beats (promoting one beat would fragment / duplicate
      the h1). So the document's single top-level heading is this dedicated, visually
      hidden line, naming the page/site exactly like the <noscript> fallback's
      name + role (sourced from the same BRAND_* constants so the two can't drift).
      It is server-rendered (present before hydration) and uses .sr-only — the clip
      pattern keeps it in the accessibility tree (NOT aria-hidden, NOT display:none),
      so screen readers and SEO get a real <h1> while the visuals are untouched. */}
  <h1 class="sr-only">{BRAND_NAME} — {BRAND_ROLE}</h1>

  {/* Instant intro loader — pure server-rendered HTML + CSS, ZERO JavaScript
      dependency, so it paints the moment the document arrives (long before the
      ~200 KB-gzip three.js engine chunk downloads, parses, allocates its typed
      arrays and compiles the shader). It sits over the (black) canvas in the site's
      own palette: a single quiet pale speck — a neutral wordmark-pulse placeholder,
      NOT the scene itself (the scene now OPENS ON THE BLACK HOLE at the top and winds
      down to the lonely pale blue dot at the bottom) — pulsing under a wordmark, so
      the wait reads as "the hero is about to ignite", not "the page is broken". It
      fades out smoothly once the hero
      paints its FIRST real frame (body.scene-ready, added by the inline listener
      below on the scene:ready event). aria-hidden — it is pure decoration over the
      same copy the manifesto/SSR fallback already announce. Styling lives in
      scene.css under "Instant intro loader". */}
  <div class="scene-loader" aria-hidden="true">
    <div class="scene-loader-mark">
      <span class="scene-loader-dot"></span>
      <span class="scene-loader-name">ILIÈS BELDJILALI</span>
    </div>
  </div>

  {/* Wire the loader's fade-out to the ACTUAL first paint, not a blind timeout. A
      tiny zero-import <script is:inline> (mirrors the CustomCursor convention) runs
      the moment the body parses: it adds body.scene-ready when the scene dispatches
      scene:ready (its first composited frame). A long safety timeout is the ONLY
      fallback — it fires solely if that event never arrives (a failed WebGL context
      / a browser with JS but no WebGL), so the loader can never get stuck over a
      dead canvas. The event name + class literals mirror src/hero/lib/constants.ts
      (SCENE_READY_EVENT / SCENE_READY_BODY_CLASS) — kept in sync via the values
      interpolated below so the two can never drift. */}
  <script is:inline define:vars={{ readyEvent: SCENE_READY_EVENT, readyClass: SCENE_READY_BODY_CLASS }}>
    (() => {
      const reveal = () => document.body.classList.add(readyClass);
      // Primary signal: the scene's first composited frame. Once is enough.
      window.addEventListener(readyEvent, reveal, { once: true });
      // Safety fallback ONLY — never the normal path. Long enough that the engine
      // has surely painted on any real device; if it hasn't (no WebGL), we still
      // lift the loader so the page isn't trapped behind it.
      window.setTimeout(reveal, 8000);
    })();
  </script>

  {/* The signature object: a GPU-particle stellar lifecycle pinned to the center
      of the viewport. As the visitor scrolls DOWN, one normalized timeline runs the
      lifecycle in REVERSE: the page opens on the black hole (the big hero that pulls
      the portfolio interface in), un-detonates through the supernova into a red
      giant, settles back to a yellow star, dissolves into a nebula, and resolves to
      the lonely pale blue dot — the quiet speck at the bottom of the page.

      client:visible (not client:only) so Astro ships + hydrates the page shell —
      including the instant loader above — FIRST, then mounts the hero. The hero is
      above the fold, so client:visible fires essentially immediately; the win is
      that the loader paints with zero JS on the critical path and the heavy engine
      (dynamically imported inside HeroIsland) downloads off it. The component is
      SSR-safe: every window/three.js touch lives inside its mount effect, so the
      server only renders the empty canvas shell + manifesto chrome. */}
  <BlackHole client:visible />

  {/* The scroll track. It contributes no visuals of its own — it exists only to
      give the page real scrollable height so the pinned scene can be scrubbed.
      The BlackHole island reads normalized window scroll progress and maps that
      single 0..1 value into the cinematic camera + shader timeline. */}
  <div class="scene-track" aria-hidden="true">
    {Array.from({ length: SCROLL_SECTION_COUNT }).map(() => <div class="scene-stage"></div>)}
  </div>

  {/* The manifesto copy is rendered by the island so it can fade per-state in
      lockstep with the morph. The
      static fallback below mirrors that copy (down-arc big lines + whispers) so
      the page stays meaningful and indexable for crawlers / no-JS. */}
  {/* The static no-JS / crawler fallback mirrors the live overlay's big line +
      whisper for every beat, mapped over the same BEATS so the SSR copy can
      never drift from the live copy. The reverse arc plays black hole -> ... ->
      pale blue dot top-to-bottom, so the list is reversed (slice() first, never
      mutating BEATS) to match that physical order — index 0 is the black-hole
      beat; the dot beat lands last. The page <h1> is the dedicated .sr-only line
      above (always server-rendered, present with or without JS), so EVERY beat
      here is an <h2>: with JS off the single top-level heading stays that one
      brand <h1> and the beats sit under it — no duplicate / competing h1. */}
  <noscript>
    <div class="scene-fallback measure">
      <p class="scene-fallback-name">ILIÈS BELDJILALI</p>
      <p class="scene-fallback-role">Software Engineer</p>

      {BEATS.slice().reverse().map((beat) => (
        <Fragment>
          <h2>{beat.down}</h2>
          <p>{beat.whisper}</p>
        </Fragment>
      ))}

      <p>Make it last, or don't make it. Sounds interesting?
        <a href={`${href('about')}#get-in-touch`}>Get in touch.</a></p>
    </div>
  </noscript>

</BaseLayout>
