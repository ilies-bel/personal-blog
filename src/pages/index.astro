---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHole from '../hero/BlackHole.tsx';
import StaticEdition from '../components/StaticEdition.astro';
import { SCROLL_SECTION_COUNT } from '../hero/timeline';
import {
  SCENE_READY_EVENT,
  SCENE_PAINTED_BODY_DATA_KEY,
  SCENE_READY_BODY_CLASS,
  SCENE_WARM_PENDING_EVENT,
  SCENE_WARM_DONE_EVENT,
  WEBGL_UNAVAILABLE_BODY_CLASS,
  LOADER_GONE_BODY_CLASS,
  LOADER_MIN_MS,
  LOADER_WARM_MAX_MS,
  LOADER_SAFETY_MS,
  LOADER_SEEN_STORAGE_KEY,
  NATIVE_SCROLL_INTENT_PX,
  WARM_SESSION_STORAGE_KEY,
} from '../hero/lib/constants';
import { SITE_TITLE, SITE_DESCRIPTION, BRAND_NAME, BRAND_ROLE } from '../consts';
import { getCounts, getFeaturedProof } from '../lib/contentStats';
// Route-specific OG card (P12) — generated by scripts/gen-og-cards.mjs;
// falls back to the sitewide default when the card is absent.
import { ogCardFor } from '../lib/ogCard';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// Collection-derived counts (P6) for the finale ledger notes — computed at
// build time from the projects/graveyard collections and serialized into the
// island props, so '2 shipped' / '2 dead, both honest' can never drift from
// the actual content again (they used to be hand-synced literals).
const counts = await getCounts();
// Home-feature proof (PRD-003) — the ONE shipped project the yellow-star
// Projects marker features by name. Derived + validated from the projects
// collection (heroProof.feature; getFeaturedProof enforces ≤1 public feature
// and a real /projects#<id> fragment). Passed into the hero island so the
// marker's facts come from the catalogue, never from a scene literal — and
// ALSO rendered as a server-side proof/link below so the no-JS and no-WebGL
// editions carry the same evidence with no canvas or client hero state.
const featured = await getFeaturedProof();
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  ogImage={ogCardFor('home')}
  type="website"
  bare
>
  {/* The home page's live (JS-on) top-level heading. The cinematic hero carries
      the identity VISUALLY (the corner wordmark lockup + the manifesto <h2> beats
      that cross-fade per state), so there is no on-design element that should be
      the page <h1> — every visible candidate is either a non-heading lockup or one
      of several cross-fading beats (promoting one beat would fragment / duplicate
      the h1). So the document's single top-level heading is this dedicated, visually
      hidden line, naming the page/site exactly like the <noscript> fallback's
      name + role (sourced from the same BRAND_* constants so the two can't drift).
      It is server-rendered (present before hydration) and uses .sr-only — the clip
      pattern keeps it in the accessibility tree (NOT aria-hidden, NOT display:none),
      so screen readers and SEO get a real <h1> while the visuals are untouched. */}
  <h1 class="sr-only">{BRAND_NAME} — {BRAND_ROLE}</h1>

  {/* Instant intro loader — pure server-rendered HTML + CSS, ZERO JavaScript
      dependency, so it paints the moment the document arrives (long before the
      ~200 KB-gzip three.js engine chunk downloads, parses, allocates its typed
      arrays and compiles the shader). It sits over the (black) canvas in the site's
      own palette: a single quiet pale speck — a neutral wordmark-pulse placeholder,
      NOT the scene itself (the scene now OPENS ON THE BLACK HOLE at the top and winds
      down to the lonely pale blue dot at the bottom) — pulsing under a wordmark, so
      the wait reads as "the hero is about to ignite", not "the page is broken". It
      fades out smoothly once the hero
      paints its FIRST real frame (body.scene-ready, added by the inline listener
      below on the scene:ready event). The mark (dot + wordmark) is aria-hidden —
      pure decoration over the same copy the manifesto/SSR fallback already
      announce — but the loader element itself is NOT: it also carries the REAL
      "Skip intro" control (P7 loader honesty), a server-rendered <button> that
      is visible, Tab-reachable and wired by the parser-inline loader script
      below, so it works long before the React island hydrates. Clicking it
      reveals the scene + releases interactivity immediately (scene-ready +
      loader-gone in one stroke). Styling lives in scene.css under "Instant
      intro loader". */}
  <div class="scene-loader">
    <div class="scene-loader-mark" aria-hidden="true">
      <span class="scene-loader-dot"></span>
      <span class="scene-loader-name">{BRAND_NAME}</span>
      <p class="scene-loader-welcome">Welcome</p>
    </div>
    <button type="button" class="scene-loader-skip">
      <span aria-hidden="true">[&nbsp;</span><span class="scene-loader-skip-label">Skip intro</span><span aria-hidden="true">&nbsp;]</span>
    </button>
  </div>

  {/* Wire the loader's fade-out to actual hero readiness, not a blind timeout.
      A parser-inline <script> installs the listener synchronously before the
      React island can hydrate or import the scene. This ordering is critical:
      scene:ready is a one-shot window event, so a separately fetched module
      script could lose a hard-refresh race to a cached hero chunk. Real-frame
      producers also stamp a durable data-scene-painted latch before dispatching,
      which lets this bootstrap recover the genuine painted state if future
      script ordering ever changes. The inline script has no runtime import/chunk
      of its own, so its failure timer and Skip intro control cannot disappear
      with a module-load failure.

      FIRST load of the SESSION only, the loader is held for a minimum of
      LOADER_MIN_MS (≤1s — the P7 honesty budget: one legible beat for the boot
      readout, never a theater hold over an already-painted scene) — the reveal
      lands at max(scene:ready, LOADER_MIN_MS). The floor only RAISES the early
      bound; a slower scene still waits for its real first frame. "First load of
      the session" is tracked in sessionStorage (LOADER_SEEN_STORAGE_KEY): a fresh
      session shows the boot beat once, then reloads/returns within the session
      reveal as soon as scene:ready fires (no floor). A back-nav WITHIN the
      session therefore never re-imposes the floor.

      SKIP INTRO — the loader's server-rendered .scene-loader-skip button is
      wired HERE (this parser-inline script runs on page load, before the React
      island hydrates, so the control works from first paint). Clicking it is
      the impatient path PLUS the honest one: it reveals the scene AND releases
      interactivity in one stroke (scene-ready + loader-gone immediately — no
      waiting out the dissolve choreography), and the session is marked seen so
      the floor never re-imposes. The button hides itself once scene-ready lands
      (CSS display:none) — its job is done the moment the reveal starts.

      A long safety timeout is the hard backstop in BOTH cases — it fires solely
      if scene:ready never arrives (a failed import/WebGL context / a browser with
      JS but no WebGL), so the loader can never get stuck over a dead canvas. It
      bypasses the floor, releases interactivity, and exposes the existing
      on-brand no-WebGL fallback. 8s ≫ the ≤1s floor, so they compose cleanly:
      floor raises the early bound, safety caps the late bound.

      Once the loader is REVEALED (scene-ready added) the dissolve runs in order:
      the dot+name fade out FIRST (their own early 0→0.3s window), THEN the readout
      glides down, and only AFTER it lands does the dark `.scene-loader::before`
      background fade out (transition-delay = glide-start + glide-dur, then a
      0.7s fade) to expose the scene. body.loader-gone is added when THAT last
      fade finishes — listened for via the ::before opacity `transitionend` on
      the `.scene-loader` element — so the in-scene star markers (live <a> links
      sitting UNDER the loader) only become interactive once the loader is truly
      gone. A transitionend can be MISSED (interrupted / element gone), so a
      timeout backstop arms the moment we reveal: glide-start(0.32s) + glide-dur(0.7s)
      + fade-dur(0.7s) + margin ≈ 1.72s + 0.38s = 2.1s after scene-ready, guaranteeing
      loader-gone is eventually set (reduced-motion still fades → still fires;
      the no-WebGL 8s safety reveal also chains the backstop). Idempotent.

      Constants are imported in Astro frontmatter from
      src/hero/lib/constants.ts, then injected into this parser-inline script via
      define:vars. There is no runtime module import or loader bundle.
      initLoader() is idempotent: a dataset flag on .scene-loader gates double-init
      within the same DOM, and loader.isConnected guards reveal/markGone against
      stale timers firing after a page swap away. */}
  <script
    is:inline
    data-astro-rerun
    define:vars={{
      SCENE_READY_EVENT,
      SCENE_PAINTED_BODY_DATA_KEY,
      SCENE_READY_BODY_CLASS,
      SCENE_WARM_PENDING_EVENT,
      SCENE_WARM_DONE_EVENT,
      WEBGL_UNAVAILABLE_BODY_CLASS,
      LOADER_GONE_BODY_CLASS,
      LOADER_MIN_MS,
      LOADER_WARM_MAX_MS,
      LOADER_SAFETY_MS,
      LOADER_SEEN_STORAGE_KEY,
      NATIVE_SCROLL_INTENT_PX,
      WARM_SESSION_STORAGE_KEY,
    }}
  >
    function initLoader() {
      // Only run on the home page — the loader element is present only on '/'.
      const loader = document.querySelector('.scene-loader');
      if (!loader) return;

      // Idempotent guard: if this loader element was already initialised (same
      // DOM instance), bail out. The flag lives on the element so it is cleared
      // automatically when the DOM is swapped (new .scene-loader = fresh element).
      if (loader.dataset.loaderInit) return;
      loader.dataset.loaderInit = '1';

      // Stamp body.loader-gone ONCE the dark ::before layer has fully faded out.
      // isConnected guards against stale timers firing after the page is swapped.
      const markGone = () => {
        if (!loader.isConnected) return;
        document.body.classList.add(LOADER_GONE_BODY_CLASS);
      };

      // Arm the loader-gone signal at the moment we reveal (scene-ready added).
      // Two paths race; whichever lands first wins (markGone is idempotent):
      //   1. transitionend of the ::before opacity fade — the EXACT moment the
      //      dark layer reaches opacity 0. transitionend on a ::before bubbles to
      //      the host, with event.pseudoElement === '::before'.
      //   2. a timeout backstop in case that transitionend is interrupted / never
      //      fires (element removed, browser quirks). Sized conservatively:
      //      fade-dur(0.7s) + generous main-thread margin = 2.1s after reveal.
      //      The ::before transition now has 0s delay (down from 1.02s), so the
      //      transitionend fires at ~700ms and wins the race; the 2.1s backstop
      //      is only a safety net for degenerate environments.
      let goneArmed = false;
      const armGone = () => {
        if (goneArmed) return;
        goneArmed = true;
        // SOFT-GL HARD CUT — when the software-rasteriser flattening is active
        // (html[data-soft-gl], stamped by createScene before scene:ready) the
        // loader's transitions are `none`, the overlay flips visibility:hidden
        // the instant scene-ready lands, and NO transitionend will ever fire.
        // Waiting out the 2.1s backstop would keep the in-scene markers inert
        // for 2.1s over an already-revealed scene, so release immediately.
        // Detected via the COMPUTED ::before transition-duration (0s covers
        // both data-soft-gl and any future no-transition regime) rather than
        // the attribute alone.
        const beforeStyle = window.getComputedStyle(loader, '::before');
        if (parseFloat(beforeStyle.transitionDuration) === 0) {
          markGone();
          return;
        }
        loader.addEventListener(
          'transitionend',
          (e) => {
            if (e.propertyName === 'opacity' && e.pseudoElement === '::before') markGone();
          },
          { passive: true },
        );
        window.setTimeout(markGone, 2100);
      };

      // First-load teardown hook (assigned below only on a first-session load):
      // clears the floor timer and detaches the passive scroll-intent observer.
      // reveal() runs it on EVERY release path — scene:ready+floor, intent,
      // explicit skip, and the 8s safety — so no decorative timer or listener
      // from this document can outlive the reveal or leak onto a swapped route.
      // A no-op by default (warm returns arm nothing).
      let teardownFirstLoad = () => {};
      let safetyTimer = 0;

      // Idempotent: adding the class twice is harmless. Every release path calls
      // this. Revealing tears down first-load machinery and arms the
      // loader-gone signal.
      const reveal = () => {
        // isConnected guard: if the page was swapped away since this closure was
        // created, stale timers must not touch the incoming document.
        if (!loader.isConnected) return;
        if (safetyTimer) {
          window.clearTimeout(safetyTimer);
          safetyTimer = 0;
        }
        teardownFirstLoad();
        document.body.classList.add(SCENE_READY_BODY_CLASS);
        // Stamp the engine's warm-session flag at the moment the reveal actually
        // lands — whatever path delivered it (scene:ready, intent, skip, or the
        // 8s safety). The engine normally stamps this itself at its first
        // scene:ready dispatch (createScene frame()), but on a contended
        // software-GL host the cold boot can reveal via the safety timer with
        // scene:ready starved — leaving the flag unset, so a warm return would
        // re-run the full cold steady-pacing hold it is meant to skip. By the
        // time ANY reveal lands, the first-visit JIT/raster storm the warm flag
        // waives has been paid (or there is no engine at all, in which case the
        // flag is simply unread). Idempotent with the engine's own stamp.
        try {
          window.sessionStorage?.setItem(WARM_SESSION_STORAGE_KEY, '1');
        } catch (_e) {
          // private mode / disabled storage — cold-path behaviour simply repeats.
        }
        armGone();
      };

      // SKIP INTRO — the server-rendered button inside the loader markup. Wired
      // here (not in the island) so it works pre-hydration. Skipping is the
      // IMMEDIATE path: reveal() starts the dissolve (scene-ready) and markGone()
      // releases interactivity (loader-gone) in the same stroke — the visitor
      // asked to move on, so nothing gates on the dissolve choreography. The
      // session was already marked seen at init below, so a later reload never
      // re-imposes the floor either. CSS hides the button on body.scene-ready
      // (its job is done once any reveal starts).
      const skip = loader.querySelector('.scene-loader-skip');
      if (skip) {
        skip.addEventListener('click', () => {
          reveal();
          markGone();
        });
      }

      // Warm back-nav / fast-hydration race: scene-ready is already on the body
      // (a previous reveal() call within this DOM phase already ran).
      // Just arm the loader-gone signal and exit — no need to re-listen.
      if (document.body.classList.contains(SCENE_READY_BODY_CLASS)) {
        armGone();
        return;
      }

      // Timestamp at init so the floor measures wall time since the page began
      // loading, not since scene:ready fired.
      const t0 = performance.now();

      // Is this the first load of the session? sessionStorage access is wrapped
      // in try/catch — private mode / disabled storage must never throw and trap
      // the loader. On ANY storage error we treat it as a first load and apply
      // the floor: a sub-second hold is harmless (it can't be remembered, so a
      // reload would re-apply it, but it never traps the user — the safety still
      // fires, the skip button stands, and the floor is a fixed short hold, not
      // a flag-dependent gate).
      let firstLoad = true;
      try {
        firstLoad = !window.sessionStorage.getItem(LOADER_SEEN_STORAGE_KEY);
        // Mark seen NOW so a fast reload within the session skips the floor.
        if (firstLoad) window.sessionStorage.setItem(LOADER_SEEN_STORAGE_KEY, '1');
      } catch (_e) {
        firstLoad = true;
      }

      // ── First-session release policy, modelled as one explicit predicate ──
      //
      // The normal reveal is authorised the moment:
      //
      //     scenePainted && (!firstLoad || floorElapsed || intentQualified)
      //
      // (`revealStarted` idempotency is owned by reveal()/scene-ready itself.)
      //
      // For a WARM return the floor never applies, so we just reveal on
      // scene:ready and none of the machinery below is armed. For a FIRST load
      // the reveal waits for the LATER of scene:ready and the floor — UNLESS the
      // visitor expresses intent by natively scrolling down, which permanently
      // waives ONLY the floor remainder for this loader instance. Intent NEVER
      // reveals an unpainted scene: scenePainted still gates every path.
      //
      // Three facts drive it; each sets its bit then re-evaluates the predicate:
      //   • scenePainted   — the real scene:ready event fired
      //   • floorElapsed   — LOADER_MIN_MS has passed since init (first load only)
      //   • intentQualified— native scrollY moved down ≥ NATIVE_SCROLL_INTENT_PX
      //                       from its init baseline (or was restored past it)
      let scenePainted = false;
      let intentQualified = false;
      let floorElapsed = !firstLoad; // a warm return has no floor to wait out
      let floorTimer = 0;
      let scrollObserving = false;

      // ── Warm gate: hold the reveal while the engine's boot bakes are running ──
      //
      // Fourth fact, alongside scenePainted / floorElapsed / intentQualified.
      // Every bake that lands BEFORE the reveal is a multi-hundred-ms stall the
      // visitor never feels on their first scroll, so the loader would rather
      // keep covering the boot than hand over a scene that hitches.
      //
      // Defaults to SETTLED and is only armed by a live scene that announces
      // pending bakes (SCENE_WARM_PENDING_EVENT). That default is what keeps
      // every no-engine path — reading routes, a document whose engine never
      // constructs, and the e2e specs that drive this loader with a held engine
      // and a synthetic scene:ready — behaving exactly as it did before the gate
      // existed. Nothing that cannot bake can extend the hold.
      //
      // Three independent releases, so it can never strand the reveal:
      //   • the engine settles it (fires on success, bake failure, and disposal)
      //   • LOADER_WARM_MAX_MS from init, whatever the engine is doing
      //   • scroll intent waives it outright, exactly as it waives the floor
      // and the unconditional 8s safety backstop still sits above all of them.
      let warmSettled = true;
      let warmTimer = 0;

      const settleWarmGate = () => {
        if (warmSettled) return;
        warmSettled = true;
        if (warmTimer) {
          window.clearTimeout(warmTimer);
          warmTimer = 0;
        }
        tryRelease();
      };

      // Passive scroll observer: qualifies intent from the scrollY OUTCOME only.
      // A raw wheel/touch/key that produces NO downward scroll never qualifies —
      // we read window.scrollY, not input events. Registered passive so it can
      // never preventDefault() or interfere with native scrolling.
      const scrollBaseline = window.scrollY;
      const onScroll = () => {
        if (window.scrollY - scrollBaseline >= NATIVE_SCROLL_INTENT_PX) qualifyIntent();
      };

      // Detach the floor timer + intent observer. reveal() calls this (via the
      // teardownFirstLoad hook) on EVERY release path, so nothing here outlives
      // the reveal or leaks onto a swapped route.
      teardownFirstLoad = () => {
        if (floorTimer) {
          window.clearTimeout(floorTimer);
          floorTimer = 0;
        }
        if (warmTimer) {
          window.clearTimeout(warmTimer);
          warmTimer = 0;
        }
        if (scrollObserving) {
          scrollObserving = false;
          window.removeEventListener('scroll', onScroll);
        }
      };

      // Re-check the release predicate and reveal exactly once when it holds.
      // reveal() owns teardown + idempotency + the isConnected guard, so a late
      // event after a page swap is a harmless no-op.
      const tryRelease = () => {
        // Intent is a full waiver: a visitor already scrolling is never held, for
        // the floor OR the bakes. Otherwise both must be satisfied.
        if (scenePainted && (intentQualified || (floorElapsed && warmSettled))) reveal();
      };

      const qualifyIntent = () => {
        if (intentQualified) return;
        intentQualified = true; // one-way: scrolling back up never reinstates it
        // Stop observing now even if the scene isn't painted yet — intent is a
        // latch, not a level, so we never need another scroll sample.
        if (scrollObserving) {
          scrollObserving = false;
          window.removeEventListener('scroll', onScroll);
        }
        tryRelease();
      };

      window.addEventListener(
        SCENE_READY_EVENT,
        () => {
          scenePainted = true;
          tryRelease();
        },
        { once: true },
      );

      // The engine announces pending bakes BEFORE its first paint, so this always
      // lands before the scene:ready above. Arming starts the capped hold; the
      // cap is measured from loader init (t0), not from this moment, so a late
      // announcement can never push the reveal past LOADER_WARM_MAX_MS.
      window.addEventListener(
        SCENE_WARM_PENDING_EVENT,
        () => {
          if (!firstLoad) return; // a warm return already paid the bakes this session
          warmSettled = false;
          warmTimer = window.setTimeout(() => {
            warmTimer = 0;
            warmSettled = true;
            tryRelease();
          }, Math.max(0, LOADER_WARM_MAX_MS - (performance.now() - t0)));
        },
        { once: true },
      );

      window.addEventListener(SCENE_WARM_DONE_EVENT, settleWarmGate, { once: true });

      // Recover a genuine first frame if its one-shot event won a future
      // ordering race. Producers stamp this durable bit immediately BEFORE
      // dispatching scene:ready; failure fallbacks deliberately never stamp it.
      if (document.body.dataset[SCENE_PAINTED_BODY_DATA_KEY] === 'true') {
        scenePainted = true;
        tryRelease();
      }

      if (firstLoad) {
        // Arm the floor and the intent observer only for a first-session load.
        floorTimer = window.setTimeout(() => {
          floorTimer = 0;
          floorElapsed = true;
          tryRelease();
        }, Math.max(0, LOADER_MIN_MS - (performance.now() - t0)));

        // A browser-restored scroll position already past the threshold IS intent
        // — do not replay a held intro over a history-restored below-page state.
        if (window.scrollY - scrollBaseline >= NATIVE_SCROLL_INTENT_PX) {
          qualifyIntent();
        } else {
          scrollObserving = true;
          window.addEventListener('scroll', onScroll, { passive: true });
        }
      }

      // Safety backstop ONLY — never the normal path. If a valid ready source
      // signalled (or a genuine frame's event was lost but its latch survived),
      // reveal it. Otherwise this is an import/boot/WebGL failure: expose the
      // existing static fallback and release interactivity immediately instead
      // of dissolving to empty black.
      if (!document.body.classList.contains(SCENE_READY_BODY_CLASS)) {
        safetyTimer = window.setTimeout(() => {
          safetyTimer = 0;
          if (!loader.isConnected) return;
          const ready = scenePainted
            || document.body.dataset[SCENE_PAINTED_BODY_DATA_KEY] === 'true';
          if (!ready) {
            document.body.classList.add(WEBGL_UNAVAILABLE_BODY_CLASS);
          }
          reveal();
          if (!ready) markGone();
        }, LOADER_SAFETY_MS);
      }
    }

    initLoader();
  </script>

  {/* On-brand WebGL-unavailable note. Hidden by default; revealed (display:flex) by
      body.webgl-unavailable, which HeroIsland adds when the hero's WebGL visual can't
      run — no/blocked WebGL at mount, or a GPU context lost mid-session. It is REAL,
      accessible text (not an image), in the site palette, that names the situation and
      hands the visitor the conventional path: the scroll-driven manifesto copy + the
      section nav links below keep working with no canvas, so this is a short framing
      note, not an error wall. role="status" so assistive tech announces it when it
      appears. The class literal mirrors WEBGL_UNAVAILABLE_BODY_CLASS in
      src/hero/lib/constants.ts (CSS keys off the same 'webgl-unavailable' body class). */}
  <div class="webgl-fallback" role="status">
    <p class="webgl-fallback-kicker">This experience needs WebGL.</p>
    <p class="webgl-fallback-lead">Your browser can't run the live stellar lifecycle — here's the short version:</p>
    <p class="webgl-fallback-body">
      I build software meant to <strong>last</strong>. Keep scrolling for the manifesto, or
      use the section links to jump straight to the work and the <a href={href('about')}>about page</a>.
    </p>
    {/* Featured-project proof (PRD-003) — the same Fleet evidence the live yellow
        marker carries, as ordinary server-rendered text/link, so a no-WebGL
        visitor gets the concrete example without a canvas. Derived from the
        validated heroProof projection; omitted entirely when nothing is
        featured (no placeholder). The link lands on /projects#<id>, the same
        catalogue fragment as the live marker. */}
    {featured && (
      <p class="webgl-fallback-proof">
        Featured: <strong>{featured.name}</strong> — {featured.summary}{' '}
        <span class="webgl-fallback-proof-signals">{featured.signals.join(' · ')}</span>.{' '}
        <a href={href(featured.href)}>See {featured.name} in Projects →</a>
      </p>
    )}
    <p class="webgl-fallback-cta">
      Make it last, or don't make it. Sounds interesting?
      <a href={href('contact')}>Get in touch.</a>
    </p>
  </div>

  {/* The signature object: a GPU-particle stellar lifecycle pinned to the center
      of the viewport. As the visitor scrolls DOWN, one normalized timeline runs the
      lifecycle in REVERSE: the page opens on the black hole (the big hero that pulls
      the portfolio interface in), un-detonates through the supernova into a red
      giant, settles back to a yellow star, dissolves into a nebula, and resolves to
      the lonely pale blue dot — the quiet speck at the bottom of the page.

      client:visible (not client:only) so Astro ships + hydrates the page shell —
      including the instant loader above — FIRST, then mounts the hero. The hero is
      above the fold, so client:visible fires essentially immediately; the win is
      that the loader paints with zero JS on the critical path and the heavy engine
      (dynamically imported inside HeroIsland) downloads off it. The component is
      SSR-safe: every window/three.js touch lives inside its mount effect, so the
      server only renders the empty canvas shell + manifesto chrome. */}
  <BlackHole
    client:visible
    counts={{ shipped: counts.shipped, dead: counts.dead, posts: counts.posts }}
    featured={featured}
  />

  {/* The scroll track. It contributes no visuals of its own — it exists only to
      give the page real scrollable height so the pinned scene can be scrubbed.
      The BlackHole island reads normalized window scroll progress and maps that
      single 0..1 value into the cinematic camera + shader timeline. */}
  <div class="scene-track" aria-hidden="true">
    {Array.from({ length: SCROLL_SECTION_COUNT }).map(() => <div class="scene-stage"></div>)}
  </div>

  {/* The manifesto copy is rendered by the island so it can fade per-state in
      lockstep with the morph. The static edition below carries the same copy
      (same BEATS source, so no drift) as real always-rendered HTML: it IS the
      homepage when JavaScript is off (CSS hides it under html.js and hides the
      loader + scroll track under html:not(.js)), and it keeps the page fully
      meaningful and indexable for crawlers and reader modes. Previously this
      lived in <noscript>, painted UNDERNEATH the opaque loader — a no-JS
      visitor saw only a dark screen. */}
  <StaticEdition />

</BaseLayout>
