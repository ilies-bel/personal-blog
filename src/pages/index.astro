---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHole from '../hero/BlackHole.tsx';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  STATEMENT_LINES,
  TENETS,
  WRITING_INTRO,
  ABOUT_TEASER,
  CONTACT_CTA,
  SOCIALS,
} from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} type="website">
  {/* The signature object: a Schwarzschild black hole (GPU-particle accretion
      disk) that fills the first viewport. Light is bent by gravity in the vertex
      shaders, the disk runs hot on the approaching side (Doppler + beaming), and
      its far edge bends up over the shadow. On load the camera pulls back in a
      single eased dezoom, then settles into a slow rotation. A client-only
      island, so three.js never blocks the page below. */}
  <BlackHole client:only="react" />

  {/* S1 — Statement. One sentence, revealed clause by clause (masked wipe). */}
  <section class="statement" data-reveal="lines">
    <p class="statement-text">
      {
        STATEMENT_LINES.map((line, i) => (
          <span class="reveal-line" style={`--d:${i}`}>
            <span class="reveal-line-inner">{line}</span>
          </span>
        ))
      }
    </p>
  </section>

  {/* S2 — How I work. Claims + clauses on drawn rules. */}
  <section class="tenets" data-reveal="rules">
    <p class="section-label">How I work</p>
    <ul class="tenet-list">
      {
        TENETS.map((t, i) => (
          <li class="tenet" style={`--i:${i}`}>
            <span class="tenet-rule" aria-hidden="true" />
            <span class="tenet-claim">{t.claim}</span>
            <span class="tenet-clause">{t.clause}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* S3 — Writing. The existing post list, with a quiet intro. */}
  <section class="writing" data-reveal="stagger">
    <p class="section-label">Writing</p>
    <p class="writing-intro">{WRITING_INTRO}</p>
    {
      posts.length === 0 ? (
        <p style="color: var(--fg-dim);">No posts yet. First one’s coming soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post, i) => (
            <li class="post-card" style={`--i:${i}`}>
              <a href={href(`posts/${post.id}`)}>
                <h3>{post.data.title}</h3>
                <span class="date">{fmt(post.data.pubDate)}</span>
                <p class="desc">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <span class="tags">
                    {post.data.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* S4 — About teaser. The deliberate calm beat: no reveal motion. */}
  <section class="about-teaser">
    <p class="about-teaser-text">{ABOUT_TEASER}</p>
    <a class="about-teaser-link" href={href('about')}>More about me</a>
  </section>

  {/* S5 — Contact. The only amber on the page: a single drawn rule + mailto. */}
  <section class="contact" data-reveal="contact">
    <span class="contact-rule" aria-hidden="true"></span>
    <p class="contact-text">{CONTACT_CTA}</p>
    {
      SOCIALS.email && (
        <a class="contact-link" href={`mailto:${SOCIALS.email}`}>
          {SOCIALS.email}
        </a>
      )
    }
  </section>

  {/* Progressive enhancement only: reveals an already-visible page on scroll.
      No island, no hydration; SSR / no-JS see every section in full. */}
  <script>
    import '../scripts/reveal.ts';
  </script>
</BaseLayout>
