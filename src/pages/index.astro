---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHole from '../hero/BlackHole.tsx';
import { BEATS } from '../hero/beats';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} type="website" bare>
  {/* The signature object: a Schwarzschild black hole (GPU-particle accretion
      disk) pinned to the center of the viewport. As the visitor scrolls, the
      object runs the stellar lifecycle IN REVERSE — black hole, then a reverse
      supernova that implodes the disk and flares it back out into a remnant
      cloud, then a red supergiant, a large star, and finally a stellar cloud.
      Each stage reveals a little more about Iliès. The scene is a client-only
      island; three.js never blocks the page. */}
  <BlackHole client:only="react" />

  {/* The scroll track. It contributes no visuals of its own — it exists only to
      give the page real scrollable height so the pinned scene can be scrubbed.
      Each "stage" is one viewport tall; the BlackHole island reads window scroll
      progress and morphs the object accordingly. */}
  {/* One full-viewport stage per lifecycle beat. Mapping over BEATS means the
      stage count can never disagree with STAGE_COUNT (= BEATS.length) — the
      number that drives the morph timeline in the island. */}
  <div class="scene-track" aria-hidden="true">
    {BEATS.map(() => <div class="scene-stage"></div>)}
  </div>

  {/* The manifesto copy is rendered by the island so it can fade per-state in
      lockstep with the morph and swap its big line on scroll direction. The
      static fallback below mirrors that copy (down-arc big lines + whispers) so
      the page stays meaningful and indexable for crawlers / no-JS. */}
  {/* The static no-JS / crawler fallback mirrors the live overlay's "down"
      (rewind-arc) big line + whisper for every beat, mapped over the same BEATS
      so the SSR copy can never drift from the live copy. The first beat is the
      page's <h1> (black hole, top of page); the rest are <h2>. The state label
      and the "up" line are island-only flourishes and stay out of the fallback,
      exactly as before. The CTA tail is fixed chrome, not per-beat. */}
  <noscript>
    <div class="scene-fallback measure">
      <p class="scene-fallback-name">ILIÈS BELDJILALI</p>
      <p class="scene-fallback-role">Software Engineer</p>

      {BEATS.map((beat, i) => (
        <Fragment>
          {i === 0 ? <h1>{beat.down}</h1> : <h2>{beat.down}</h2>}
          <p>{beat.whisper}</p>
        </Fragment>
      ))}

      <p>Make it last, or don't make it. Sounds interesting?
        <a href={`${href('about')}#get-in-touch`}>Get in touch.</a></p>
    </div>
  </noscript>
</BaseLayout>
