---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IslandsDemo from '../../components/mdx/IslandsDemo.tsx';
import SceneFigure from '../../components/mdx/SceneFigure.tsx';
import SignalsReadout from '../../components/mdx/SignalsReadout.tsx';
import { stationForStage } from '../../hero/sceneTable';
import { AUTHOR_NAME } from '../../consts';
import { ogCardFor } from '../../lib/ogCard';

// Pre-render one static HTML page per post at build time (SSG → SEO-ready).
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

// CONTINUATION — the reading journey must not dead-end at a copyright line. The
// "next note" walks the index order (newest → oldest, same as /writing), wrapping
// from the oldest back to the newest; a single-post collection shows nothing.
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const postIndex = allPosts.findIndex((p) => p.id === post.id);
const nextPost = allPosts.length > 1 ? allPosts[(postIndex + 1) % allPosts.length] : null;
// The next note's lifecycle STATION readout (same glyph pair as the writing index).
const nextJourney = nextPost?.data.scene?.journey;
const nextFrom = stationForStage(nextJourney ? nextJourney[0] : 0);
const nextTo = nextJourney ? stationForStage(nextJourney[1]) : null;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// FORMALIZED CO-AUTHORSHIP (P6). `authors` defaults to the site owner in the
// schema; when a post lists more names, the co-authors get a visible byline
// below the description and the full array flows into the BlogPosting JSON-LD
// (BaseLayout spreads `authors` into BaseHead). The provenance note ("first
// ran elsewhere") is post data too — same source /writing renders.
const coAuthors = post.data.authors.filter((name) => name !== AUTHOR_NAME);
const provenance = post.data.provenance;

// MDX component map: in-prose islands authors can drop into a post. Each hydrates on
// its own (client:* in the MDX), keeping the surrounding prose zero-JS — the islands
// thesis, demonstrated. Passed to <Content components={...} /> below.
const mdxComponents = { IslandsDemo, SceneFigure, SignalsReadout };
---

{/* READING SURFACE — posts render on calm darkness: the sitewide near-black room
   (--bg, base.css) with only the faint sitewide grid texture. No celestial
   backdrop is mounted behind body text — the scene renders belong to the home
   hero / the list pages / Behind the Build, not under a reading column. Any
   in-prose scene plates a post wants come through the MDX islands (SceneFigure). */}
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.ogImage ?? ogCardFor(`post-${post.id}`)}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  authors={post.data.authors}
  bodyClass="article-page"
>
  <article class="prose">
    <header class="article-header">
      <a class="article-back" href={href('writing')}>
        <span class="article-back-bracket" aria-hidden="true"></span>
        <span class="article-back-label" data-decode>Back to writing</span>
      </a>
      <p class="article-kicker">Post · {fmt(post.data.pubDate)}</p>
      {/* Shared-element morph target: matches the writing index's per-post
          transition:name (row title / featured h2), so the clicked title
          physically travels into this headline — browser-back reverses it. */}
      <h1 transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {/* Visible co-author byline + provenance (P6) — rendered from post data,
          in the quiet instrument-readout register (.article-meta). Solo posts
          by the site owner show neither line. */}
      {coAuthors.length > 0 && (
        <p class="article-meta article-byline">Co-written with {coAuthors.join(', ')}</p>
      )}
      {provenance && (
        <p class="article-meta article-provenance">
          {provenance.url ? (
            <a href={provenance.url} rel="noopener noreferrer">{provenance.note}</a>
          ) : (
            provenance.note
          )}
        </p>
      )}
      {post.data.tags.length > 0 && (
        <p class="article-tags">
          <span class="sr-only">Tags: </span>
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </p>
      )}
      {
        post.data.updatedDate && (
          <p class="article-meta">Updated {fmt(post.data.updatedDate)}</p>
        )
      }
    </header>
    <Content components={mdxComponents} />

    {/* EVIDENCE (P13) — the artifacts backing the piece, from frontmatter
        `evidence` (original publication, upstream bug threads, profiler
        captures…). Same honesty grammar as the project claims ledger: the
        aside renders only when artifacts exist — no placeholder box. */}
    {post.data.evidence.length > 0 && (
      <aside class="article-evidence" aria-labelledby="article-evidence-title">
        <p class="article-evidence-title" id="article-evidence-title">Evidence</p>
        <ul class="article-evidence-list">
          {post.data.evidence.map((item) => (
            <li>
              {item.url ? (
                <a href={item.url} rel="noopener noreferrer">{item.label}</a>
              ) : (
                item.label
              )}
            </li>
          ))}
        </ul>
      </aside>
    )}

    {/* CONTINUATION — the journey keeps moving at the article's end instead of
        stopping on the copyright line. The next note's title carries ITS OWN
        post-title transition:name, so clicking through morphs this teaser title
        into the next article's h1 — the same shared-element choreography the
        writing index uses. */}
    {nextPost && (
      <footer class="article-next" aria-label="Continue reading">
        <p class="article-next-eyebrow">Next note</p>
        <a class="article-next-link" href={href(`posts/${nextPost.id}/`)}>
          <span
            class="writing-journey"
            role="img"
            aria-label={`Scene: ${nextTo ? `${nextFrom.label} to ${nextTo.label}` : nextFrom.label}`}
          >
            <span class="writing-journey-glyph" style={`--glyph: url('${href(nextFrom.glyphSrc)}')`} />
            {nextTo && <span class="writing-journey-arrow">→</span>}
            {nextTo && (
              <span class="writing-journey-glyph" style={`--glyph: url('${href(nextTo.glyphSrc)}')`} />
            )}
            <span class="writing-journey-label">
              {nextTo ? `${nextFrom.label} → ${nextTo.label}` : nextFrom.label}
            </span>
          </span>
          <span class="article-next-title" transition:name={`post-title-${nextPost.id}`}>
            {nextPost.data.title}
          </span>
          <span class="article-next-desc">{nextPost.data.description}</span>
        </a>
        <a class="article-next-all" href={href('writing')}>[ all writing ]</a>
      </footer>
    )}
  </article>
</BaseLayout>
