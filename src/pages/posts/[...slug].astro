---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlackHole from '../../hero/BlackHole.tsx';
import TesseractBackdrop from '../../hero/components/TesseractBackdrop.astro';

// Pre-render one static HTML page per post at build time (SSG → SEO-ready).
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

{/* The article reads in the same room as the hero: the signature object sits
   pinned to its BLACK-HOLE frame (backdropStage=0), heavily dimmed by CSS to a
   faint graphite/gold atmosphere behind the reading column. `body.article-page` (set
   below) tunes the dim down for the bright photon ring and softens the standard
   page glow so the two don't muddy. See body.article-page .bh-backdrop in hero.css. */}
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.ogImage}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  bodyClass="article-page"
>
  {/* Backdrop layer. By default this is the live signature scene, frozen at the
     black-hole frame — quiet atmosphere, not the showpiece. client:only means it
     simply doesn't render without JS, leaving the article fully readable on the
     plain dark room. A post may override it via frontmatter `backdrop`:
     'tesseract' swaps in the Interstellar bookcase-corridor image backdrop
     (INSPIRATION / 01) instead, while every other post keeps the live scene. Both
     sit at z-index 0 behind the reading column and under the dive overlay, so the
     marker dive resurfaces INTO whichever backdrop the destination renders. */}
  {
    post.data.backdrop === 'tesseract' ? (
      <TesseractBackdrop />
    ) : (
      <BlackHole client:only="react" backdrop backdropStage={0} />
    )
  }

  <article class="prose">
    <header class="article-header">
      <a class="article-back" href={href('writing')}>
        <span class="article-back-bracket" aria-hidden="true"></span>
        <span class="article-back-label">Back to writing</span>
      </a>
      <p class="article-kicker">Post · {fmt(post.data.pubDate)}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <p class="article-tags" aria-label="Tags">
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </p>
      )}
      {
        post.data.updatedDate && (
          <p class="article-meta">Updated {fmt(post.data.updatedDate)}</p>
        )
      }
    </header>
    <Content />
  </article>
</BaseLayout>
