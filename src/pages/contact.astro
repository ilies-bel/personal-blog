---
// CONTACT — the dedicated channel page (P7). One calm reading column in the
// standard chrome (subnav rail + footer, NOT bare): a direct mailto as the one
// big action, then the availability facts as a quiet mono instrument readout —
// the same dl grammar as the projects metadata strip, scaled up to full rows.
// No form, no funnel: the page states the channel, its status, and the terms,
// and gets out of the way. Everything here is server-rendered HTML (axe-clean,
// keyboard-first, fully usable with JavaScript off); the only decoration is
// the ambient nebula poster behind it.
//
// The availability facts live in src/consts.ts (AVAILABILITY) — safe defaults
// pending the owner's confirmation (docs/INPUTS-NEEDED.md, P13). Edit there,
// this page follows. The TRANSMISSION art direction (P9) is the dedicated
// 'transmission' AmbientBackdrop variant: the pale-blue-dot frame with static
// signal rings and a slow radial pulse from the CTA area (hero.css).
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientBackdrop from '../components/AmbientBackdrop.astro';
import RouteEnding from '../components/RouteEnding.astro';
import { SITE_TITLE, SOCIALS, AVAILABILITY } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// Mono status legend — the dot's tint keys off data-status in contact.css.
const STATUS_LABEL: Record<typeof AVAILABILITY.status, string> = {
  open: 'Open',
  limited: 'Limited',
  closed: 'Closed',
};
---

<BaseLayout
  title="Contact"
  description={`Contact ${SITE_TITLE}: availability, location, timezone, and a direct line — no forms, no funnels.`}
  type="website"
  bodyClass="contact-page"
>
  {/* TRANSMISSION backdrop (P9) — the pale-blue-dot frame as a signal source:
      static concentric rings + a slow motion-gated radial pulse from the CTA
      area (hero.css). Zero JS, zero WebGL (P4 poster pipeline); the corner
      scene-toggle circle still parks it. */}
  <AmbientBackdrop variant="transmission" />

  <section class="contact-hero" aria-labelledby="contact-title">
    <p class="contact-kicker">Transmission</p>
    <h1 id="contact-title">Open channel.</h1>
    <p class="contact-lead">
      No forms, no funnels — one address, read by one person. Tell me what
      you're building, what's hurting, or just what you thought of the black
      hole.
    </p>
  </section>

  <div class="contact-panel">
    {/* THE action: a direct mailto, big and unmistakable (≥44px target). The
        label carries the verb; the visible address doubles as the fallback for
        anyone who'd rather copy it into their own client. */}
    <a class="contact-cta" href={`mailto:${SOCIALS.email}`}>
      <span class="contact-cta-label" data-decode>Send a transmission</span>
      <span class="contact-cta-addr">{SOCIALS.email}</span>
    </a>

    {/* Channel readout — the availability facts as mono instrument rows (the
        projects-meta dl grammar at full width). Real <dl> semantics: each row
        is one term/description pair. */}
    <dl class="contact-channel">
      <div class="contact-row">
        <dt>Status</dt>
        <dd>
          <span
            class="contact-status-dot"
            data-status={AVAILABILITY.status}
            aria-hidden="true"></span>
          {STATUS_LABEL[AVAILABILITY.status]} — {AVAILABILITY.note.toLowerCase()}
        </dd>
      </div>
      <div class="contact-row">
        <dt>Engagements</dt>
        <dd>{AVAILABILITY.engagements.join(' · ')}</dd>
      </div>
      <div class="contact-row">
        <dt>Location</dt>
        <dd>{AVAILABILITY.location}</dd>
      </div>
      <div class="contact-row">
        <dt>Timezone</dt>
        <dd>{AVAILABILITY.timezone}</dd>
      </div>
      <div class="contact-row">
        <dt>Response</dt>
        <dd>{AVAILABILITY.responseTime.toLowerCase()}</dd>
      </div>
    </dl>

    {/* Secondary frequencies + the proof line back to the work. */}
    <nav class="contact-elsewhere" aria-label="Other channels">
      <span class="contact-elsewhere-label" aria-hidden="true">Other frequencies</span>
      <ul class="contact-elsewhere-list">
        {SOCIALS.github && <li><a href={SOCIALS.github} data-decode>GitHub</a></li>}
        {SOCIALS.twitter && <li><a href={SOCIALS.twitter} data-decode>Twitter / X</a></li>}
      </ul>
    </nav>

  </div>

  {/* ROUTE ENDING (P9) — Contact closes the loop back to Work: proof before
      the first message. Replaces the old generic one-line proof paragraph. */}
  <RouteEnding
    width="column"
    eyebrow="Want proof before you write?"
    title="Start with the work that held"
    href={href('projects')}
  />
</BaseLayout>
