---
// WRITING — two first-class views, always equivalent:
//   · List view   → the conventional shelf: articles grouped by type
//                   (EXP-016: investigation / build-note / essay / failure),
//                   then The graveyard, then About this site. This is the
//                   keyboard and screen-reader path; always in the DOM.
//   · Map view    → the Nebular knowledge map (EXP-027): articles cluster by
//                   genuine theme/type using CSS spatial composition. Zero
//                   Three.js (PERF-002). Generated client-side on first toggle
//                   from JSON data embedded in the page — no duplicate DOM
//                   elements at initial load, so existing AT flows are clean.
//
// Physical law: "dispersed matter coalescing" (route-physical-laws.md §Writing).
// Clusters emerge from whitespace gravity, not drawn borders. Entry: 6 px
// outward drift → centre, 600 ms ease-out. Hover: local pull ≤ 4 px.
// Reduced-motion: opacity transitions only, no transforms.
//
// The h1 and the nav active state carry the page's context — no kicker row, no
// instrument numbering. Every destination is a real <a>.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteBackdrop from '../components/RouteBackdrop.astro';
import { HUD_NAV_ITEMS } from '../hero/sceneTable';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// The inspiration essay's path comes from the hero's own black-hole nav row —
// the same source of truth BaseLayout uses — so a slug change can't strand this link.
const inspirationHref = HUD_NAV_ITEMS.find((item) => item.id === 'end')?.href ?? 'writing';

// The Inspiration essay lives in the posts collection but reads as site meta —
// it gets its own entry in "About this site" below, so the article list excludes
// it. Its id is derived from the same nav href, keeping one source of truth.
const inspirationId = inspirationHref.replace(/^posts\//, '');

const articles = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((post) => post.id !== inspirationId)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Reading time: ~220 wpm over the raw MDX body — cheap, static, close enough.
const readMinutes = (body: string | undefined) =>
  Math.max(1, Math.round((body ?? '').trim().split(/\s+/).length / 220));

// Provenance notes for pieces that first ran elsewhere, keyed by post id.
const origins: Record<string, string> = {
  'memory-leak-search-and-destroy': 'First published on Medium, in French',
};

// ---- Orientation grouping (EXP-016) ----------------------------------------
// Articles are grouped by their editorially-assigned type so a reader can see
// at a glance what kind of thing they are about to read. Defined order sets the
// canonical shelf sequence: narrative first, then investigative, then meta.
type PostType = 'investigation' | 'build-note' | 'essay' | 'failure';

const TYPE_ORDER: readonly PostType[] = ['investigation', 'build-note', 'essay', 'failure'];

// Human-readable plural heading for each type group (shown as h3 under the
// Articles h2 — no instrument numbering, plain-language vocabulary).
const TYPE_LABELS: Record<PostType, string> = {
  'investigation': 'Investigations',
  'build-note':    'Build notes',
  'essay':         'Essays',
  'failure':       'Failures',
};

// Only emit groups that have at least one entry; the empty type rows are silence.
const articlesByType: [PostType, typeof articles][] = TYPE_ORDER
  .map((t) => [t, articles.filter((p) => p.data.type === t)] as [PostType, typeof articles])
  .filter(([, posts]) => posts.length > 0);

// Nebula map data — serialised as JSON for client-side map generation.
// The map panel is NOT in the SSR HTML; it is generated from this data on the
// first "Map" button click. This avoids duplicate DOM links at initial load,
// keeping existing AT and test flows clean (EXP-027 + backlog rule).
type ClusterData = {
  type: string;
  typeLabel: string;
  posts: {
    href: string;
    title: string;
    dateIso: string;
    dateLabel: string;
    readMinutes: number;
    topics: string[];
    description: string;
  }[];
};

const nebulaData: ClusterData[] = articlesByType.map(([type, posts]) => ({
  type,
  typeLabel: TYPE_LABELS[type],
  posts: posts.map((post) => ({
    href: href(`posts/${post.id}/`),
    title: post.data.title,
    dateIso: post.data.pubDate.toISOString(),
    dateLabel: fmt(post.data.pubDate),
    readMinutes: readMinutes(post.body),
    topics: post.data.topics,
    description: post.data.description,
  })),
}));
---

<BaseLayout
  title="Writing"
  description={`Writing by ${SITE_TITLE}: articles, the graveyard of dead projects, and the notes on why this site exists and how it was built.`}
  type="website"
  bodyClass="writing-page"
>
  {/* Lightweight CSS backdrop — NEBULA atmosphere (stage 3.5, Writing's own
      celestial body in the nav model).  Zero Three.js bytes (PERF-002).
      The `variant` prop is the EXP-020/EXP-035 seam — restyle here without
      re-plumbing the page.  body.backdrop-off still dims it (RouteBackdrop.astro). */}
  <RouteBackdrop variant="nebula" />

  {/* Page header — h1 only. The kicker/designation row is gone on purpose: the
      headline and the nav active state carry the context, and this page keeps
      no instrument numbering. `.writing-hero` keeps the sitewide entrance
      choreography (transitions.css keys on it). */}
  <header class="writing-hero">
    <h1>Everything, in plain words.</h1>
  </header>

  {/* ── View toggle ─────────────────────────────────────────────────────────
      Two first-class equivalent orientations. List is the default — it is the
      keyboard and screen-reader path. Map is the nebular cluster view (EXP-027).
      aria-pressed on each button reflects which view is currently active.
      The toggle is in the tab order; no spatial navigation is required to
      discover the list alternative (backlog rule). */}
  <div class="writing-view-controls" role="group" aria-label="Article view mode">
    <button class="writing-view-btn is-active" data-view="list" aria-pressed="true">List</button>
    <button class="writing-view-btn" data-view="map" aria-pressed="false">Map</button>
  </div>

  {/* ── Articles panels wrapper ───────────────────────────────────────────────
      On initial load: only the list panel exists in the DOM.
      On first "Map" click: the JS generator inserts the map panel here using
      data from #writing-nebula-data. This keeps the DOM clean (no duplicate
      links) for both screen readers and strict-mode test locators. */}
  <div id="writing-views" data-active-view="list">

    {/* ── LIST panel (always in DOM — the accessible representation) ───── */}
    <div class="writing-view-panel" data-panel="list">
      <section class="writing-section" aria-labelledby="articles-title">
        <h2 class="writing-section-title" id="articles-title">Articles</h2>

        {articlesByType.map(([type, posts]) => (
          <div class="writing-type-group">
            {/* Type group heading — plain vocabulary (no codes, no instrument
                language). Announces the form before the entry: readers know they
                are looking at an Investigation, Build note, Essay, or Failure
                before committing to a click. */}
            <h3 class="writing-type-heading" id={`type-${type}`}>{TYPE_LABELS[type]}</h3>
            <div class="writing-list">
              {posts.map((post) => (
                <a
                  class="writing-row"
                  href={href(`posts/${post.id}/`)}
                  data-entry-type={post.data.type}
                >
                  <span class="writing-row-left">
                    <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                    <span class="writing-row-fact">{readMinutes(post.body)} min read</span>
                  </span>
                  <span class="writing-row-copy">
                    {/* Per-post shared-element name → the article h1 (posts/[...slug]),
                        so the clicked title physically travels into the headline. */}
                    <span class="writing-row-title" transition:name={`post-title-${post.id}`} data-decode>{post.data.title}</span>
                    <span class="writing-row-description">{post.data.description}</span>
                    {post.data.topics.length > 0 && (
                      <span class="writing-row-topics">
                        {post.data.topics.join(' · ')}
                      </span>
                    )}
                    {origins[post.id] && <span class="writing-row-origin">{origins[post.id]}</span>}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    </div>

    {/* ── MAP panel placeholder — filled by JS on first toggle ─────────── */}
    {/* The map panel is injected here; initially absent to prevent duplicate
        DOM links that would break strict-mode locators in existing tests. */}

  </div>
  {/* /writing-views */}

  {/* ── Persistent destinations ───────────────────────────────────────────────
      Graveyard and About this site are always visible outside the toggle region.
      They are not article clusters — they are nav destinations. They remain
      reachable in both views without any toggle interaction. */}
  <section class="writing-section" aria-labelledby="graveyard-title">
    <h2 class="writing-section-title" id="graveyard-title">The graveyard</h2>
    <div class="writing-list">
      <a class="writing-row" href={href('graveyard')}>
        <span class="writing-row-left">
          <span class="writing-row-fact">Failures</span>
        </span>
        <span class="writing-row-copy">
          <span class="writing-row-title" data-decode>Dead projects, kept and owned</span>
          <span class="writing-row-description">
            The work that didn't survive — dated, honoured, and left readable,
            because the dead ends are where the lessons are.
          </span>
        </span>
      </a>
    </div>
  </section>

  <section class="writing-section" aria-labelledby="meta-title">
    <h2 class="writing-section-title" id="meta-title">About this site</h2>
    <div class="writing-list">
      <a class="writing-row" href={href(inspirationHref)}>
        <span class="writing-row-left">
          <span class="writing-row-fact">Essay</span>
        </span>
        <span class="writing-row-copy">
          <span class="writing-row-title" data-decode>Why this site exists</span>
          <span class="writing-row-description">
            Two pictures I could never get out of my head, and why this portfolio
            is built like a star and begins at the end.
          </span>
        </span>
      </a>
      <a class="writing-row" href={href('behind-the-build')}>
        <span class="writing-row-left">
          <span class="writing-row-fact">Build notes</span>
        </span>
        <span class="writing-row-copy">
          <span class="writing-row-title" data-decode>Behind the build</span>
          <span class="writing-row-description">
            How the scroll-scrubbed stellar lifecycle actually works: one engine,
            nine shaders, and the budgets that keep it fast.
          </span>
        </span>
      </a>
    </div>
  </section>

  {/* ── Nebula map data — JSON payload for client-side map generation ─────────
      Invisible to screen readers. Contains the same articles as the list panel
      serialised for the JavaScript map builder. The map panel (data-panel="map")
      is generated from this data on the first "Map" click, then cached. */}
  <script type="application/json" id="writing-nebula-data" set:html={JSON.stringify(nebulaData)} />
</BaseLayout>

{/* ── View-toggle + map-generator script ───────────────────────────────────────
    Lightweight: no framework, no bundler overhead. Runs once per navigation
    via astro:page-load (ClientRouter-safe).

    Responsibilities:
      1. Toggle: update data-active-view, flip aria-pressed, flip aria-hidden.
      2. Map generation: read JSON, build map panel HTML, insert into #writing-views
         on the FIRST "Map" click (subsequent clicks reuse the cached panel).
      3. Coalesce re-trigger: void + reflow + restore animation on each Map entry.

    The list panel is the accessible canonical representation. The map panel is
    a visual progressive enhancement — absent until explicitly requested, so the
    initial DOM is clean for both AT and strict-mode test locators. */}
<script>
  // ---- Type matching the server-side ClusterData shape --------------------
  interface NebulaPost {
    href: string;
    title: string;
    dateIso: string;
    dateLabel: string;
    readMinutes: number;
    topics: string[];
    description: string;
  }
  interface NebulaCluster {
    type: string;
    typeLabel: string;
    posts: NebulaPost[];
  }

  // ---- DOM helpers ---------------------------------------------------------

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Build the nebula card HTML for a single post.
  // typeLabel is passed via closure from clusterHTML.
  function cardHTML(post: NebulaPost, typeLabel: string): string {
    const topicsHTML = post.topics.length > 0
      ? `<span class="nebula-card-topics">${esc(post.topics.join(' · '))}</span>`
      : '';
    return `
<a class="nebula-card" href="${esc(post.href)}">
  <span class="nebula-card-type">${esc(typeLabel)}</span>
  <span class="nebula-card-title">${esc(post.title)}</span>
  <span class="nebula-card-meta">
    <time datetime="${esc(post.dateIso)}">${esc(post.dateLabel)}</time>
    <span class="nebula-card-read">${post.readMinutes} min read</span>
  </span>
  ${topicsHTML}
  <span class="nebula-card-description">${esc(post.description)}</span>
</a>`.trim();
  }

  // Build the cluster HTML for one type group.
  function clusterHTML(cluster: NebulaCluster): string {
    const cards = cluster.posts.map((p) => cardHTML(p, cluster.typeLabel)).join('\n');
    return `
<div class="nebula-cluster" data-cluster-type="${esc(cluster.type)}">
  <h3 class="nebula-cluster-label">${esc(cluster.typeLabel)}</h3>
  <div class="nebula-cluster-cards">
    ${cards}
  </div>
</div>`.trim();
  }

  // Build the full map panel HTML.
  function buildMapPanel(clusters: NebulaCluster[]): string {
    const clusterHTMLs = clusters.map(clusterHTML).join('\n');
    return `
<div class="writing-view-panel" data-panel="map" aria-hidden="true">
  <section class="writing-section nebula-section" aria-labelledby="articles-map-title">
    <h2 class="writing-section-title" id="articles-map-title">Articles</h2>
    <div class="nebula-map">
      ${clusterHTMLs}
    </div>
  </section>
</div>`.trim();
  }

  // ---- Toggle logic --------------------------------------------------------

  function initViewToggle(): void {
    const views = document.getElementById('writing-views') as HTMLElement | null;
    const btns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.writing-view-btn')
    );
    if (!views || btns.length === 0) return;

    // Load cluster data from the embedded JSON payload (once per page).
    let clusters: NebulaCluster[] | null = null;
    const dataEl = document.getElementById('writing-nebula-data');
    if (dataEl?.textContent) {
      try {
        clusters = JSON.parse(dataEl.textContent) as NebulaCluster[];
      } catch {
        // Malformed JSON — map view unavailable; list remains the only view.
        clusters = null;
      }
    }

    // Whether the map panel has been generated and inserted yet.
    let mapReady = false;

    function ensureMapPanel(): void {
      if (mapReady || !clusters) return;

      const html = buildMapPanel(clusters);
      // Parse via DOMParser so Astro's sanitiser doesn't strip attributes.
      const frag = document.createElement('div');
      frag.innerHTML = html;
      const panel = frag.firstElementChild;
      if (panel) views!.appendChild(panel);
      mapReady = true;
    }

    function setView(view: string): void {
      // Generate the map panel on first request.
      if (view === 'map') ensureMapPanel();

      views!.dataset.activeView = view;

      btns.forEach((b) => {
        const active = b.dataset.view === view;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('is-active', active);
      });

      // Update aria-hidden on panels.
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
        panel.setAttribute('aria-hidden', String(panel.dataset.panel !== view));
      });

      // Re-trigger the nebula coalesce animation each time the map becomes
      // active so it always plays from the outward-drift start position.
      if (view === 'map') {
        document.querySelectorAll<HTMLElement>('.nebula-card').forEach((card) => {
          card.style.animation = 'none';
          // Force reflow so the browser registers the change before restoring.
          void card.offsetHeight;
          card.style.animation = '';
        });
      }
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        if (view) setView(view);
      });
    });
  }

  // ClientRouter-safe: runs after each in-page navigation as well as the
  // initial page load.
  document.addEventListener('astro:page-load', initViewToggle);
</script>
