---
// WRITING — a sectioned index, not a prose menu. Three quiet shelves:
//   · Articles        → the on-site posts, grouped by type (investigation /
//                       build-note / essay / failure) so a reader can orient
//                       at a glance: what kind of thing is this, and how long
//                       will it take? (EXP-016: no HUD decoding required)
//   · The graveyard   → dead projects, kept and owned
//   · About this site → the Inspiration essay + the Behind the Build case study
// The h1 and the nav active state carry the page's context — no kicker row, no
// instrument numbering. Every destination is a real <a> with the site's
// decode-hover convention on its title.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteBackdrop from '../components/RouteBackdrop.astro';
import { HUD_NAV_ITEMS } from '../hero/sceneTable';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// The inspiration essay's path comes from the hero's own black-hole nav row —
// the same source of truth BaseLayout uses — so a slug change can't strand this link.
const inspirationHref = HUD_NAV_ITEMS.find((item) => item.id === 'end')?.href ?? 'writing';

// The Inspiration essay lives in the posts collection but reads as site meta —
// it gets its own entry in "About this site" below, so the article list excludes
// it. Its id is derived from the same nav href, keeping one source of truth.
const inspirationId = inspirationHref.replace(/^posts\//, '');

const articles = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((post) => post.id !== inspirationId)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Reading time: ~220 wpm over the raw MDX body — cheap, static, close enough.
const readMinutes = (body: string | undefined) =>
  Math.max(1, Math.round((body ?? '').trim().split(/\s+/).length / 220));

// Provenance notes for pieces that first ran elsewhere, keyed by post id.
const origins: Record<string, string> = {
  'memory-leak-search-and-destroy': 'First published on Medium, in French',
};

// ---- Orientation grouping (EXP-016) ----------------------------------------
// Articles are grouped by their editorially-assigned type so a reader can see
// at a glance what kind of thing they are about to read. Defined order sets the
// canonical shelf sequence: narrative first, then investigative, then meta.
type PostType = 'investigation' | 'build-note' | 'essay' | 'failure';

const TYPE_ORDER: readonly PostType[] = ['investigation', 'build-note', 'essay', 'failure'];

// Human-readable plural heading for each type group (shown as h3 under the
// Articles h2 — no instrument numbering, plain-language vocabulary).
const TYPE_LABELS: Record<PostType, string> = {
  'investigation': 'Investigations',
  'build-note':    'Build notes',
  'essay':         'Essays',
  'failure':       'Failures',
};

// Only emit groups that have at least one entry; the empty type rows are silence.
const articlesByType: [PostType, typeof articles][] = TYPE_ORDER
  .map((t) => [t, articles.filter((p) => p.data.type === t)] as [PostType, typeof articles])
  .filter(([, posts]) => posts.length > 0);
---

<BaseLayout
  title="Writing"
  description={`Writing by ${SITE_TITLE}: articles, the graveyard of dead projects, and the notes on why this site exists and how it was built.`}
  type="website"
  bodyClass="writing-page"
>
  {/* Lightweight CSS backdrop — NEBULA atmosphere (stage 3.5, Writing's own
      celestial body in the nav model).  Zero Three.js bytes (PERF-002).
      The `variant` prop is the EXP-020/EXP-035 seam — restyle here without
      re-plumbing the page.  body.backdrop-off still dims it (RouteBackdrop.astro). */}
  <RouteBackdrop variant="nebula" />

  {/* Page header — h1 only. The kicker/designation row is gone on purpose: the
      headline and the nav's active state carry the context, and this page keeps
      no instrument numbering. `.writing-hero` keeps the sitewide entrance
      choreography (transitions.css keys on it). */}
  <header class="writing-hero">
    <h1>Everything, in plain words.</h1>
  </header>

  <section class="writing-section" aria-labelledby="articles-title">
    <h2 class="writing-section-title" id="articles-title">Articles</h2>

    {articlesByType.map(([type, posts]) => (
      <div class="writing-type-group">
        {/* Type group heading — plain vocabulary (no codes, no instrument
            language). Announces the form before the entry: readers know they
            are looking at an Investigation, Build note, Essay, or Failure
            before committing to a click. */}
        <h3 class="writing-type-heading" id={`type-${type}`}>{TYPE_LABELS[type]}</h3>
        <div class="writing-list">
          {posts.map((post) => (
            <a
              class="writing-row"
              href={href(`posts/${post.id}/`)}
              data-entry-type={post.data.type}
            >
              <span class="writing-row-left">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <span class="writing-row-fact">{readMinutes(post.body)} min read</span>
              </span>
              <span class="writing-row-copy">
                {/* Per-post shared-element name → the article h1 (posts/[...slug]),
                    so the clicked title physically travels into the headline. */}
                <span class="writing-row-title" transition:name={`post-title-${post.id}`} data-decode>{post.data.title}</span>
                <span class="writing-row-description">{post.data.description}</span>
                {post.data.topics.length > 0 && (
                  <span class="writing-row-topics">
                    {post.data.topics.join(' · ')}
                  </span>
                )}
                {origins[post.id] && <span class="writing-row-origin">{origins[post.id]}</span>}
              </span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="writing-section" aria-labelledby="graveyard-title">
    <h2 class="writing-section-title" id="graveyard-title">The graveyard</h2>
    <div class="writing-list">
      <a class="writing-row" href={href('graveyard')}>
        <span class="writing-row-left">
          <span class="writing-row-fact">Failures</span>
        </span>
        <span class="writing-row-copy">
          <span class="writing-row-title" data-decode>Dead projects, kept and owned</span>
          <span class="writing-row-description">
            The work that didn't survive — dated, honoured, and left readable,
            because the dead ends are where the lessons are.
          </span>
        </span>
      </a>
    </div>
  </section>

  <section class="writing-section" aria-labelledby="meta-title">
    <h2 class="writing-section-title" id="meta-title">About this site</h2>
    <div class="writing-list">
      <a class="writing-row" href={href(inspirationHref)}>
        <span class="writing-row-left">
          <span class="writing-row-fact">Essay</span>
        </span>
        <span class="writing-row-copy">
          <span class="writing-row-title" data-decode>Why this site exists</span>
          <span class="writing-row-description">
            Two pictures I could never get out of my head, and why this portfolio
            is built like a star and begins at the end.
          </span>
        </span>
      </a>
      <a class="writing-row" href={href('behind-the-build')}>
        <span class="writing-row-left">
          <span class="writing-row-fact">Build notes</span>
        </span>
        <span class="writing-row-copy">
          <span class="writing-row-title" data-decode>Behind the build</span>
          <span class="writing-row-description">
            How the scroll-scrubbed stellar lifecycle actually works: one engine,
            nine shaders, and the budgets that keep it fast.
          </span>
        </span>
      </a>
    </div>
  </section>
</BaseLayout>
