---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIALS } from '../consts';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
---

<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist."
  noindex={true}
  bodyClass="not-found-page"
>
  <section class="not-found-hero" aria-labelledby="not-found-title">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-title">Nothing here.</h1>
    <p class="not-found-body">
      This page doesn't exist — it may have moved, been removed, or the
      address may have been typed incorrectly.
    </p>
  </section>

  <nav
    id="not-found-recovery"
    class="not-found-recovery"
    aria-label="Recovery links"
  >
    <p class="not-found-recovery-label">Find your way back</p>
    <ul class="not-found-links" role="list">
      <li>
        <a href={href('')}>Home</a>
      </li>
      <li>
        <a href={href('projects')}>Work</a>
      </li>
      <li>
        <a href={href('writing')}>Writing</a>
      </li>
      <li>
        <a href={href('about')}>About</a>
      </li>
      {SOCIALS.email && (
        <li>
          <a href={`mailto:${SOCIALS.email}`}>Contact</a>
        </li>
      )}
    </ul>
  </nav>
</BaseLayout>

<style>
  .not-found-page .wrap {
    padding-bottom: 7rem;
  }

  .not-found-hero,
  .not-found-recovery {
    width: min(68rem, calc(100vw - var(--gutter) - var(--gutter)));
    margin-inline: auto;
  }

  .not-found-hero {
    display: grid;
    gap: 1rem;
    margin-top: clamp(4rem, 11vw, 7.5rem);
    margin-bottom: clamp(2.5rem, 8vw, 5rem);
  }

  .not-found-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-chrome-faint);
  }

  .not-found-hero h1 {
    max-width: 14ch;
    margin: 0;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .not-found-body {
    max-width: 42rem;
    margin: 0;
    color: var(--fg-dim);
    font-size: var(--text-subtitle);
    line-height: 1.58;
    text-wrap: pretty;
  }

  /* Recovery nav */
  .not-found-recovery {
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 5vw, 2.5rem);
  }

  .not-found-recovery-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-chrome-faint);
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .not-found-links li {
    display: flex;
    align-items: center;
  }

  /* Separator between items — a quiet slash mirroring the footer pattern. */
  .not-found-links li + li::before {
    content: '/';
    padding: 0 0.75rem;
    color: var(--fg-chrome-faint);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    aria-hidden: true;
  }

  .not-found-links a {
    color: var(--fg-dim);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.5;
    transition: color 0.16s ease;
  }

  .not-found-links a:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .not-found-hero,
    .not-found-recovery {
      width: min(100%, calc(100vw - 2rem));
    }

    .not-found-hero {
      margin-top: 2.75rem;
    }
  }
</style>
