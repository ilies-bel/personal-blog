---
// Behind the Build — a deliberately demonstrative case study of the hero/article
// WebGL system. It does NOT just describe the engine; it RUNS the engine as its own
// backdrop and seeds inline mini-canvases through the prose, so the page is itself
// an instance of the system it documents.
//
// Architecture choices echoed below:
//   • Astro renders ALL prose server-side — JS disabled still gives a complete read.
//   • Backdrop is the same createScene the home page uses, driven by ARTICLE scroll
//     through ArticleScene (one engine, one number — getStage).
//   • Each shader gets its own SceneFigure pinned to ONE stage, plus a toggleable
//     GLSL excerpt so a developer-jury reader can see the actual source on the page.
//   • A tiny independent FpsMeter island measures live frames-per-second and runs a
//     5s benchmark, surfacing the same DeviceTier the engine uses.
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleScene from '../hero/components/ArticleScene.tsx';
import ArticleHud from '../hero/components/ArticleHud.tsx';
import SceneFigure from '../components/mdx/SceneFigure.tsx';
import FpsMeter from '../components/FpsMeter.tsx';
import RouteEnding from '../components/RouteEnding.astro';
import { SITE_TITLE, SOCIALS } from '../consts';
// The documented-shader catalog (P6) — the SAME array this page renders as its
// gallery, exported from src/lib/shaderCatalog.ts so the "one engine, N
// shaders" prose here AND on /writing derive from SHADERS.length. Adding a row
// to the catalog updates the gallery and every count in the same edit — the
// prose can no longer drift from the gallery it describes.
import { SHADERS } from '../lib/shaderCatalog';
import { numberToWord } from '../lib/contentFormat';
// Generated performance telemetry (P10) — written by scripts/gen-perf-report.mjs
// from the built dist; a stale copy fails CI (gen-perf-report --check).
// NOTE: this import must stay in the top import group — the compiler hoists
// imports, and a mid-file import below multibyte-heavy comment text gets
// sliced with wrong offsets (observed: corrupted frontmatter, build failure).
import perfReport from '../data/perf-report.json';

// GitHub source for the "view full" links. The repo lives at ilies-bel/personal-blog.
const REPO = 'https://github.com/ilies-bel/personal-blog/blob/main';

// Base-safe internal href (the RouteEnding continuation below).
const base = import.meta.env.BASE_URL;
const withHref = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// Derived prose forms of the shader count: "nine" mid-sentence, "Nine" opening one.
const shaderCountWord = numberToWord(SHADERS.length);
const shaderCountWordCapitalized = shaderCountWord.charAt(0).toUpperCase() + shaderCountWord.slice(1);

// Sections the ArticleHud reads. Element ids match — the hud spies on these via
// IntersectionObserver and shows N / total + the live section title in the cockpit.
const SECTIONS = [
  { id: 'architecture', title: 'Architecture' },
  { id: 'gallery', title: 'Live shader gallery' },
  { id: 'performance', title: 'Performance budgets' },
  { id: 'fallbacks', title: 'Fallback ladder' },
  { id: 'decisions', title: 'Design decisions' },
];

// The article scrubs from black hole (stage 0) up through the supernova breakout to
// the held nebula (stage 3.5). The whole lifecycle in one read — the page IS a tour
// of the system, so the journey covers the full built range.
const JOURNEY: readonly [number, number] = [0, 3.5];

// Performance budgets — GENERATED, not hand-written. The table below renders
// src/data/perf-report.json, which scripts/gen-perf-report.mjs measures from the
// built dist (same measurement core as the scripts/check-bundle-budgets.mjs CI
// gate), so the numbers this page claims are the numbers CI enforces — a stale
// report FAILS the build (gen-perf-report --check, ±5%). The hand-entered
// BUDGETS array this replaced claimed "measured on this branch" with no way to
// re-measure it; claims that cannot be generated (field INP and friends) were
// deleted, not hedged — field CWV wait for RUM (see the prose note below).

interface BudgetRow {
  name: string;
  budget: string;
  measured: string;
  note: string;
}

const { bundle, html, rasters, budgets, lighthouse } = perfReport;
const b = (row: { hard: number; target: number }) => `≤ ${row.hard} KiB (target ${row.target})`;

// Lab metrics land only when a Lighthouse CI run exists to back them (the
// gen script folds .lighthouseci results in). CLS and LCP are shown: CLS is
// deterministic (error-gated in CI) and LCP holds even on the software-GL
// runner. Main-thread time (TBT) is deliberately NOT tabled — on a
// software-rendered runner it measures the runner, not the site (the raw
// number stays in perf-report.json and gates warn-level in CI; see
// lighthouserc.cjs). Presenting it here as "measured" would misinform.
const labRoutes = lighthouse ? Object.values(lighthouse.perRoute) : [];
const labHome = lighthouse?.perRoute['/'];
const LAB_ROWS: BudgetRow[] =
  lighthouse && labHome
    ? [
        {
          name: 'CLS (lab, worst route)',
          budget: '≤ 0.02 (CI error)',
          measured: `${Math.max(...labRoutes.map((r) => r.cls))}`,
          note: `Lighthouse ${lighthouse.measuredAt}, ${labRoutes.length} routes (${lighthouse.environment} runner). Fixed-footprint canvas host + dimensioned images.`,
        },
        {
          name: 'LCP (lab, home)',
          budget: '≤ 2.0 s (CI warn)',
          measured: labHome.lcpMs >= 0 ? `${(labHome.lcpMs / 1000).toFixed(2)} s` : '—',
          note: `Lighthouse ${lighthouse.measuredAt}, throttled mobile profile on a software-rendered ${lighthouse.environment} runner — an upper bound: the loader paints as server HTML before any engine byte arrives.`,
        },
      ]
    : [];

const BUDGETS: BudgetRow[] = [
  {
    name: 'Hero engine graph JS (gz)',
    budget: b(budgets.js.heroGraphGzipKiB),
    measured: `${bundle.heroGraphGzipKiB} KiB`,
    note: 'three-core + three-post + the createScene chunk + the warmThree facade; dynamically imported, so it never blocks first paint.',
  },
  {
    name: 'Home pre-engine JS (gz)',
    budget: b(budgets.js.preHeroRouteGzipKiB),
    measured: `${bundle.preHeroGzipKiB} KiB`,
    note: 'Everything / requests before the engine import fires: island runtime, hero shell, HUD nav, loader controls.',
  },
  {
    name: 'Reading-route JS (gz, worst route)',
    budget: b(budgets.js.readingRouteGzipKiB),
    measured: `${bundle.readingRouteMaxGzipKiB} KiB`,
    note: 'Reading routes ship zero three.js (e2e-asserted); this caps everything else they load.',
  },
  {
    name: 'HTML per page (gz, worst page)',
    budget: b(budgets.html.perPageGzipKiB),
    measured: `${html.maxPageGzipKiB} KiB`,
    note: 'Stylesheets are inlined, so this one number also caps CSS growth — grain data-URIs included.',
  },
  {
    name: 'Largest shipped raster',
    budget: `≤ ${budgets.rasters.hardKiB} KiB (target ${budgets.rasters.targetKiB})`,
    measured: `${rasters.largestKiB} KiB (of ${rasters.count})`,
    note: 'Every content raster goes through astro:assets; the CI gate has no grandfather list.',
  },
  ...LAB_ROWS,
];

// Fallback ladder — same beat (the held nebula at stage 3.42), four ways the system
// can present it as capability degrades. Built as four flat cards so the page reads
// the same regardless of WebGL state: a static card never depends on the live engine.
interface FallbackRow {
  label: string;
  state: string;
  detail: string;
}
const FALLBACKS: readonly FallbackRow[] = [
  {
    label: 'High tier',
    state: 'The full ~1.2M-point cloud, post chain on, native DPR clamp.',
    detail: 'What you are reading this paragraph through — the engine running unhindered.',
  },
  {
    label: 'Low tier',
    state: '16k–24k points, no bloom, DPR 0.6×, capped at ~30 fps.',
    detail: 'Any mobile / weak GPU / ≤ 4 cores / ≤ 4 GB / no WebGL2 demotes here automatically.',
  },
  {
    label: 'Reduced motion',
    state: 'No live engine; CSS-painted poster of the same beat.',
    detail: 'Respects the reduced-motion preference. The article prose is unchanged — only the backdrop swaps.',
  },
  {
    label: 'No WebGL',
    state: 'A flat dark room with the same dim wash CSS already provides.',
    detail: 'A typed WebGLUnavailableError is caught at mount; the article stays fully readable.',
  },
];
---

<BaseLayout
  title="Behind the Build"
  description={`How ${SITE_TITLE}'s scroll-scrubbed stellar lifecycle is built: one engine, ${shaderCountWord} shaders, and the budgets that keep it fast.`}
  type="article"
  bodyClass="article-page behind-the-build"
>
  {/* The same hero engine the home page uses, driven by ARTICLE scroll. The page
     reads in the same room with the same motion grammar; reading it scrubs the
     lifecycle from black hole to nebula. Reduced motion + no-WebGL fall back
     gracefully (see ArticleScene). */}
  <ArticleScene client:only="react" journey={JOURNEY} />

  {/* Reading-frame HUD — section index, title, and the celestial-beat name driven
     by the live stage. Same component the scene-journey articles use. */}
  <ArticleHud client:only="react" sections={SECTIONS} />

  <article class="prose" data-scene-journey>
    <header class="article-header">
      <p class="article-kicker">Build notes</p>
      <h1>Behind the Build</h1>
      <p class="article-description">
        How the scroll-scrubbed stellar lifecycle on the home page actually works:
        one engine, {shaderCountWord} shaders, and the budgets that keep it fast enough to ship.
      </p>
    </header>

    {/* ============================================================
        SECTION 1 — Architecture: one engine, one number.
        ============================================================ */}
    <section aria-labelledby="architecture">
      <h2 id="architecture">Architecture — one engine, one number</h2>
      <p>
        Every visible piece of the hero — the cloud, the shadow, the photon ring,
        the supernova flash, the yellow star, the nebula, the lonely pale-blue dot —
        is rendered by a single instance of <code>createScene</code> (see
        <code>src/hero/scene/createScene.ts</code>). That engine takes one input
        each frame: a number called <code>getStage</code>, somewhere in
        <code>[0, 3.5]</code>. Everything downstream is a pure function of that
        number.
      </p>
      <p>
        Where the number comes from is the only thing the rest of the codebase has
        to know. On the home page it is the scroll position routed through the
        band-walker in <code>sceneTable.ts</code>. On an article like this one it
        is the article scroll mapped into an authored window
        (<code>journey</code>). On an inline figure it is pinned to a constant. The
        engine cannot tell the difference, and there is exactly one engine to
        debug.
      </p>
      <SceneFigure
        client:visible
        stage={1.6}
        caption="Mid-collapse: same engine, getStage pinned to ~1.6 (supernova → red-giant grow)."
      />
      <p>
        The walker logic lives in <code>src/hero/sceneTable.ts</code> as a flat
        <code>SEGMENTS</code> table. Each row is a timed span with a relative
        weight, start/end stage values, and an easing function. The prefix-sum of
        the weights reproduces the original breakpoints exactly. Adding a beat
        means adding a row; the engine never changes.
      </p>
    </section>

    {/* ============================================================
        SECTION 2 — Live shader gallery: nine small canvases.
        ============================================================ */}
    <section aria-labelledby="gallery">
      <h2 id="gallery">Live shader gallery</h2>
      <p>
        {shaderCountWordCapitalized} GLSL programs from <code>src/hero/shaders/</code>. Each panel below pins
        the engine to the stage that best showcases the shader, with the actual
        source toggleable underneath. The canvases are independent
        <code>createScene</code> instances mounted on intersection — the engine
        chunk only downloads when the figure scrolls into view.
      </p>
      <div class="btb-shader-gallery">
        {SHADERS.map((shader) => (
          <div class="btb-shader" id={`shader-${shader.name}`}>
            <h3 class="btb-shader-name">
              <code>{shader.name}</code>
              <span class="btb-shader-file" aria-hidden="true">{shader.file}</span>
            </h3>
            <SceneFigure
              client:visible
              stage={shader.stage}
              caption={shader.caption}
            />
            <p class="btb-shader-desc">{shader.description}</p>
            <details class="btb-shader-source">
              {/* The "full source" link must NOT live inside <summary> — an
                  <a> nested in an interactive summary is a serious axe
                  violation (nested-interactive) and unreachable by keyboard.
                  The note stays on the summary line; the link moves into the
                  revealed body, above the excerpt. */}
              <summary>
                View GLSL
                {shader.excerptIsHead && shader.excerptLines && shader.totalLines && (
                  <span class="btb-shader-source-note">
                    {' '}— first {shader.excerptLines} of {shader.totalLines} lines
                  </span>
                )}
              </summary>
              {shader.excerptIsHead && shader.excerptLines && shader.totalLines && (
                <p class="btb-shader-source-note btb-shader-source-link">
                  <a href={`${REPO}/${shader.file}`} rel="noopener noreferrer">
                    Full source ({shader.totalLines} lines) on GitHub
                  </a>
                </p>
              )}
              <pre class="btb-shader-code"><code>{shader.excerpt}</code></pre>
            </details>
          </div>
        ))}
      </div>
    </section>

    {/* ============================================================
        SECTION 3 — Performance budgets: measured numbers + live meter.
        ============================================================ */}
    <section aria-labelledby="performance">
      <h2 id="performance">Performance budgets</h2>
      <p>
        Budgets the site is built against, with the measured value next to each.
        Nothing in this table is typed by hand: CI enforces the same numbers
        (<code>scripts/check-bundle-budgets.mjs</code>), and a build whose output
        drifts from what this page claims fails
        (<code>gen-perf-report.mjs --check</code>, ±5%).
      </p>
      <p class="btb-provenance">
        Generated {perfReport.generatedAt} at <code>{perfReport.commit}</code> by
        <code>scripts/gen-perf-report.mjs</code> — regenerated per release, not
        hand-written.
      </p>
      {/* Scroll container: the nowrap numeric columns can outgrow narrow
          viewports; the table scrolls locally instead of widening the document
          (which body{overflow-x:hidden} would clip into amputated columns). */}
      <div class="btb-table-scroll" tabindex="0" role="region" aria-label="Performance budgets table">
      <table class="btb-budget-table">
        <thead>
          <tr>
            <th scope="col">Metric</th>
            <th scope="col">Budget</th>
            <th scope="col">Last measured</th>
            <th scope="col">Note</th>
          </tr>
        </thead>
        <tbody>
          {BUDGETS.map((row) => (
            <tr>
              <th scope="row">{row.name}</th>
              <td>{row.budget}</td>
              <td>{row.measured}</td>
              <td>{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <p>
        Field Core Web Vitals (real-visitor INP, LCP, CLS) are deliberately absent:
        they need RUM, which this site does not run yet — the wiring is documented
        and waiting rather than the numbers being guessed. Main-thread lab time
        (TBT) is also collected per release but not tabled: the available runners
        render WebGL in software, so that number describes the runner, not the
        site — it lives in <code>perf-report.json</code> and gates as a CI warning
        until real rendering hardware joins the pipeline.
      </p>
      <p>
        And what your machine is doing right now — independent of the engine, just
        the browser's own rAF clock:
      </p>
      <FpsMeter client:visible />
    </section>

    {/* ============================================================
        SECTION 4 — Fallback ladder: graceful degradation, side by side.
        ============================================================ */}
    <section aria-labelledby="fallbacks">
      <h2 id="fallbacks">Fallback ladder</h2>
      <p>
        The same beat at four capability levels. The article only ever loses the
        backdrop in the bottom two rows — the prose, the HUD, and the chrome stay
        unchanged. None of these rows depend on the live engine to render: each is
        a static card describing what the system would do.
      </p>
      <ul class="btb-fallback-ladder">
        {FALLBACKS.map((row) => (
          <li class={`btb-fallback btb-fallback--${row.label.toLowerCase().replace(/\s+/g, '-')}`}>
            <div class="btb-fallback-poster" aria-hidden="true"></div>
            <div class="btb-fallback-body">
              <p class="btb-fallback-label">{row.label}</p>
              <p class="btb-fallback-state">{row.state}</p>
              <p class="btb-fallback-detail">{row.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* ============================================================
        SECTION 5 — Design decisions: short prose, no diagrams.
        ============================================================ */}
    <section aria-labelledby="decisions">
      <h2 id="decisions">Design decisions</h2>
      <p>
        <strong>Why DPR is clamped.</strong> The cloud is fragment-bound. Doubling
        DPR quadruples the work the fragment shader does without changing what the
        eye reads. <code>tuneRenderPixelRatio</code> caps the ratio at 1.85× on
        capable laptops and 0.6× on low-tier devices, and the browser upscales.
      </p>
      <p>
        <strong>Why the low tier caps at ~30 fps.</strong> A mobile GPU under CPU
        throttle cannot hold 60 fps with the cloud lit. Targeting 30 fps lets the
        engine spend its frame budget on getting each frame correct instead of
        thrashing toward a number it could never reach.
      </p>
      <p>
        <strong>Why text is server-rendered.</strong> Astro renders every paragraph
        on this page to HTML at build time. With JavaScript disabled the page is
        still complete: the article reads top to bottom, the headings still anchor,
        the GLSL excerpts are still inspectable. The engine is an enhancement, not
        a prerequisite.
      </p>
      <p>
        <strong>Why shaders compile behind the dive veil.</strong> A fresh WebGL
        program can take 50–200&nbsp;ms to link on first use; the engine triggers
        that compile while the page is already under a white plunge overlay, so the
        cost lands in a frame the visitor cannot see.
      </p>
      <p>
        Source for everything on this page lives at
        <a href={SOCIALS.github} rel="noopener noreferrer">github.com/ilies-bel</a>.
      </p>
    </section>

    {/* ROUTE ENDING (P9) — the anatomy lesson hands off to Work: the engine is
        the demonstration, the shipped tools are the point. Inline width so it
        inherits the prose column. */}
    <RouteEnding
      eyebrow="The engine is the demonstration"
      title="See what ships beside it"
      note="The same budgets and honesty, pointed at product work — the projects that held."
      href={withHref('projects')}
    />
  </article>
</BaseLayout>
