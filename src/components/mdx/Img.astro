---
// Img — the MDX prose-column image. Wraps astro:assets <Picture> so every
// content raster in a post ships through the optimizing pipeline instead of
// as a raw public/ file:
//
//   - AVIF + WebP <source> sets with a WebP fallback <img> (never the original
//     jpg/png — a png screenshot fallback would undo the whole size win),
//   - intrinsic width/height attributes (astro:assets derives them from the
//     import) so the prose column never reflows while an image streams in,
//   - a srcset sized for the reading measure: .prose is max-width 680px
//     (prose.css), so 1x + 2x of the column is all any device ever paints.
//
// Usage (frontmatter-level import in the .mdx):
//   import Img from '../../components/mdx/Img.astro';
//   import voyager from '../../assets/inspirations/voyager-golden-record.jpg';
//   <Img src={voyager} alt="…" />
//
// `widths` defaults to the prose column at 1x/2x, clamped to the source width
// so astro:assets never upscales. `quality` defaults to 70 (crisp for drawings
// and screenshots); photographic sources that need a tighter budget pass their
// own (the Golden Record ships at 55 to land ≤150KB — see the post).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  quality?: number;
}

const PROSE_MAX = 680; // .prose max-width (prose.css) — the rendered ceiling

// DO NOT read properties off `src` directly. In a static build the imported
// metadata is a tracking Proxy: ANY user-land property access marks the
// original file as "referenced outside of image processing", which makes
// Astro ship the untransformed source into dist/_astro/ (the raw 4MB Golden
// Record jpg, exactly what this component exists to eliminate — and what
// check-asset-sizes.mjs would fail on). `clone` is the proxy's untracked
// escape hatch (a plain structuredClone of the metadata; getImage itself
// dereferences through it); plain-object metadata (dev) has no `clone` and
// falls through to src itself, where reads track nothing.
const { src, alt, quality = 70 } = Astro.props;
const meta = (src as ImageMetadata & { clone?: ImageMetadata }).clone ?? src;

const {
  widths = [...new Set([Math.min(PROSE_MAX, meta.width), Math.min(PROSE_MAX * 2, meta.width)])],
  sizes = `(max-width: ${PROSE_MAX + 32}px) 100vw, ${PROSE_MAX}px`,
} = Astro.props;

// Cap the fallback <img src> at the largest srcset rung. Without `width`,
// astro:assets writes the FULL-RESOLUTION transform into src (the 2215px
// Golden Record fallback weighed 294KB) — no srcset-capable browser fetches
// it, but it ships in dist and busts the per-raster budget for nothing.
const fallbackWidth = Math.max(...widths);
---

<Picture
  class="mdx-img"
  src={src}
  alt={alt}
  width={fallbackWidth}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  quality={quality}
  loading="lazy"
  decoding="async"
/>

<style is:global>
  /* Replaces the inline style the raw <img> tags used to carry. Global on
     purpose: <Picture> renders the img outside this component's scope hash. */
  .prose img.mdx-img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid oklch(0.32 0.022 252);
  }
</style>
