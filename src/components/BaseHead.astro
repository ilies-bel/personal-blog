---
// SEO-critical <head>. Everything here is rendered into the STATIC HTML at
// build time so search crawlers see complete, correct metadata without
// executing any of the client-side interrogation JavaScript.
import { SITE_TITLE, SITE_DESCRIPTION, DEFAULT_OG_IMAGE, SITE_LANG } from '../consts';
// Import the above-the-fold faces so Vite resolves their final fingerprinted,
// base-prefixed URLs. One preload: Space Grotesk latin — it carries the
// identity name, the manifesto big line AND body copy, all above the fold.
// latin-ext/mono aren't needed for first paint, and over-preloading would
// delay more important resources.
import spaceGroteskLatin from '../styles/fonts/space-grotesk-latin.woff2';

interface Props {
  title: string;
  description?: string;
  // Path of the OG image relative to /public, or an absolute URL.
  ogImage?: string;
  // 'website' for index/listing pages, 'article' for posts.
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

// Canonical URL resolved against `site` + `base` from astro.config.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolve OG image to an absolute URL (required by Open Graph).
const ogImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(`${import.meta.env.BASE_URL}/${ogImage}`.replace(/\/+/g, '/'), Astro.site).href;

const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;

// JSON-LD structured data: WebSite for general pages, BlogPosting for articles.
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImageURL,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: canonicalURL.href,
      };
---

<!-- Charset & viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Preload the primary face (Space Grotesk, latin) to minimize the FOUT swap
     on the fixed hero overlay text. crossorigin is required on font preloads
     even same-origin (fonts always fetch in CORS mode) to avoid a double-fetch. -->
<link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow" />

<!-- Icons -->
<!-- SVG first: modern browsers use it and it self-inverts via its own @media rule. -->
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
<!-- 32×32 raster: light/dark variants served by OS color-scheme. -->
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href={`${import.meta.env.BASE_URL}/favicon-32x32.png`} />
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)"  href={`${import.meta.env.BASE_URL}/favicon-32x32-dark.png`} />
<!-- 16×16 raster: light/dark variants. -->
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: light)" href={`${import.meta.env.BASE_URL}/favicon-16x16.png`} />
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)"  href={`${import.meta.env.BASE_URL}/favicon-16x16-dark.png`} />
<!-- .ico last: universal fallback for browsers that ignore the above (light default). -->
<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} sizes="any" />
<!-- Apple touch icon: light/dark variants (iOS, opaque background required). -->
<link rel="apple-touch-icon" sizes="180x180" media="(prefers-color-scheme: light)" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`} />
<link rel="apple-touch-icon" sizes="180x180" media="(prefers-color-scheme: dark)"  href={`${import.meta.env.BASE_URL}/apple-touch-icon-dark.png`} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LANG} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Theme color + scheme: the blue-hour-terminal dark room (--bg). The site is
     dark everywhere, so the browser chrome is told to match the room. -->
<meta name="theme-color" content="#0a1017" />
<meta name="color-scheme" content="dark" />
