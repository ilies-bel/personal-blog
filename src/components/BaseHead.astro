---
// SEO-critical <head>. Everything here is rendered into the STATIC HTML at
// build time so search crawlers see complete, correct metadata without
// executing any of the client-side interrogation JavaScript.
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  SITE_LANG,
  AUTHOR_NAME,
  BRAND_ROLE,
  SOCIALS,
  withBase,
} from '../consts';
// Import the above-the-fold faces so Vite resolves their final fingerprinted,
// base-prefixed URLs (?url guarantees the href can never drift from the URL
// the bundled CSS references). Two preloads:
//   • Space Grotesk latin — identity name, manifesto big line AND body copy.
//   • IBM Plex Mono latin — wordmark + role line in the fixed chrome/HUD.
// latin-ext and the serif italic aren't needed for first paint (below-fold /
// rare glyphs), and over-preloading would delay more important resources.
import spaceGroteskLatin from '../styles/fonts/space-grotesk-latin.woff2?url';
import ibmPlexMonoLatin from '../styles/fonts/ibm-plex-mono-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  // Path of the OG image relative to /public, or an absolute URL.
  ogImage?: string;
  // 'website' for index/listing pages, 'article' for posts.
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  // Extra schema.org nodes a page wants to append to the JSON-LD @graph
  // (e.g. a project page adding CreativeWork/SoftwareSourceCode).
  structuredData?: Record<string, unknown>[];
  // Article author names (defaults to the site owner). Co-authors listed
  // in post frontmatter flow through here into the BlogPosting author array.
  authors?: string[];
  // Error/utility pages (404): noindex + no canonical — the page is served at
  // arbitrary URLs, so a canonical to /404/ would point at a non-route.
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData = [],
  authors = [AUTHOR_NAME],
  noindex = false,
} = Astro.props;

// Canonical URL resolved against `site` + `base` from astro.config.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolve OG image to an absolute URL (required by Open Graph).
const ogImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(`${import.meta.env.BASE_URL}/${ogImage}`.replace(/\/+/g, '/'), Astro.site).href;

const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;

// JSON-LD structured data — one @graph carrying every node so a page has a
// single, complete machine-readable identity: the site owner (Person), the
// WebSite, a BreadcrumbList on inner routes, BlogPosting on articles, plus
// whatever page-specific nodes arrive via the structuredData prop.
const siteURL = Astro.site ? new URL('/', Astro.site).href : canonicalURL.href;
const personId = `${siteURL}#person`;

const personLd = {
  '@type': 'Person',
  '@id': personId,
  name: AUTHOR_NAME,
  jobTitle: BRAND_ROLE,
  url: siteURL,
  email: `mailto:${SOCIALS.email}`,
  sameAs: [SOCIALS.github, SOCIALS.twitter].filter(Boolean),
};

const websiteLd = {
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: siteURL,
  author: { '@id': personId },
  publisher: { '@id': personId },
};

// Breadcrumbs for inner routes: Home → (section) → page. The /posts/* URLs
// belong editorially to the /writing hub, so that segment maps to Writing.
const SEGMENT_LABELS: Record<string, { name: string; href: string }> = {
  posts: { name: 'Writing', href: '/writing' },
  writing: { name: 'Writing', href: '/writing' },
  projects: { name: 'Work', href: '/projects' },
  graveyard: { name: 'Graveyard', href: '/graveyard' },
  about: { name: 'About', href: '/about' },
  contact: { name: 'Contact', href: '/contact' },
  'behind-the-build': { name: 'Behind the Build', href: '/behind-the-build' },
};

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbLd =
  !noindex && pathSegments.length > 0 && Astro.site
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
          ...pathSegments.map((segment, i) => {
            const isLast = i === pathSegments.length - 1;
            const mapped = SEGMENT_LABELS[segment];
            const name = isLast ? title : (mapped?.name ?? segment);
            const item = isLast
              ? canonicalURL.href
              : new URL(mapped?.href ?? `/${pathSegments.slice(0, i + 1).join('/')}`, Astro.site).href;
            return { '@type': 'ListItem', position: i + 2, name, item };
          }),
        ],
      }
    : null;

const articleLd =
  type === 'article'
    ? {
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImageURL,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
        author: authors.map((name) =>
          name === AUTHOR_NAME ? { '@id': personId } : { '@type': 'Person', name },
        ),
        publisher: { '@id': personId },
      }
    : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personLd, websiteLd, breadcrumbLd, articleLd, ...structuredData].filter(Boolean),
};
---

<!-- Charset & viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Defense-in-depth CSP, baked into the HTML so it also protects requests that
     bypass the Cloudflare edge (e.g. hitting the GitHub Pages origin directly).
     The FULL policy lives in the Cloudflare Response Header Transform rule —
     exact value generated by scripts/gen-csp-hashes.mjs into
     docs/SECURITY-HEADERS.md. This meta tag carries only the subset that is
     (a) legal in a meta tag and (b) stable across builds:
       • NO script-src / default-src — the inline-script sha256 hashes (the
         pre-paint script below + Astro's island/router runtime scripts) only
         exist after the build bundles and minifies, so this component cannot
         know them at render time; hardcoding them would break on any Astro
         upgrade, and a hash-less default-src 'self' would block the site's own
         inline scripts. Script-src enforcement therefore lives ONLY in the
         edge header, which the gen-csp-hashes --check CI gate keeps current.
       • NO frame-ancestors — ignored in meta CSP by spec (header-only).
       • style-src keeps 'unsafe-inline' deliberately: build.inlineStylesheets
         'always' ships each page's CSS as inline <style>, and React islands
         set style attributes; hashing the elements would disable
         'unsafe-inline' and break the attribute styles.
       • img-src allows data: for the inline SVG grain/placeholder data-URIs.
     Directives omitted here (script-src, worker-src, …) simply fall through to
     "allow" in this meta layer — the edge header closes them. -->
<meta
  http-equiv="Content-Security-Policy"
  content="object-src 'none'; base-uri 'self'; form-action 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; upgrade-insecure-requests"
/>

<!-- Pre-paint environment flags, set before first paint so CSS can branch on
     them with zero flash:
       • html.js          — JavaScript is running. The immersive layers (intro
                            loader, 1800svh scroll track) are gated on this class
                            so a no-JS visitor gets the static edition instead of
                            an opaque loader that never lifts.
       • html[data-motion] — resolved motion preference ('full' | 'reduced'):
                            manual override (the 'bh:reduced-motion' localStorage
                            key the hero's corner toggle writes) if set, else the
                            OS preference. The single source of truth every
                            JS/CSS consumer reads (see src/lib/motion.ts, which
                            owns the key + keeps the attribute in sync with OS
                            changes at runtime — keep the literals aligned).
     Must stay is:inline (pre-paint, unbundled) and tiny. -->
<script is:inline>
  document.documentElement.classList.add('js');
  (function () {
    var motion = null;
    try {
      var stored = window.localStorage.getItem('bh:reduced-motion');
      if (stored === 'true') motion = 'reduced';
      else if (stored === 'false') motion = 'full';
    } catch (e) {
      /* private mode — fall through to the OS preference */
    }
    if (!motion) {
      motion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'reduced'
        : 'full';
    }
    document.documentElement.dataset.motion = motion;
  })();
</script>

<!-- Preload the two above-the-fold faces (Space Grotesk latin for display/body,
     IBM Plex Mono latin for the wordmark + role line) to minimize the FOUT swap
     on the fixed hero overlay text. crossorigin is required on font preloads
     even same-origin (fonts always fetch in CORS mode) to avoid a double-fetch. -->
<link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={ibmPlexMonoLatin} as="font" type="font/woff2" crossorigin />

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonicalURL} />}
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

<!-- Icons. hrefs go through withBase() — naive `${BASE_URL}/x` concatenation
     with base '/' produced protocol-relative '//x' URLs that browsers resolved
     against a bogus host, so every icon 404'd. -->
<!-- SVG first: modern browsers use it and it self-inverts via its own @media rule. -->
<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
<!-- 32×32 raster: light/dark variants served by OS color-scheme. -->
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href={withBase('favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)"  href={withBase('favicon-32x32-dark.png')} />
<!-- 16×16 raster: light/dark variants. -->
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: light)" href={withBase('favicon-16x16.png')} />
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)"  href={withBase('favicon-16x16-dark.png')} />
<!-- .ico last: universal fallback for browsers that ignore the above (light default). -->
<link rel="icon" href={withBase('favicon.ico')} sizes="any" />
<!-- Apple touch icon: light/dark variants (iOS, opaque background required). -->
<link rel="apple-touch-icon" sizes="180x180" media="(prefers-color-scheme: light)" href={withBase('apple-touch-icon.png')} />
<link rel="apple-touch-icon" sizes="180x180" media="(prefers-color-scheme: dark)"  href={withBase('apple-touch-icon-dark.png')} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonicalURL} />}
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LANG} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Theme color + scheme: the blue-hour-terminal dark room (--bg). The site is
     dark everywhere, so the browser chrome is told to match the room. -->
<meta name="theme-color" content="#0a1017" />
<meta name="color-scheme" content="dark" />
