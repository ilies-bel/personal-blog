---
// SEO-critical <head>. Everything here is rendered into the STATIC HTML at
// build time so search crawlers see complete, correct metadata without
// executing any of the client-side interrogation JavaScript.
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  SITE_OG_LOCALE,
  SITE_OWNER,
} from '../consts';
// Import the above-the-fold faces so Vite resolves their final fingerprinted,
// base-prefixed URLs (?url guarantees the href can never drift from the URL
// the bundled CSS references). Two preloads:
//   • Space Grotesk latin — identity name, manifesto big line AND body copy.
//   • IBM Plex Mono latin — wordmark + role line in the fixed chrome/HUD.
// latin-ext and the serif italic aren't needed for first paint (below-fold /
// rare glyphs), and over-preloading would delay more important resources.
import spaceGroteskLatin from '../styles/fonts/space-grotesk-latin.woff2?url';
import ibmPlexMonoLatin from '../styles/fonts/ibm-plex-mono-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  // Path of the OG image relative to /public, or an absolute URL.
  ogImage?: string;
  // OG image dimensions in pixels (defaults: 1200×630, the standard card size).
  // Pass explicit values when a page uses a non-standard image.
  ogImageWidth?: number;
  ogImageHeight?: number;
  // Alt text for the OG / Twitter card image (used by screen readers and
  // unfurlers that surface image descriptions).
  ogImageAlt?: string;
  // 'website' for index/listing pages, 'article' for posts.
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  // When true, emits `noindex, nofollow` so crawlers skip this page (e.g. 404).
  noindex?: boolean;
  // Emit a Person schema block (home, about) alongside the default page schema.
  withPerson?: boolean;
  // Emit a CreativeWork schema block (projects page).
  withCreativeWork?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  withPerson = false,
  withCreativeWork = false,
} = Astro.props;

// Canonical URL resolved against `site` + `base` from astro.config.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Normalize BASE_URL: strip trailing slash so `${base}/path` never produces
// `//path` (a protocol-relative URL) when Astro is configured with base: '/'.
// Example: BASE_URL='/' → base='', so `${base}/favicon.svg` = '/favicon.svg'. ✓
// Example: BASE_URL='/personal-blog/' → base='/personal-blog'. ✓
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Resolve OG image to an absolute URL (required by Open Graph).
const ogImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(`${base}/${ogImage}`, Astro.site).href;

const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;

// The site owner as a schema.org Person — reused as the author in BlogPosting
// and as a standalone Person node on the home/about pages.
// The canonical profile URL is the about page on the live site.
const personNode = {
  '@type': 'Person',
  name: SITE_OWNER.name,
  jobTitle: SITE_OWNER.jobTitle,
  url: new URL('/about/', Astro.site).href,
  sameAs: [...SITE_OWNER.sameAs],
};

// JSON-LD structured data: WebSite for general pages, BlogPosting for articles.
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImageURL,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        author: personNode,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: canonicalURL.href,
      };

// Optional Person schema (home + about pages).
const personJsonLd = withPerson
  ? { '@context': 'https://schema.org', ...personNode }
  : null;

// Optional CreativeWork schema (projects page).
const creativeWorkJsonLd = withCreativeWork
  ? {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: fullTitle,
      description,
      url: canonicalURL.href,
      author: personNode,
    }
  : null;
---

<!-- Charset & viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Preload the two above-the-fold faces (Space Grotesk latin for display/body,
     IBM Plex Mono latin for the wordmark + role line) to minimize the FOUT swap
     on the fixed hero overlay text. crossorigin is required on font preloads
     even same-origin (fonts always fetch in CORS mode) to avoid a double-fetch. -->
<link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={ibmPlexMonoLatin} as="font" type="font/woff2" crossorigin />

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

<!-- Icons -->
<!-- SVG first: modern browsers use it and it self-inverts via its own @media rule. -->
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<!-- 32×32 raster: light/dark variants served by OS color-scheme. -->
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href={`${base}/favicon-32x32.png`} />
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)"  href={`${base}/favicon-32x32-dark.png`} />
<!-- 16×16 raster: light/dark variants. -->
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: light)" href={`${base}/favicon-16x16.png`} />
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)"  href={`${base}/favicon-16x16-dark.png`} />
<!-- .ico last: universal fallback for browsers that ignore the above (light default). -->
<link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
<!-- Apple touch icon: light/dark variants (iOS, opaque background required). -->
<link rel="apple-touch-icon" sizes="180x180" media="(prefers-color-scheme: light)" href={`${base}/apple-touch-icon.png`} />
<link rel="apple-touch-icon" sizes="180x180" media="(prefers-color-scheme: dark)"  href={`${base}/apple-touch-icon-dark.png`} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_OG_LOCALE} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{personJsonLd && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
{creativeWorkJsonLd && <script type="application/ld+json" set:html={JSON.stringify(creativeWorkJsonLd)} />}

<!-- Theme color + scheme: the blue-hour-terminal dark room (--bg). The site is
     dark everywhere, so the browser chrome is told to match the room. -->
<meta name="theme-color" content="#0a1017" />
<meta name="color-scheme" content="dark" />
