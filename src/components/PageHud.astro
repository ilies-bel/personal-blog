---
// PageHud — the hero cockpit's side instrument, generalized for the list pages
// (Writing, Projects). The scene-journey articles and the graveyard already fly
// with this exact gauge (ArticleHud / GraveyardHud, React, scene-event driven);
// this is the same instrument in static form for pages whose backdrop is a
// frozen frame: the identical .article-hud-* classes (article.css owns the
// look, including the mobile bottom-bar variant), a scroll-progress fill, and a
// scroll-spied readout naming the entry currently in view.
//
// Wiring lives in src/scripts/pageHud.ts (one bound listener set, re-inits per
// ClientRouter swap). Spy targets are the elements matching `spy`, each
// carrying its display name in data-hud-title.
interface Props {
  /** Top mono line — the page's designation, e.g. 'SECTION 02 / 05'. */
  index: string;
  /** Quiet bottom line — the page name + count, e.g. 'WRITING · 4 NOTES'. */
  beat: string;
  /** CSS selector for the scroll-spy targets (elements with data-hud-title). */
  spy?: string;
}
const { index, beat, spy } = Astro.props;
---

<aside class="article-hud page-hud" aria-label="Page progress" data-spy={spy}>
  <div class="article-hud-rail" aria-hidden="true" style="--scene-progress: 0">
    <span class="article-hud-rail-fill"></span>
  </div>
  <div class="article-hud-readout">
    <span class="article-hud-index" aria-hidden="true">{index}</span>
    <span class="article-hud-section page-hud-section"></span>
    <span class="article-hud-beat" aria-hidden="true">{beat}</span>
  </div>
</aside>

<script>
  import '../scripts/pageHud';
</script>
