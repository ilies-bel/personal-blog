---
// Mars agent task topology — the hand-authored inline SVG diagram that stands in
// for the (private) live topology view on /projects. Extracted from
// projects.astro in P6 so the projects page is pure data rendering; the diagram
// is declared in mars.mdx frontmatter (`media.kind: 'diagram'`) and resolved
// through the DIAGRAMS registry in src/pages/projects.astro.
//
// Same border/radius/background as .projects-screenshot so the two project
// figures share one optical container. Palette is the sitewide mono-gold +
// graphite — no parallel colour system; every fill/stroke pulls from tokens.
---

<svg
  class="projects-topology"
  viewBox="0 0 800 540"
  role="img"
  aria-labelledby="mars-topology-title mars-topology-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="mars-topology-title">Mars agent task topology</title>
  <desc id="mars-topology-desc">A directed graph of thirteen agent tasks for the goal "feature/auth-v2": three planning tasks resolved as merged, two integration tasks merged or coding, a failed accessibility task that triggered a retry now coding, downstream verify and queued tasks, all converging on a final queued merge step. Nodes are colour-coded by lifecycle state (queued, coding, verify, merged, failed) and edges are blocker dependencies.</desc>

  <!-- Header band -->
  <text x="32" y="32" class="projects-topology__kicker">AGENT TASK TOPOLOGY</text>
  <text x="768" y="32" text-anchor="end" class="projects-topology__kicker">RUN #214 · 13 TASKS · 1 RECOVERY</text>
  <line x1="32" y1="46" x2="768" y2="46" class="projects-topology__rule" />

  <!-- Edges (blocker dependencies). Drawn first so nodes sit on top.
       Each path is a vertical cubic Bezier from parent-bottom to child-top. -->
  <g class="projects-topology__edges" fill="none">
    <!-- GOAL → planning -->
    <path d="M400,76 C400,96 160,96 160,116" class="projects-topology__edge" />
    <path d="M400,76 C400,96 400,96 400,116" class="projects-topology__edge" />
    <path d="M400,76 C400,96 640,96 640,116" class="projects-topology__edge" />
    <!-- planning → integration -->
    <path d="M160,162 C160,186 280,186 280,206" class="projects-topology__edge" />
    <path d="M400,162 C400,186 280,186 280,206" class="projects-topology__edge" />
    <path d="M400,162 C400,186 520,186 520,206" class="projects-topology__edge" />
    <path d="M640,162 C640,186 520,186 520,206" class="projects-topology__edge" />
    <!-- integration → build -->
    <path d="M280,252 C280,276 160,276 160,296" class="projects-topology__edge" />
    <path d="M280,252 C280,276 400,276 400,296" class="projects-topology__edge" />
    <path d="M520,252 C520,276 400,276 400,296" class="projects-topology__edge" />
    <path d="M520,252 C520,276 640,276 640,296" class="projects-topology__edge" />
    <!-- failed → retry (recovery edge) -->
    <path d="M400,342 C400,362 400,362 400,382" class="projects-topology__edge projects-topology__edge--recovery" />
    <!-- build → verify -->
    <path d="M160,342 C160,392 280,392 280,432" class="projects-topology__edge" />
    <path d="M400,428 C400,442 280,442 280,432" class="projects-topology__edge" />
    <path d="M400,428 C400,442 520,442 520,432" class="projects-topology__edge" />
    <path d="M640,342 C640,392 520,392 520,432" class="projects-topology__edge" />
    <!-- verify → merge -->
    <path d="M280,478 C280,498 400,498 400,518" class="projects-topology__edge" />
    <path d="M520,478 C520,498 400,498 400,518" class="projects-topology__edge" />
  </g>

  <!-- Nodes. Each node is a small rounded card with mono ID + name. -->
  <g class="projects-topology__nodes">
    <!-- GOAL -->
    <g class="projects-topology__node projects-topology__node--goal" transform="translate(400 60)">
      <rect x="-110" y="-16" width="220" height="32" rx="4" />
      <text x="-100" y="0" class="projects-topology__node-tag">GOAL</text>
      <text x="-58" y="0" class="projects-topology__node-name">feature/auth-v2</text>
    </g>

    <!-- Row 1: planning -->
    <g class="projects-topology__node projects-topology__node--merge" transform="translate(160 139)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T01</text>
      <text x="-23" y="4" class="projects-topology__node-name">schema</text>
    </g>
    <g class="projects-topology__node projects-topology__node--merge" transform="translate(400 139)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T02</text>
      <text x="-23" y="4" class="projects-topology__node-name">api-spec</text>
    </g>
    <g class="projects-topology__node projects-topology__node--verify" transform="translate(640 139)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T03</text>
      <text x="-23" y="4" class="projects-topology__node-name">layout</text>
    </g>

    <!-- Row 2: integration -->
    <g class="projects-topology__node projects-topology__node--merge" transform="translate(280 229)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T04</text>
      <text x="-23" y="4" class="projects-topology__node-name">migrate</text>
    </g>
    <g class="projects-topology__node projects-topology__node--coding" transform="translate(520 229)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T05</text>
      <text x="-23" y="4" class="projects-topology__node-name">endpoints</text>
    </g>

    <!-- Row 3: build -->
    <g class="projects-topology__node projects-topology__node--coding" transform="translate(160 319)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T06</text>
      <text x="-23" y="4" class="projects-topology__node-name">ui-shell</text>
    </g>
    <g class="projects-topology__node projects-topology__node--failed" transform="translate(400 319)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T07</text>
      <text x="-23" y="4" class="projects-topology__node-name">a11y</text>
    </g>
    <g class="projects-topology__node projects-topology__node--queued" transform="translate(640 319)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T08</text>
      <text x="-23" y="4" class="projects-topology__node-name">telemetry</text>
    </g>

    <!-- Row 4: recovery -->
    <g class="projects-topology__node projects-topology__node--coding" transform="translate(400 405)">
      <rect x="-66" y="-12" width="132" height="24" rx="3" />
      <text x="-56" y="4" class="projects-topology__node-tag">T09</text>
      <text x="-29" y="4" class="projects-topology__node-name">a11y-retry</text>
    </g>

    <!-- Row 5: verify -->
    <g class="projects-topology__node projects-topology__node--verify" transform="translate(280 455)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T10</text>
      <text x="-23" y="4" class="projects-topology__node-name">contract</text>
    </g>
    <g class="projects-topology__node projects-topology__node--queued" transform="translate(520 455)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T11</text>
      <text x="-23" y="4" class="projects-topology__node-name">e2e</text>
    </g>

    <!-- Row 6: merge -->
    <g class="projects-topology__node projects-topology__node--queued" transform="translate(400 528)">
      <rect x="-60" y="-12" width="120" height="24" rx="3" />
      <text x="-50" y="4" class="projects-topology__node-tag">T12</text>
      <text x="-23" y="4" class="projects-topology__node-name">merge</text>
    </g>
  </g>

  <!-- Legend strip (top-right under header rule) -->
  <g class="projects-topology__legend" transform="translate(0 0)">
    <g transform="translate(412 -2)">
      <rect class="projects-topology__chip projects-topology__chip--queued" x="0" y="40" width="10" height="6" rx="1" />
      <text x="16" y="46" class="projects-topology__legend-label">QUEUED</text>
    </g>
    <g transform="translate(486 -2)">
      <rect class="projects-topology__chip projects-topology__chip--coding" x="0" y="40" width="10" height="6" rx="1" />
      <text x="16" y="46" class="projects-topology__legend-label">CODING</text>
    </g>
    <g transform="translate(558 -2)">
      <rect class="projects-topology__chip projects-topology__chip--verify" x="0" y="40" width="10" height="6" rx="1" />
      <text x="16" y="46" class="projects-topology__legend-label">VERIFY</text>
    </g>
    <g transform="translate(626 -2)">
      <rect class="projects-topology__chip projects-topology__chip--merge" x="0" y="40" width="10" height="6" rx="1" />
      <text x="16" y="46" class="projects-topology__legend-label">MERGED</text>
    </g>
    <g transform="translate(704 -2)">
      <rect class="projects-topology__chip projects-topology__chip--failed" x="0" y="40" width="10" height="6" rx="1" />
      <text x="16" y="46" class="projects-topology__legend-label">FAILED</text>
    </g>
  </g>
</svg>

<style>
  /* Mars topology diagram — inline SVG that stands in for the (private) live
     topology view. Same border/radius/background as .projects-screenshot so the
     two project figures share one optical container. Palette is the sitewide
     mono-gold + graphite — no parallel colour system. */
  .projects-topology {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--bg-soft);
  }

  .projects-topology__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--fg-faint);
  }

  .projects-topology__rule {
    stroke: var(--line);
    stroke-width: 1;
  }

  .projects-topology__edge {
    stroke: var(--line);
    stroke-width: 1;
    opacity: 0.7;
  }

  .projects-topology__edge--recovery {
    stroke: var(--ember);
    stroke-dasharray: 3 3;
    opacity: 0.85;
  }

  .projects-topology__node rect {
    stroke-width: 1;
  }

  .projects-topology__node-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .projects-topology__node-name {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  /* State palette — each rung pulls from tokens; no hex literals.
     queued: hairline only (resting). coding: bright record gold (running).
     verify: white-hot gold (under check). merge: warm bone (completed).
     failed: red-giant ember (broken). */
  .projects-topology__node--goal rect {
    fill: color-mix(in oklch, var(--fg) 6%, transparent);
    stroke: var(--fg);
  }
  .projects-topology__node--goal text {
    fill: var(--fg);
  }

  .projects-topology__node--queued rect {
    fill: transparent;
    stroke: var(--fg-faint);
  }
  .projects-topology__node--queued text {
    fill: var(--fg-faint);
  }

  .projects-topology__node--coding rect {
    fill: color-mix(in oklch, var(--accent-strong) 10%, transparent);
    stroke: var(--accent-strong);
  }
  .projects-topology__node--coding text {
    fill: var(--accent-strong);
  }

  .projects-topology__node--verify rect {
    fill: color-mix(in oklch, var(--highlight) 8%, transparent);
    stroke: var(--highlight);
  }
  .projects-topology__node--verify text {
    fill: var(--highlight);
  }

  .projects-topology__node--merge rect {
    fill: color-mix(in oklch, var(--fg) 8%, transparent);
    stroke: var(--fg-dim);
  }
  .projects-topology__node--merge text {
    fill: var(--fg);
  }

  .projects-topology__node--failed rect {
    fill: color-mix(in oklch, var(--ember) 14%, transparent);
    stroke: var(--ember);
  }
  .projects-topology__node--failed text {
    fill: var(--ember);
  }

  .projects-topology__legend-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--fg-faint);
  }

  .projects-topology__chip {
    stroke-width: 1;
  }
  .projects-topology__chip--queued { fill: transparent; stroke: var(--fg-faint); }
  .projects-topology__chip--coding { fill: var(--accent-strong); stroke: var(--accent-strong); }
  .projects-topology__chip--verify { fill: var(--highlight); stroke: var(--highlight); }
  .projects-topology__chip--merge  { fill: var(--fg); stroke: var(--fg-dim); }
  .projects-topology__chip--failed { fill: var(--ember); stroke: var(--ember); }
</style>
