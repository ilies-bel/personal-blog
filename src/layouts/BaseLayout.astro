---
import BaseHead from '../components/BaseHead.astro';
// Sitewide custom cursor: a quiet off-white dot that becomes a hexagon outline
// over interactive elements. Mounted once here so it covers every page (both the
// `bare` home and the standard reading pages). Self-contained — see the file.
import CustomCursor from '../components/CustomCursor.astro';
import { SITE_TITLE, SITE_LANG, SOCIALS, BRAND_NAME, BRAND_ROLE } from '../consts';
// The sitewide type system: Space Grotesk (display 700 / body 400), IBM Plex Mono
// (labels, dates, tags), Instrument Serif italic (occasional quote / manifesto).
// Self-hosted woff2 + bundled by Vite — no render-blocking CDN request. The faces
// live in fonts.css; they're applied sitewide via the --font-* tokens in global.css.
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  // `bare` strips the standard reading chrome (gutter shell + footer) and shows
  // only the fixed corner overlay: brand top-left, the blog micro-nav top-right.
  // Used by the home page, whose whole canvas is the scroll-scrubbed scene.
  bare?: boolean;
  // Optional extra class on <body>. Lets a bare page (e.g. About) opt into its
  // own chrome variant — see body.bare.about-page in global.css, which shows the
  // top-left wordmark and hides the home-only micro-nav so Close can own the
  // top-right corner.
  bodyClass?: string;
}

const props = Astro.props;
const { bare = false, bodyClass } = props;
const bodyClasses = [bare ? 'bare' : null, bodyClass].filter(Boolean).join(' ') || undefined;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
const year = new Date().getFullYear();

// Mark the active nav item (the reference highlights the current page in its
// pill). Compare the current path to each link's resolved href, trailing-slash
// insensitive, so "/" and "/about" each light up their own pill segment.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const isActive = (p: string) => norm(href(p)) === path;
const writingRoot = norm(href('writing'));
const postsRoot = norm(href('posts'));
const isWritingActive = path === writingRoot || path.startsWith(`${postsRoot}/`);
---

<!doctype html>
<html lang={SITE_LANG} class={bare ? 'is-bare' : undefined}>
  <head>
    <BaseHead {...props} />
  </head>
  <body class={bodyClasses}>
    {/* Sitewide custom cursor — covers both layout branches below. */}
    <CustomCursor />
    {
      bare ? (
        <Fragment>
          {/* First focusable element in the body: a skip link that jumps past
              the corner chrome / scene canvas straight to the main content. */}
          <a href="#main-content" class="skip-link">Skip to main content</a>

          {/* Fixed corner overlay: identity top-left, the blog micro-nav
              top-right. Everything else is the scene canvas behind it. */}
          <a class="overlay-brand bh-identity-lockup" href={href('')}>
            <span class="bh-identity-name">{BRAND_NAME}</span>
            <span class="bh-identity-role">{BRAND_ROLE}</span>
          </a>

          {/* The blog micro-nav, top-right: the four section routes rendered as quiet
              glyph icons that share the left HUD rail's visual language — a pale-blue
              dot for About, the nebula speck for Writing, the four-point star for
              Projects, the red-giant teardrop for Graveyard. The text labels stay
              folded away and only unfurl (icon → icon+label) once real scroll reaches
              the black hole, or the power button is engaged (body.hud-active). A "two
              planets" <details> dropdown holds the social links (zero-JS, native), and
              a power button toggles the hud-active morph in place without scrolling. */}
          <nav class="overlay-blog" aria-label="Sections">
            {/* The four section icons are redrawn on ONE shared optical grid so the
                row reads as a set: each motif fits a ~20px circle centred at (16,16)
                (radius ~9–10 max), all stroke="currentColor" stroke-width="1.5"
                fill="none" with round joins/caps, only a small center accent filled.
                Identical visual mass; the lifecycle motif stays but disciplined. */}
            <div class="overlay-blog-links">
              <a class="overlay-blog-link" href={href('about')} aria-label="About">
                {/* THE BEGINNING / pale blue dot — thin ring + small filled speck. */}
                <svg class="overlay-blog-icon" viewBox="0 0 32 32" aria-hidden="true">
                  <circle cx="16" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="16" cy="16" r="2" fill="currentColor" stroke="none" />
                </svg>
                <span class="overlay-blog-label">About</span>
              </a>
              <a class="overlay-blog-link" href={href('writing')} aria-label="Writing">
                {/* NEBULA — thin ring + a concentric inner hint and two small orbiting
                    specks. Same weight/mass as About but distinct (gas, not a dot). */}
                <svg
                  class="overlay-blog-icon"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="16" cy="16" r="9" />
                  <circle cx="16" cy="16" r="4" />
                  <circle cx="16" cy="6" r="0.9" fill="currentColor" stroke="none" />
                  <circle cx="25" cy="20" r="0.9" fill="currentColor" stroke="none" />
                </svg>
                <span class="overlay-blog-label">Writing</span>
              </a>
              <a class="overlay-blog-link" href={href('projects')} aria-label="Projects">
                {/* YELLOW STAR — a 4-point star OUTLINE sized to fit the ~20px circle
                    (vertices at r~10), 1.5 stroke, round joins. */}
                <svg
                  class="overlay-blog-icon"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 6 Q17 15 26 16 Q17 17 16 26 Q15 17 6 16 Q15 15 16 6 Z" />
                </svg>
                <span class="overlay-blog-label">Projects</span>
              </a>
              <a class="overlay-blog-link" href={href('graveyard')} aria-label="Graveyard">
                {/* RED GIANT — a swollen limb read as a half-toned circle (◐): a ring
                    OUTLINE with the left hemisphere filled. Same weight, NOT a solid
                    teardrop, same mass as the others. */}
                <svg class="overlay-blog-icon" viewBox="0 0 32 32" aria-hidden="true">
                  <circle cx="16" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />
                  <path d="M16 7 A 9 9 0 0 0 16 25 Z" fill="currentColor" stroke="none" opacity="0.85" />
                </svg>
                <span class="overlay-blog-label">Graveyard</span>
              </a>
            </div>

            <details class="overlay-blog-socials">
              {/* The summary carries a visible "Links" label now (folded at rest,
                  unfurled with the section labels on body.bare.hud-active, same hover
                  micro-interaction). The visible text is the accessible name, so the
                  redundant aria-label is dropped — the icon stays aria-hidden, and the
                  label inside the summary names the toggle (no double-announce). The
                  <details>/<summary> still drives the dropdown with zero JS. */}
              <summary class="overlay-blog-socials-toggle overlay-blog-link">
                {/* Two planets — one orbiting the other. Matched to the section-icon
                    weight (1.5 stroke, ~20px optical footprint). */}
                <svg class="overlay-blog-icon" viewBox="0 0 32 32" aria-hidden="true">
                  <circle cx="13" cy="16" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="24" cy="16" r="3" fill="currentColor" stroke="none" />
                </svg>
                <span class="overlay-blog-label">Links</span>
              </summary>
              <div class="overlay-blog-socials-menu">
                {SOCIALS.github && <a href={SOCIALS.github} class="overlay-social">GitHub</a>}
                {SOCIALS.twitter && <a href={SOCIALS.twitter} class="overlay-social">X</a>}
                {SOCIALS.email && <a href={`mailto:${SOCIALS.email}`} class="overlay-social">Email</a>}
              </div>
            </details>

            {/* Power button: a manual override that TOGGLES the hud-active morph in
                place (no scrolling). Sticky — once engaged it adds body.hud-forced so
                the scroll-driven toggle in HeroIsland stands down until toggled off. */}
            <button
              type="button"
              class="overlay-blog-power"
              aria-pressed="false"
              aria-label="Toggle navigation"
            >
              {/* IEC power glyph: an open ring broken at the top by a vertical line.
                  Matched to the section-icon weight (1.5 stroke) so the corner reads
                  as one set; the circular FRAME around it lives in scene.css. */}
              <svg class="overlay-blog-icon" viewBox="0 0 32 32" aria-hidden="true">
                <path
                  d="M16 6 L16 15"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <path
                  d="M11 10.5 A 7 7 0 1 0 21 10.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </nav>

          {/* Boot transition layers — driven entirely by body.hud-booting (added for
              the ~3.6s power-on window by the FSM script below). Three fixed, full-
              viewport, pointer-events:none layers + a bottom-centre readout, all CSS-
              off the body class (see hud.css → "HUD boot sequence"); aria-hidden so
              none of it ever announces:
                • .hud-boot-flicker — a light layer that surges/settles (power surge).
                • .hud-boot-scan    — a thin line that sweeps across the viewport.
                • .hud-boot         — the status readout + a stuttering progress bar.
              The .hud-boot-label TEXT is swapped by the FSM through the boot window
              (LOADING → CALIBRATING → ALIGNING → SYSTEMS NOMINAL) so the readout
              reads like a machine running its start-up self-check. */}
          <div class="hud-boot-flicker" aria-hidden="true"></div>
          <div class="hud-boot-scan" aria-hidden="true"></div>
          <div class="hud-boot" aria-hidden="true">
            <span class="hud-boot-label">LOADING</span>
            <span class="hud-boot-bar"></span>
          </div>

          {/* HUD POWER STATE MACHINE — the single, explicit owner of the HUD's body
              classes and its loader sequence. A self-contained, zero-import
              <script is:inline> (mirrors the project's CustomCursor convention) so it
              runs the moment the body parses, with no framework on the critical path.

              The machine has three states:
                • idle    — HUD off (scrolling the lifecycle, not at the black hole).
                • booting — the power-on / loader sequence is playing (body.hud-booting).
                • ready   — HUD fully lit (body.hud-active → rail + compass + menu up).
              The `forced` flag (corner power button engaged) is ORTHOGONAL — it is a
              sticky request to be powered on regardless of scroll, mirrored to
              body.hud-forced.

              transition(next) is the ONLY place body classes are mutated. Everything
              else just calls it. Inputs that drive it:
                • the HUD_POWER_EVENT ('hud:power') HeroIsland dispatches when real
                  scroll reaches / leaves the black hole (detail.on);
                • the power button (forced on/off).
              Behaviour: once booted we STAY powered (scroll-up does not tear the HUD
              down) — the only thing that returns us to idle is the power button
              explicitly powering OFF (or a fresh load whose persisted state was off).
              The state is mirrored to localStorage on every transition and restored
              on init, so a returning visitor lands straight in `ready` (no replayed
              3.6s boot) or `idle` exactly as they left it.

              The class-string + storage-key + event-name literals below are the same
              ones centralized in src/hero/lib/constants.ts — this inline island can't
              import that module (no bundler on an is:inline script), so the literals
              are spelled here and MUST be kept in sync with that file. Likewise
              BOOT_MS mirrors HUD_BOOT_DURATION_MS and is pushed into --hud-boot-dur so
              the CSS animation length can never drift from the JS timer. */}
          <script is:inline>
            (() => {
              // --- Centralized literals (mirror src/hero/lib/constants.ts) ---------
              const ACTIVE_CLASS = 'hud-active'; // HUD_ACTIVE_BODY_CLASS  (ready)
              const BOOTING_CLASS = 'hud-booting'; // HUD_BOOTING_BODY_CLASS (booting)
              const FORCED_CLASS = 'hud-forced'; // HUD_FORCED_BODY_CLASS  (forced override)
              const STATE_KEY = 'hud-state'; // HUD_STATE_STORAGE_KEY
              const POWER_EVENT = 'hud:power'; // HUD_POWER_EVENT (from HeroIsland)
              const BOOT_MS = 3600; // HUD_BOOT_DURATION_MS — keep in sync with --hud-boot-dur

              const body = document.body;
              const root = document.documentElement;
              const btn = document.querySelector('.overlay-blog-power');
              const bootLabel = document.querySelector('.hud-boot-label');

              // Honour the OS reduced-motion preference: under it the boot is a calm,
              // brief readout (no flicker/scan/stutter — those are dropped in CSS) and
              // we shorten the JS window so the readout doesn't linger.
              const reduceMotion =
                window.matchMedia &&
                window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              const bootMs = reduceMotion ? 700 : BOOT_MS;

              // Push the boot duration into the CSS var so the bar/flicker/scan
              // animation lengths track the JS timer from a single source.
              root.style.setProperty('--hud-boot-dur', BOOT_MS + 'ms');

              // The machine-startup status lines, cycled through the boot window so
              // the readout reads like a system check, not a flat bar. Tasteful, on-
              // theme (Golden Record / black-hole instrument; mono uppercase via CSS).
              const BOOT_LINES = ['LOADING', 'CALIBRATING', 'ALIGNING ARRAY', 'SYSTEMS NOMINAL'];

              // --- Persistence (try/catch — private mode must never throw) ---------
              const readState = () => {
                try {
                  const raw = window.localStorage.getItem(STATE_KEY);
                  if (!raw) return { powered: false, forced: false };
                  const parsed = JSON.parse(raw);
                  return {
                    powered: parsed.powered === true,
                    forced: parsed.forced === true,
                  };
                } catch (_) {
                  return { powered: false, forced: false };
                }
              };
              const writeState = (powered, forcedFlag) => {
                try {
                  window.localStorage.setItem(
                    STATE_KEY,
                    JSON.stringify({ powered: powered, forced: forcedFlag }),
                  );
                } catch (_) {
                  /* storage disabled — run without persistence */
                }
              };

              // --- Machine state ---------------------------------------------------
              let state = 'idle'; // 'idle' | 'booting' | 'ready'
              let forced = false; // power-button override (orthogonal to state)
              let bootEndTimer = 0;
              const lineTimers = [];

              const clearLineTimers = () => {
                while (lineTimers.length) window.clearTimeout(lineTimers.pop());
              };
              const setBootLine = (text) => {
                if (bootLabel) bootLabel.textContent = text;
              };

              // Reflect `forced` onto the body + the power button's ARIA. The button
              // is a toggle for the FORCED override specifically; its LIT (gold) look
              // is keyed off body.hud-active in CSS so it reads ON whenever the HUD is
              // up, however it got there.
              const applyForced = () => {
                body.classList.toggle(FORCED_CLASS, forced);
                if (btn) btn.setAttribute('aria-pressed', forced ? 'true' : 'false');
              };

              // transition(next) — the ONLY place the state classes change. Each call
              // sets the body classes for `next`, schedules any timers that state
              // owns, and persists the resulting power state.
              const transition = (next) => {
                if (next === state) return;
                // Leaving booting: always clear its timers so a fast power-off press
                // can cancel the loader cleanly.
                if (state === 'booting') {
                  window.clearTimeout(bootEndTimer);
                  clearLineTimers();
                }
                state = next;

                if (next === 'idle') {
                  body.classList.remove(BOOTING_CLASS);
                  body.classList.remove(ACTIVE_CLASS);
                  writeState(false, forced);
                  return;
                }

                if (next === 'booting') {
                  // HUD stays DARK while the loader plays: add booting, ensure active
                  // is OFF so the rail/compass/menu only ignite once booting → ready.
                  body.classList.remove(ACTIVE_CLASS);
                  body.classList.add(BOOTING_CLASS);
                  // Cycle the status lines across the boot window so the readout reads
                  // like a startup self-check. Spread evenly; the last line (SYSTEMS
                  // NOMINAL) lands just before ignition.
                  setBootLine(BOOT_LINES[0]);
                  if (!reduceMotion) {
                    for (let i = 1; i < BOOT_LINES.length; i++) {
                      const at = (bootMs * i) / BOOT_LINES.length;
                      lineTimers.push(window.setTimeout(() => setBootLine(BOOT_LINES[i]), at));
                    }
                  }
                  // Boot completes → ignite. Non-interruptible by scroll; a power-off
                  // press calls transition('idle') which clears this timer.
                  bootEndTimer = window.setTimeout(() => transition('ready'), bootMs);
                  writeState(true, forced); // intent: we are powering up to ready
                  return;
                }

                if (next === 'ready') {
                  // Boot finished (or restored): drop booting, light the HUD. NOW the
                  // rail cascade + compass + menu chrome ignite together.
                  body.classList.remove(BOOTING_CLASS);
                  body.classList.add(ACTIVE_CLASS);
                  writeState(true, forced);
                  return;
                }
              };

              // requestPowerOn — go to ready via the loader, unless we are already on
              // the way (booting) or there (ready). Skips the boot when restoring.
              const requestPowerOn = (skipBoot) => {
                if (state === 'ready') return;
                if (skipBoot) {
                  // Restore path: land straight in ready so a returning visitor isn't
                  // marched through the 3.6s boot again.
                  transition('ready');
                  return;
                }
                if (state === 'booting') return; // already powering up
                transition('booting');
              };

              // requestPowerOff — return to idle. Booting cancels to idle (a power-off
              // press during boot aborts the loader); ready tears straight down.
              const requestPowerOff = () => {
                if (state === 'idle') return;
                transition('idle');
              };

              // --- Inputs ----------------------------------------------------------
              // 1) Scroll signal from HeroIsland (the black-hole edge). When forced is
              //    engaged the scroll signal must NOT power the HUD off (sticky). A
              //    scroll-ON powers up; once booted we STAY powered, so scroll-OFF is
              //    ignored unless we were never forced AND never booted — i.e. the only
              //    thing that powers down is the button (handled below). So here we only
              //    act on the power-ON edge from scroll.
              window.addEventListener(POWER_EVENT, (event) => {
                const detail = event && event.detail ? event.detail : null;
                if (!detail) return;
                if (detail.on) requestPowerOn(false);
                // detail.on === false (scroll left the black hole) is deliberately a
                // no-op: once booted the HUD stays lit until the power button powers
                // it off. (The forced override would suppress it anyway.)
              });

              // 2) Power button — toggles the forced override. Engaging it powers the
              //    HUD on (booting → ready); disengaging it powers OFF (the single way
              //    back to idle). aria-pressed tracks `forced`.
              if (btn) {
                btn.addEventListener('click', () => {
                  forced = !forced;
                  applyForced();
                  if (forced) requestPowerOn(false);
                  else requestPowerOff();
                });
              }

              // --- Init: restore persisted power state (apply classes ASAP, no flash).
              const persisted = readState();
              forced = persisted.forced;
              applyForced();
              if (persisted.powered) {
                // Returning visitor who left the HUD on: restore ready directly (no
                // replayed boot). If they had forced it on, forced is already applied.
                requestPowerOn(true);
              }
            })();
          </script>

          <main id="main-content" class="bare-main">
            <slot />
          </main>
        </Fragment>
      ) : (
        <div class="wrap">
          {/* First focusable element in the body: a skip link that jumps past
              the header / nav straight to the main content. */}
          <a href="#main-content" class="skip-link">Skip to main content</a>

          <header class="site-header">
            <a class="brand bh-identity-lockup" href={href('')}>
              <span class="bh-identity-name">{BRAND_NAME}</span>
              <span class="bh-identity-role">{BRAND_ROLE}</span>
            </a>
            <nav class="nav-pill">
              <a
                href={href('')}
                class={isActive('') ? 'is-active' : undefined}
                aria-current={isActive('') ? 'page' : undefined}
              >
                Home
              </a>
              <a
                href={href('writing')}
                class={isWritingActive ? 'is-active' : undefined}
                aria-current={isWritingActive ? 'page' : undefined}
              >
                Writing
              </a>
              <a
                href={href('projects')}
                class={isActive('projects') ? 'is-active' : undefined}
                aria-current={isActive('projects') ? 'page' : undefined}
              >
                Projects
              </a>
              <a
                href={href('graveyard')}
                class={isActive('graveyard') ? 'is-active' : undefined}
                aria-current={isActive('graveyard') ? 'page' : undefined}
              >
                Graveyard
              </a>
              <a
                href={href('about')}
                class={isActive('about') ? 'is-active' : undefined}
                aria-current={isActive('about') ? 'page' : undefined}
              >
                About
              </a>
            </nav>
          </header>

          <main id="main-content">
            <slot />
          </main>

          <footer class="site-footer">
            <span>© {year} {SITE_TITLE}</span>
            <span class="socials">
              {SOCIALS.github && <a href={SOCIALS.github}>github</a>}
              {SOCIALS.twitter && <a href={SOCIALS.twitter}>twitter</a>}
              {SOCIALS.email && <a href={`mailto:${SOCIALS.email}`}>email</a>}
            </span>
          </footer>
        </div>
      )
    }
  </body>
</html>
