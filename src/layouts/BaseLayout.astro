---
import BaseHead from '../components/BaseHead.astro';
// Sitewide custom cursor: a quiet off-white dot that becomes a hexagon outline
// over interactive elements. Mounted once here so it covers every page (both the
// `bare` home and the standard reading pages). Self-contained — see the file.
import CustomCursor from '../components/CustomCursor.astro';
// Astro SPA navigation. Mounted sitewide so the cinematic marker dive can swap to
// the destination article with NO full-page reload flash (the dive bloom covers the
// swap and the destination "resurfaces" from under the receding white). Nodes marked
// transition:persist (the dive overlay, the custom cursor) survive each swap.
import { ClientRouter } from 'astro:transitions';
import { SITE_LANG, SOCIALS, BRAND_NAME, BRAND_ROLE } from '../consts';
// The hero's lifecycle nav rows (celestial body label + section destination + href),
// in physical scroll order. The single source of truth for the rail; the reading-
// page sub-nav projects it below so the two correspond and can never drift. Imported
// from the PURE data layer (sceneTable.ts), not HudNavigation.tsx, so the Astro
// frontmatter pulls no React into this layout.
import { HUD_NAV_ITEMS } from '../hero/sceneTable';
// The sitewide type system: Instrument Serif (display headlines + quote accent),
// IBM Plex Sans (body/UI), IBM Plex Mono (labels, dates, tags).
// Self-hosted woff2 + bundled by Vite — no render-blocking CDN request. The faces
// live in fonts.css; they're applied sitewide via the --font-* tokens in global.css.
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  // `bare` strips the standard reading chrome (gutter shell + footer) and shows
  // only the fixed corner overlay: brand top-left, the blog micro-nav top-right.
  // Used by the home page, whose whole canvas is the scroll-scrubbed scene.
  bare?: boolean;
  // Optional extra class on <body>. Lets a bare page (e.g. About) opt into its
  // own chrome variant — see body.bare.about-page in global.css, which shows the
  // top-left wordmark and hides the home-only micro-nav so Close can own the
  // top-right corner.
  bodyClass?: string;
  // MINIMAL READING CHROME (article pages): the header keeps only the wordmark +
  // social icons — no station rail — so a reading page is a quiet room of the same
  // ship (the hero has no top bar either; the full-width station bar was the one
  // conventional-navbar moment in the whole DA). The full station nav renders as a
  // block in the footer instead, after the article's own "Next note" continuation.
  minimalChrome?: boolean;
}

const props = Astro.props;
const { bare = false, bodyClass, minimalChrome = false } = props;
const bodyClasses = [bare ? 'bare' : null, bodyClass].filter(Boolean).join(' ') || undefined;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
const year = new Date().getFullYear();

// Mark the active nav item (the sub-page HUD nav locks the current section).
// Compare the current path to each link's resolved href, trailing-slash
// insensitive, so "/" and "/about" each light up their own section.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const isActive = (p: string) => norm(href(p)) === path;
const writingRoot = norm(href('writing'));
const postsRoot = norm(href('posts'));
// The black hole links to a POST (its own essay, "Inspiration"), so it lives under
// the /posts/ subtree that the Writing/nebula row otherwise claims. Resolve that one
// post's path from the same source of truth (the hero's end/black-hole nav row) and
// EXCLUDE it from the Writing lock, so the inspiration post locks the BLACK HOLE row
// only — every page lights exactly one section.
const blackHoleHref = HUD_NAV_ITEMS.find((item) => item.id === 'end')?.href ?? '';
const blackHolePath = blackHoleHref ? norm(href(blackHoleHref)) : '';
const isWritingActive =
  path === writingRoot ||
  (path.startsWith(`${postsRoot}/`) && path !== blackHolePath);

// Sub-page HUD nav model — the standard (non-bare) reading-page nav, rebuilt to
// CORRESPOND with the hero's vertical lifecycle rail. Each row is a Body·Section
// PAIR: `label` is the celestial body (the bright title line, e.g. 'BLACK HOLE'),
// `section` is the destination it links to (the dim second line, e.g.
// 'Inspiration'). The five lifecycle rows are DERIVED from the hero's single
// source of truth (HUD_NAV_ITEMS in sceneTable.ts) — same labels, same
// destinations, same top→bottom scroll order — so the rail and this nav can never
// drift. Two reading-only pages that have no lifecycle stage (Home = the hero
// scene itself, Behind = the build case study) are appended in the SAME two-line
// shape with a quiet body line that fits the family.
interface SubnavItem {
  href: string;
  /** Bright title line — the celestial body (or the page's own name). */
  label: string;
  /** Dim second line — the section this row links to. */
  section: string;
  active: boolean;
}
// CURATED SITE NAV — no longer a 1:1 projection of the hero's five stations. The
// full lifecycle list read as "too many links" in the chrome, and the site menu
// does not need to mirror the scene order (the hero's rail/markers still do).
// Three primary destinations lead; everything secondary — the Inspiration essay,
// the making-of, and the graveyard (deliberately NOT a headline entry; it is also
// referenced from the About page) — lives behind one INDEX page. Body·Section
// pairs keep the celestial register where a body exists.
const subnavItems: SubnavItem[] = [
  { href: href('projects'), label: 'YELLOW STAR', section: 'Projects', active: isActive('projects') },
  // Writing stays active across the posts subtree (minus the inspiration post,
  // which belongs to the Index entry below).
  { href: href('writing'), label: 'NEBULA', section: 'Writing', active: isWritingActive },
  { href: href('about'), label: 'THE BEGINNING', section: 'About', active: isActive('about') },
  {
    href: href('archive'),
    label: 'THE ARCHIVE',
    section: 'Index',
    active:
      isActive('archive') ||
      isActive('graveyard') ||
      isActive('behind-the-build') ||
      path === blackHolePath,
  },
  // Home — return to the live scene itself (the whole lifecycle).
  { href: href(''), label: 'THE SCENE', section: 'Home', active: isActive('') },
];
// Two-digit mono index for the locked section (1-based, matches reading order).
const subnavIndex = (i: number): string => String(i + 1).padStart(2, '0');

// Corner nav (bare pages: home + about) — the SAME rows as the reading nav,
// rendered at a lighter density: single-line SECTION words, same lifecycle order,
// same source of truth. One nav system, two densities — the celestial body line
// only appears where a scene rail can anchor it (the reading nav + hero rail).
// On the home scene the 'Home' row is dropped (you are standing on it); About
// keeps it as the way back into the scene.
const cornerItems = subnavItems.filter((item) => !(isActive('') && item.section === 'Home'));
---

<!doctype html>
<html lang={SITE_LANG} class={bare ? 'is-bare' : undefined}>
  <head>
    <BaseHead {...props} />
    <ClientRouter />
  </head>
  <body class={bodyClasses}>
    {/* Cinematic dive overlay — a single full-viewport bloom layer present on EVERY
        page, persisted across ClientRouter swaps (transition:persist) so the home
        page's dive can ramp its opacity to a soft, capped veil (never full white) — in
        the FIRING marker's lifecycle-state tint, set via data-bloom-state — the
        navigation swaps the page body UNDER it, and the destination's page-load handler
        eases it back out for the "resurface" (and clears the tint so the next nav starts
        clean). Starts hidden via CSS (opacity 0), so a normal page load / navigation
        never sees it. */}
    <div class="dive-overlay" data-dive-overlay transition:persist aria-hidden="true"></div>
    {/* Sitewide custom cursor — covers both layout branches below. */}
    <CustomCursor />
    {
      bare ? (
        <Fragment>
          {/* First focusable element in the body: a skip link that jumps past
              the corner chrome / scene canvas straight to the main content. */}
          <a href="#main-content" class="skip-link">Skip to main content</a>

          {/* Fixed corner overlay: identity top-left, the blog micro-nav
              top-right. Everything else is the scene canvas behind it. */}
          <a class="overlay-brand bh-identity-lockup" href={href('')}>
            <span class="bh-identity-name">{BRAND_NAME}</span>
            <span class="bh-identity-role">{BRAND_ROLE}</span>
          </a>

          {/* The blog micro-nav, top-right: the five section routes rendered as quiet
              text labels (mono-uppercase) that dim at rest and brighten/lift once the
              HUD activates at the black hole (body.hud-active). Two inline brand-logo
              icon links — a GitHub octocat and an X logo — sit as direct <a> siblings
              next to the section labels, reusing .overlay-blog-link so they track the
              same dim→bright color, hover underline-sweep, focus ring, and hud-active
              lift. A power button toggles the hud-active morph in place without
              scrolling. */}
          <nav class="overlay-blog" aria-label="Sections">
            {/* Text-only section labels — no decorative icons. The five links
                show small mono-uppercase labels at rest (dim) and brighten/lift
                when the HUD activates at the black hole (body.bare.hud-active).
                The functional icon links/Power controls below KEEP their inline SVGs. */}
            {/* Section links carry the reading nav's target-lock frame (four corner
                ticks), shown on HOVER/focus here — the same "targeting" motif the
                .subnav locks onto its current section, ported to the hero as an
                interaction. The frame is position:absolute (see scene.css), so it
                overlays on hover without shifting the row. No index number (a number
                appearing on hover would change the link's width). */}
            <div class="overlay-blog-links">
              {/* ONE nav system, two densities: these are the SAME rows the reading
                  nav (.subnav) renders, mapped from the same cornerItems/subnavItems
                  list — here as single-line SECTION words in lifecycle order (the
                  celestial-body first line belongs to surfaces with a scene rail).
                  aria-current lights the section you are on (About, on that page). */}
              {cornerItems.map((item) => (
                <a
                  class="overlay-blog-link overlay-blog-section"
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                >
                  <span class="overlay-blog-lock" aria-hidden="true">
                    <span class="overlay-blog-tick overlay-blog-tick-tl"></span>
                    <span class="overlay-blog-tick overlay-blog-tick-tr"></span>
                    <span class="overlay-blog-tick overlay-blog-tick-bl"></span>
                    <span class="overlay-blog-tick overlay-blog-tick-br"></span>
                  </span>
                  <span class="overlay-blog-label">{item.section}</span>
                </a>
              ))}
            </div>

            {/* Two inline brand-logo icon links — GitHub octocat and X logo. Both
                carry .overlay-blog-link so they inherit the rail's dim→bright color
                tracking, hover underline-sweep, focus ring, and hud-active lift.
                The aria-label on each <a> is the only accessible name (no visible
                text label). Icons use official simple-icons paths, fill="currentColor"
                so they pick up the rail's currentColor exactly like the power glyph. */}
            {SOCIALS.github && (
              <a class="overlay-blog-link overlay-blog-social" href={SOCIALS.github} aria-label="GitHub">
                <svg class="overlay-blog-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                </svg>
              </a>
            )}
            {SOCIALS.twitter && (
              <a class="overlay-blog-link overlay-blog-social" href={SOCIALS.twitter} aria-label="X">
                <svg class="overlay-blog-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
            )}

            {/* Power button: a manual override that TOGGLES the hud-active morph in
                place (no scrolling). Sticky — once engaged it adds body.hud-forced so
                the scroll-driven toggle in HeroIsland stands down until toggled off. */}
            <button
              type="button"
              class="overlay-blog-power"
              aria-pressed="false"
              aria-label="Toggle navigation"
            >
              {/* IEC power glyph: an open ring broken at the top by a vertical line.
                  Matched to the section-icon weight (1.5 stroke) so the corner reads
                  as one set; the circular FRAME around it lives in scene.css. */}
              <svg class="overlay-blog-icon" viewBox="0 0 32 32" aria-hidden="true">
                <path
                  d="M16 6 L16 15"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <path
                  d="M11 10.5 A 7 7 0 1 0 21 10.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </nav>

          {/* Boot transition layers — driven entirely by body.hud-booting (added for
              the ~3.6s power-on window by the FSM script below). Three fixed, full-
              viewport, pointer-events:none layers + a bottom-centre readout, all CSS-
              off the body class (see hud.css → "HUD boot sequence"); aria-hidden so
              none of it ever announces:
                • .hud-boot-flicker — a light layer that surges/settles (power surge).
                • .hud-boot-scan    — a thin line that sweeps across the viewport.
                • .hud-boot         — the status readout + a stuttering progress bar.
              The .hud-boot-label TEXT is swapped by the FSM through the boot window
              (LOADING → CALIBRATING → ALIGNING → SYSTEMS NOMINAL) so the readout
              reads like a machine running its start-up self-check. */}
          <div class="hud-boot-flicker" aria-hidden="true"></div>
          <div class="hud-boot-scan" aria-hidden="true"></div>
          <div class="hud-boot" aria-hidden="true">
            <span class="hud-boot-label">LOADING</span>
            <span class="hud-boot-bar"></span>
          </div>

          {/* HUD POWER STATE MACHINE — the single, explicit owner of the HUD's body
              classes and its loader sequence. A self-contained, zero-import
              <script is:inline> (mirrors the project's CustomCursor convention) so it
              runs the moment the body parses, with no framework on the critical path.

              The machine has three states:
                • idle    — HUD off (scrolling the lifecycle, not at the black hole).
                • booting — the power-on / loader sequence is playing (body.hud-booting).
                • ready   — HUD fully lit (body.hud-active → rail + compass + menu up).
              The `forced` flag (corner power button engaged) is ORTHOGONAL — it is a
              sticky request to be powered on regardless of scroll, mirrored to
              body.hud-forced.

              transition(next) is the ONLY place body classes are mutated. Everything
              else just calls it. Inputs that drive it:
                • the HUD_POWER_EVENT ('hud:power') HeroIsland dispatches when real
                  scroll reaches / leaves the black hole (detail.on);
                • the power button (forced on/off).
              Behaviour: once booted we STAY powered (scroll-up does not tear the HUD
              down) — the only thing that returns us to idle is the power button
              explicitly powering OFF (or a fresh load whose persisted state was off).
              The state is mirrored to localStorage on every transition and restored
              on init, so a returning visitor lands straight in `ready` (no replayed
              3.6s boot) or `idle` exactly as they left it.

              The class-string + storage-key + event-name literals below are the same
              ones centralized in src/hero/lib/constants.ts — this inline island can't
              import that module (no bundler on an is:inline script), so the literals
              are spelled here and MUST be kept in sync with that file. Likewise
              BOOT_MS mirrors HUD_BOOT_DURATION_MS and is pushed into --hud-boot-dur so
              the CSS animation length can never drift from the JS timer. */}
          <script>
            // NOTE: this is now a BUNDLED script (no `is:inline`) so it can re-run on
            // every ClientRouter swap. ClientRouter replaces document.body (and with
            // it the power button + boot-label nodes) on each navigation, so the FSM
            // is wrapped in an idempotent initHudFsm() that RE-QUERIES those nodes each
            // call and re-applies the persisted/current state to the fresh DOM. The
            // machine state itself (state / forced / timers / the bound window listener)
            // lives ONCE on window.__bhHudFsm so a re-init reuses it and only the window
            // listener is bound a single time across swaps. Behaviour is otherwise
            // identical to the former <script is:inline> island.
            type HudState = 'idle' | 'booting' | 'ready';
            // The machine state persisted on window across ClientRouter swaps. The
            // control functions (requestPowerOn/Off, toggleForced) are re-pointed to the
            // current DOM by each init, so the single window listener + the once-per-node
            // button listener always drive the live page.
            interface HudFsm {
              state: HudState;
              forced: boolean;
              bootEndTimer: number;
              lineTimers: number[];
              windowBound: boolean;
              requestPowerOn?: (skipBoot: boolean) => void;
              requestPowerOff?: () => void;
              toggleForced?: () => void;
            }
            function initHudFsm(): void {
              // --- Centralized literals (mirror src/hero/lib/constants.ts) ---------
              const ACTIVE_CLASS = 'hud-active'; // HUD_ACTIVE_BODY_CLASS  (ready)
              const BOOTING_CLASS = 'hud-booting'; // HUD_BOOTING_BODY_CLASS (booting)
              const FORCED_CLASS = 'hud-forced'; // HUD_FORCED_BODY_CLASS  (forced override)
              const STATE_KEY = 'hud-state'; // HUD_STATE_STORAGE_KEY
              const POWER_EVENT = 'hud:power'; // HUD_POWER_EVENT (from HeroIsland)
              const BOOT_MS = 3600; // HUD_BOOT_DURATION_MS — keep in sync with --hud-boot-dur

              // RE-QUERY the per-swap DOM each init. body / btn / bootLabel are all
              // replaced when ClientRouter swaps the document, so capturing them once
              // (the old behaviour) would leave the FSM pointing at detached nodes.
              const body = document.body;
              const root = document.documentElement;
              const btn = document.querySelector<HTMLButtonElement>('.overlay-blog-power');
              const bootLabel = document.querySelector<HTMLElement>('.hud-boot-label');

              // Honour the OS reduced-motion preference: under it the boot is a calm,
              // brief readout (no flicker/scan/stutter — those are dropped in CSS) and
              // we shorten the JS window so the readout doesn't linger.
              const reduceMotion =
                window.matchMedia &&
                window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              const bootMs = reduceMotion ? 700 : BOOT_MS;

              // Push the boot duration into the CSS var so the bar/flicker/scan
              // animation lengths track the JS timer from a single source.
              root.style.setProperty('--hud-boot-dur', BOOT_MS + 'ms');

              // The machine-startup status lines, cycled through the boot window so
              // the readout reads like a system check, not a flat bar. Tasteful, on-
              // theme (Golden Record / black-hole instrument; mono uppercase via CSS).
              const BOOT_LINES = ['LOADING', 'CALIBRATING', 'ALIGNING ARRAY', 'SYSTEMS NOMINAL'];

              // --- Persistence (try/catch — private mode must never throw) ---------
              const readState = (): { powered: boolean; forced: boolean } => {
                try {
                  const raw = window.localStorage.getItem(STATE_KEY);
                  if (!raw) return { powered: false, forced: false };
                  const parsed = JSON.parse(raw);
                  return {
                    powered: parsed.powered === true,
                    forced: parsed.forced === true,
                  };
                } catch (_) {
                  return { powered: false, forced: false };
                }
              };
              const writeState = (powered: boolean, forcedFlag: boolean): void => {
                try {
                  window.localStorage.setItem(
                    STATE_KEY,
                    JSON.stringify({ powered: powered, forced: forcedFlag }),
                  );
                } catch (_) {
                  /* storage disabled — run without persistence */
                }
              };

              // --- Persisted machine across swaps ----------------------------------
              // The mutable state (current state, forced flag, live timers) lives ONCE
              // on window so a re-init after a navigation continues the same machine
              // rather than resetting it. `state`/`forced` here are LOCAL working copies
              // seeded from the persisted machine; transition()/applyForced() write them
              // straight back to fsm so the next init reads them.
              // Typed accessor for the window-level machine (the project's idiom for
              // __bh* globals in bundled scripts — see CustomCursor.astro).
              const fsmWindow = window as unknown as { __bhHudFsm?: HudFsm };
              const fsm: HudFsm = (fsmWindow.__bhHudFsm = fsmWindow.__bhHudFsm || {
                state: 'idle', // 'idle' | 'booting' | 'ready'
                forced: false, // power-button override (orthogonal to state)
                bootEndTimer: 0,
                lineTimers: [],
                windowBound: false,
              });
              let state = fsm.state;
              let forced = fsm.forced;
              const lineTimers = fsm.lineTimers;

              const clearLineTimers = () => {
                while (lineTimers.length) window.clearTimeout(lineTimers.pop());
              };
              const setBootLine = (text: string): void => {
                if (bootLabel) bootLabel.textContent = text;
              };

              // Reflect `forced` onto the body + the power button's ARIA. The button
              // is a toggle for the FORCED override specifically; its LIT (gold) look
              // is keyed off body.hud-active in CSS so it reads ON whenever the HUD is
              // up, however it got there.
              const applyForced = () => {
                fsm.forced = forced;
                body.classList.toggle(FORCED_CLASS, forced);
                if (btn) btn.setAttribute('aria-pressed', forced ? 'true' : 'false');
              };

              // transition(next) — the ONLY place the state classes change. Each call
              // sets the body classes for `next`, schedules any timers that state
              // owns, and persists the resulting power state.
              const transition = (next: HudState): void => {
                if (next === state) return;
                // Leaving booting: always clear its timers so a fast power-off press
                // can cancel the loader cleanly.
                if (state === 'booting') {
                  window.clearTimeout(fsm.bootEndTimer);
                  clearLineTimers();
                }
                state = next;
                fsm.state = next;

                if (next === 'idle') {
                  body.classList.remove(BOOTING_CLASS);
                  body.classList.remove(ACTIVE_CLASS);
                  writeState(false, forced);
                  return;
                }

                if (next === 'booting') {
                  // HUD stays DARK while the loader plays: add booting, ensure active
                  // is OFF so the rail/compass/menu only ignite once booting → ready.
                  body.classList.remove(ACTIVE_CLASS);
                  body.classList.add(BOOTING_CLASS);
                  // Cycle the status lines across the boot window so the readout reads
                  // like a startup self-check. Spread evenly; the last line (SYSTEMS
                  // NOMINAL) lands just before ignition.
                  setBootLine(BOOT_LINES[0]);
                  if (!reduceMotion) {
                    for (let i = 1; i < BOOT_LINES.length; i++) {
                      const at = (bootMs * i) / BOOT_LINES.length;
                      lineTimers.push(window.setTimeout(() => setBootLine(BOOT_LINES[i]), at));
                    }
                  }
                  // Boot completes → ignite. Non-interruptible by scroll; a power-off
                  // press calls transition('idle') which clears this timer.
                  fsm.bootEndTimer = window.setTimeout(() => transition('ready'), bootMs);
                  writeState(true, forced); // intent: we are powering up to ready
                  return;
                }

                if (next === 'ready') {
                  // Boot finished (or restored): drop booting, light the HUD. NOW the
                  // rail cascade + compass + menu chrome ignite together.
                  body.classList.remove(BOOTING_CLASS);
                  body.classList.add(ACTIVE_CLASS);
                  writeState(true, forced);
                  return;
                }
              };

              // requestPowerOn — go to ready via the loader, unless we are already on
              // the way (booting) or there (ready). Skips the boot when restoring.
              const requestPowerOn = (skipBoot: boolean): void => {
                if (state === 'ready') return;
                if (skipBoot) {
                  // Restore path: land straight in ready so a returning visitor isn't
                  // marched through the 3.6s boot again.
                  transition('ready');
                  return;
                }
                if (state === 'booting') return; // already powering up
                transition('booting');
              };

              // requestPowerOff — return to idle. Booting cancels to idle (a power-off
              // press during boot aborts the loader); ready tears straight down.
              const requestPowerOff = () => {
                if (state === 'idle') return;
                transition('idle');
              };

              // --- Inputs ----------------------------------------------------------
              // The forced-override toggle, factored out so BOTH the window listener
              // and the once-per-node button listener invoke the SAME latest closure
              // (each init rewrites fsm.* to point at the current DOM). This keeps the
              // button correct even when its listener was bound on an earlier init.
              const toggleForced = (): void => {
                forced = !forced;
                applyForced();
                if (forced) requestPowerOn(false);
                else requestPowerOff();
              };

              // Expose the current closure's controls on fsm BEFORE binding listeners,
              // so they can always call the LATEST closure (re-pointed to the fresh DOM
              // by each initHudFsm() on astro:page-load).
              fsm.requestPowerOn = requestPowerOn;
              fsm.requestPowerOff = requestPowerOff;
              fsm.toggleForced = toggleForced;
              if (!fsm.windowBound) {
                fsm.windowBound = true;
                window.addEventListener(POWER_EVENT, (event: Event) => {
                  const detail = (event as CustomEvent<{ on?: boolean } | null>).detail;
                  if (!detail) return;
                  // Call the latest closure's power-on (fsm.requestPowerOn is rewritten
                  // by each init, so it always targets the current page's nodes). We do
                  // NOT re-run initHudFsm() here — that would re-add the per-init button
                  // listener and stack duplicates on a non-swapped (home-page) button.
                  if (detail.on && fsm.requestPowerOn) fsm.requestPowerOn(false);
                  // detail.on === false (scroll left the black hole) is deliberately a
                  // no-op: once booted the HUD stays lit until the power button powers
                  // it off. (The forced override would suppress it anyway.)
                });
              }

              // 2) Power button — toggles the forced override. The button node is
              //    REPLACED on every swap (fresh node = no prior listener), but
              //    initHudFsm() can also run twice against the SAME node on the very
              //    first paint (the direct call + astro:page-load). A per-node dataset
              //    flag makes the bind exactly-once per actual button element.
              if (btn && !btn.dataset.hudPowerBound) {
                btn.dataset.hudPowerBound = '1';
                // Invoke the LATEST closure via fsm so a node bound on an earlier init
                // still toggles the live machine (never the stale first-init locals).
                btn.addEventListener('click', () => {
                  if (fsmWindow.__bhHudFsm && fsmWindow.__bhHudFsm.toggleForced) {
                    fsmWindow.__bhHudFsm.toggleForced();
                  }
                });
              }

              // --- Init: restore persisted power state (apply classes ASAP, no flash).
              // On a swap this RE-APPLIES the live state to the fresh body/button: the
              // localStorage restore lands us in ready/idle without replaying the boot,
              // and applyForced() repaints the new button's ARIA + the body forced class.
              const persisted = readState();
              forced = persisted.forced;
              applyForced();
              if (persisted.powered) {
                // Returning visitor / post-swap with the HUD on: restore ready directly
                // (no replayed boot). If they had forced it on, forced is already set.
                // On a swap this also re-paints the fresh body with the active class
                // (transition() no-ops if state is already 'ready', so applyForced +
                // the body class are re-set below for that case).
                if (state === 'ready') {
                  // Already ready in-memory (mid-session swap): repaint the fresh body.
                  body.classList.remove(BOOTING_CLASS);
                  body.classList.add(ACTIVE_CLASS);
                } else {
                  requestPowerOn(true);
                }
              }
            }

            // Re-run on every ClientRouter navigation (fires on the initial load too),
            // so the FSM rebinds to each swapped-in body. Idempotent, so the extra
            // direct call on first paint below is harmless — it just guarantees the
            // classes are applied even if astro:page-load is missed on the very first
            // render.
            document.addEventListener('astro:page-load', initHudFsm);
            initHudFsm();
          </script>

          <main id="main-content" class="bare-main">
            <slot />
          </main>
        </Fragment>
      ) : (
        <div class="wrap">
          {/* First focusable element in the body: a skip link that jumps past
              the header / nav straight to the main content. */}
          <a href="#main-content" class="skip-link">Skip to main content</a>

          {/* Sub-page HUD nav (.subnav) — the standard reading-page header wearing
              the hero design language WITHOUT the live-scene coupling: no scroll-
              gated unfurl, no power button, no scene toggle. Brand lockup hard-left,
              section rail hard-right, sitting under a single top hairline rule.
              Labels are ALWAYS shown (there is no scene to power on); each section is
              a glyph + mono-uppercase label row. The CURRENT section is "locked": it
              gets the hero's target-lock treatment — corner ticks + a hairline frame,
              a brighter --fg, and a two-digit mono index — driven by aria-current. */}
          <header class="subnav" transition:name="subnav" transition:animate="none">
            <a class="subnav-brand bh-identity-lockup" href={href('')}>
              <span class="bh-identity-name">{BRAND_NAME}</span>
              <span class="bh-identity-role">{BRAND_ROLE}</span>
            </a>
            <nav class="subnav-rail" aria-label="Sections">
              {!minimalChrome && <ul class="subnav-list">
                {subnavItems.map((item, i) => (
                  <li class="subnav-item">
                    <a
                      class="subnav-link"
                      href={item.href}
                      aria-current={item.active ? 'page' : undefined}
                    >
                      {/* Target-lock frame — four corner ticks, only rendered/shown
                          on the locked (current) section (CSS hides them otherwise). */}
                      <span class="subnav-lock" aria-hidden="true">
                        <span class="subnav-tick subnav-tick-tl"></span>
                        <span class="subnav-tick subnav-tick-tr"></span>
                        <span class="subnav-tick subnav-tick-bl"></span>
                        <span class="subnav-tick subnav-tick-br"></span>
                      </span>
                      {/* Body·Section PAIR, mirroring the hero rail: the celestial
                          body is the bright title line, the section it links to is
                          the dim second line. */}
                      <span class="subnav-copy">
                        <span class="subnav-label">{item.label}</span>
                        <span class="subnav-section">{item.section}</span>
                      </span>
                      {/* Two-digit mono index — only shown on the locked section. */}
                      <span class="subnav-index" aria-hidden="true">{subnavIndex(i)}</span>
                    </a>
                  </li>
                ))}
              </ul>}

              {/* Brand-logo icon links — GitHub octocat + X logo, the SAME pair the
                  hero corner nav (.overlay-blog) shows, so the reading header reads
                  as the same instrument kit (not a second design). They carry
                  .subnav-link so they inherit the rail's colour, focus ring, and
                  hover lift; .subnav-social drops the cell padding + sizes the glyph.
                  The hero's POWER button is deliberately NOT mirrored here — there is
                  no live scene HUD to power on a reading page. */}
              {(SOCIALS.github || SOCIALS.twitter) && (
                <div class="subnav-socials">
                  {SOCIALS.github && (
                    <a class="subnav-link subnav-social" href={SOCIALS.github} aria-label="GitHub">
                      <svg class="subnav-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                      </svg>
                    </a>
                  )}
                  {SOCIALS.twitter && (
                    <a class="subnav-link subnav-social" href={SOCIALS.twitter} aria-label="X">
                      <svg class="subnav-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </nav>
          </header>

          <main id="main-content">
            <slot />
          </main>

          {/* Quiet instrument footer — one row in the subnav's language: top
              hairline, a mono copyright readout brand-side, small mono-uppercase
              link labels right (same underline-sweep hover as .subnav-link). Pinned
              across SPA swaps like the header (transition:name + animate none) so
              the chrome holds still while only the page content moves. */}
          <footer class="site-footer" transition:name="site-footer" transition:animate="none">
            {/* MINIMAL-CHROME pages moved the station nav out of the header; it
                lands here as a quiet full-width block ABOVE the copyright row —
                same Body·Section pairs, same source of truth (subnavItems), so
                the reader still has every station at the end of the page. */}
            {minimalChrome && (
              <nav class="site-footer-stations" aria-label="Sections">
                {subnavItems.map((item) => (
                  <a
                    class="site-footer-station"
                    href={item.href}
                    aria-current={item.active ? 'page' : undefined}
                  >
                    <span class="site-footer-station-label">{item.label}</span>
                    <span class="site-footer-station-section">{item.section}</span>
                  </a>
                ))}
              </nav>
            )}
            <span class="site-footer-brand">© {year} — {BRAND_NAME}</span>
            <nav class="site-footer-links" aria-label="Social links">
              {SOCIALS.github && <a href={SOCIALS.github}><span class="site-footer-label">GitHub</span></a>}
              {SOCIALS.twitter && <a href={SOCIALS.twitter}><span class="site-footer-label">Twitter</span></a>}
              {SOCIALS.email && <a href={`mailto:${SOCIALS.email}`}><span class="site-footer-label">Email</span></a>}
            </nav>
          </footer>
        </div>
      )
    }

    {/* RESURFACE — runs on every ClientRouter navigation (and the initial load).
        If we arrived via a dive (the sessionStorage flag set by HeroIsland), the
        persisted overlay is sitting at its capped soft bloom over the freshly-swapped
        page, so we ease it back out and play the content rise-up. Otherwise we make sure
        the overlay is hidden instantly (a normal nav must never flash). The flag is
        single-use (removed on read), so a manual reload of the destination never
        replays the resurface. Lives outside the bare/standard branches so it covers
        both. Bundled (no is:inline) so it re-binds across swaps.
        FRAMED GUARD: Astro DEV pre-loads destination pages that carry client:only
        islands (every post's backdrop) in a hidden same-origin IFRAME
        (prepareForClientOnlyComponents) to collect their styles — that iframe runs
        this script too, and its astro:page-load would CONSUME the single-use bh:dive
        flag from the SHARED sessionStorage before the real swap reads it (silently
        eating the resurface in dev; prod never builds the iframe). The site is never
        legitimately framed, so the listener simply doesn't bind when framed. */}
    <script>
      document.addEventListener('astro:page-load', () => {
        // Framed = the dev pre-load iframe (or a hostile embed): bail before the
        // flag read below so the real navigation still finds it intact.
        if (window.self !== window.top) return;
        const overlay = document.querySelector<HTMLElement>('[data-dive-overlay]');
        let dived = false;
        try {
          dived = sessionStorage.getItem('bh:dive') === '1';
          sessionStorage.removeItem('bh:dive');
        } catch (_) {
          /* private mode — no flag, treat as a normal nav */
        }
        if (!overlay) return;
        if (dived) {
          // Arriving from a dive: the overlay is sitting at its capped soft veil →
          // ease it out + rise the content. The body[data-resurface] attribute gates
          // the content keyframe in hero.css (and is auto-removed when that animation
          // ends). The recede is lengthened to 0.8s and reuses the project's eased
          // curve (--ease-out-quint, resolved from the computed root style so we don't
          // re-literalise the cubic-bezier) — a softer, gentler dissolve that matches
          // the lower-peak veil instead of the old abrupt 0.6s ease-out.
          const easeQuint =
            getComputedStyle(document.documentElement)
              .getPropertyValue('--ease-out-quint')
              .trim() || 'ease-out';
          overlay.style.transition = `opacity 0.8s ${easeQuint}`;
          requestAnimationFrame(() => {
            overlay.style.opacity = '0';
          });
          document.body.setAttribute('data-resurface', '');
          // Clear the attribute once the resurface animation finishes. animationend
          // BUBBLES, and the hero/HUD subtree fires many unrelated animations, so we
          // must filter to OUR keyframe (dive-resurface) — otherwise a stray child
          // animationend would strip data-resurface mid-rise and snap the content in.
          // Fallback timer id (assigned below): under reduced motion the resurface
          // keyframe is gated off in CSS, so our animationend never fires — the timer
          // clears the attribute and detaches so nothing lingers or leaks the listener.
          let fallback = 0;
          const onEnd = (e: AnimationEvent) => {
            if (e.animationName !== 'dive-resurface') return;
            document.body.removeAttribute('data-resurface');
            document.body.removeEventListener('animationend', onEnd);
            window.clearTimeout(fallback);
          };
          document.body.addEventListener('animationend', onEnd);
          fallback = window.setTimeout(() => {
            document.body.removeAttribute('data-resurface');
            document.body.removeEventListener('animationend', onEnd);
          }, 1200);
        } else {
          // Normal nav / fresh load: ensure the overlay is hidden with no fade so a
          // page that wasn't reached via a dive never shows the white layer.
          overlay.style.transition = 'none';
          overlay.style.opacity = '0';
        }
        // Clear the per-state bloom tint + origin in BOTH branches. The overlay is
        // transition:persist'ed across swaps, so a stale data-bloom-state / --bloom-x/y
        // would otherwise carry the previous dive's hue + off-centre origin into the
        // NEXT dive's opening frame (and any normal nav). Reset to the defaults: the
        // warm-bone --bloom-active and a centred origin (the CSS fallbacks).
        delete overlay.dataset.bloomState;
        overlay.style.removeProperty('--bloom-x');
        overlay.style.removeProperty('--bloom-y');
      });
    </script>

    {/* NAVIGATION CHOREOGRAPHY ARBITER — one before-swap hook that decides which
        motion system owns each ClientRouter navigation (see transitions.css):
          • Every SPA nav stamps html[data-astro-nav] onto the INCOMING document
            (swapRootAttributes copies it to the live root), which gates the
            hard-load entrance choreography OFF — the view-transition settle/rise
            owns SPA arrivals, so the two moves can never stack into a double rise.
          • A DIVE nav (the bh:dive sessionStorage flag HeroIsland sets before
            navigate()) already has its own choreography — the bloom veil covers
            the swap and dive-resurface plays on arrival — so the view-transition
            is skipped outright (skipTransition: the swap still happens, just with
            no snapshot animation doubling up under the bloom). The flag is only
            READ here; the astro:page-load resurface handler above still consumes
            (removes) it. Bundled (no is:inline) so it re-binds across swaps;
            document-level listener, bound once per script execution. Framed
            (the dev pre-load iframe — see the resurface script) never navigates,
            but the guard keeps the two scripts' behaviour symmetric.
          • A NON-DIVE nav resets the persisted overlay here (opacity 0, bloom
            state/origin cleared) so a back-nav to '/' can never inherit a stale
            veil from a prior dive — even if astro:page-load fires late or the
            dev pre-load iframe ate the page-load event. The dived path owns its
            own overlay choreography and is left untouched. */}
    <script>
      document.addEventListener('astro:before-swap', (event) => {
        if (window.self !== window.top) return;
        event.newDocument.documentElement.setAttribute('data-astro-nav', '');
        let dived = false;
        try {
          dived = sessionStorage.getItem('bh:dive') === '1';
        } catch (_) {
          /* private mode — treat as a normal nav */
        }
        if (dived && event.viewTransition) {
          // Skipping rejects the native transition's `ready` promise (AbortError
          // "Transition was skipped") and nothing else awaits it — swallow it so
          // every dive doesn't log an unhandled rejection.
          event.viewTransition.ready.catch(() => {});
          event.viewTransition.skipTransition();
        }
        if (!dived) {
          // Reset the transition:persist'd overlay before the swap so the
          // incoming page starts clean regardless of how the previous page
          // left it. The dived path owns its own choreography; leave it alone.
          const overlay = document.querySelector<HTMLElement>('[data-dive-overlay]');
          if (overlay) {
            overlay.style.transition = 'none';
            overlay.style.opacity = '0';
            delete overlay.dataset.bloomState;
            overlay.style.removeProperty('--bloom-x');
            overlay.style.removeProperty('--bloom-y');
          }
        }
      });
    </script>
  </body>
</html>
