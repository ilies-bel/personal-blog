---
import BaseHead from '../components/BaseHead.astro';
// Sitewide custom cursor: a quiet off-white dot that becomes a hexagon outline
// over interactive elements. Mounted once here so it covers every page (both the
// `bare` home and the standard reading pages). Self-contained — see the file.
import CustomCursor from '../components/CustomCursor.astro';
// Astro SPA navigation. Mounted sitewide so the cinematic marker dive can swap to
// the destination article with NO full-page reload flash (the dive bloom covers the
// swap and the destination "resurfaces" from under the receding white). Nodes marked
// transition:persist (the dive overlay, the custom cursor) survive each swap.
import { ClientRouter } from 'astro:transitions';
import { SITE_LANG, SOCIALS, BRAND_NAME, BRAND_ROLE } from '../consts';
// THE site navigation — one canonical model (SITE_NAV_ITEMS in sceneTable.ts)
// rendered by one component on both layout branches: the bare-page corner
// overlay (home/about) and the reading-page rail. SiteNav owns the item set,
// order, wording, and active-state logic; this layout only picks the surface.
import SiteNav from '../components/SiteNav.astro';
// The sitewide type system: Space Grotesk (display 700 / body 400), IBM Plex
// Mono (labels, dates, tags), Instrument Serif italic (quote / signature accent).
// Self-hosted woff2 + bundled by Vite — no render-blocking CDN request. The faces
// live in fonts.css; they're applied sitewide via the --font-* tokens in global.css.
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  // `bare` strips the standard reading chrome (gutter shell + footer) and shows
  // only the fixed corner overlay: brand top-left, the blog micro-nav top-right.
  // Used by the home page, whose whole canvas is the scroll-scrubbed scene.
  bare?: boolean;
  // Optional extra class on <body>. Lets a bare page (e.g. About) opt into its
  // own chrome variant — 'about-page' shows the top-left wordmark and switches
  // the corner nav to its static skin (always lit, Close instead of the power
  // button) — see isAboutOverlay below + body.bare.about-page in scene.css.
  bodyClass?: string;
}

const props = Astro.props;
const { bare = false, bodyClass } = props;
const bodyClasses = [bare ? 'bare' : null, bodyClass].filter(Boolean).join(' ') || undefined;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
const year = new Date().getFullYear();

// True-path match for footer links (trailing-slash insensitive) — aria-current
// only ever marks the page the visitor is actually on.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrentPage = (p: string) =>
  (href(p).replace(/\/+$/, '') || '/') === currentPath;

// The About overlay is the one bare page that is NOT the live scene: its nav
// renders statically lit (no boot gate), swaps the power button for a Close
// control, and marks its own section current. Derived from the body class the
// page already passes, so the layout API stays unchanged.
const isAboutOverlay = (bodyClass ?? '').split(/\s+/).includes('about-page');

---

<!doctype html>
<html lang={SITE_LANG} class={bare ? 'is-bare' : undefined}>
  <head>
    <BaseHead {...props} />
    <ClientRouter />
  </head>
  <body class={bodyClasses}>
    {/* Cinematic dive overlay — a single full-viewport bloom layer present on EVERY
        page, persisted across ClientRouter swaps (transition:persist) so the home
        page's dive can ramp its opacity to a soft, capped veil (never full white) — in
        the FIRING marker's lifecycle-state tint, set via data-bloom-state — the
        navigation swaps the page body UNDER it, and the destination's page-load handler
        eases it back out for the "resurface" (and clears the tint so the next nav starts
        clean). Starts hidden via CSS (opacity 0), so a normal page load / navigation
        never sees it. */}
    <div class="dive-overlay" data-dive-overlay transition:persist aria-hidden="true"></div>
    {/* Hyperspace warp overlay — a full-viewport canvas that renders the Star-Wars
        "jump to lightspeed" streaks when navigating INTO the About page. Persisted
        across the ClientRouter swap (transition:persist) exactly like the dive
        overlay, so the SAME canvas keeps animating straight across the navigation:
        the jump-out on the origin page and the drop-in on About are one continuous
        render loop. Driven entirely by src/scripts/warpTransition.ts; starts blank
        (nothing drawn) so a normal load never shows it. */}
    <canvas class="warp-overlay" data-warp-overlay transition:persist aria-hidden="true"></canvas>
    {/* Warp readout — the bottom-centre cockpit callout that narrates the jump
        ("ENGAGING HYPERDRIVE" → "BEGINNING LIGHTSPEED TRAVEL" → "PUNCH IT"). It
        reuses the HUD compass's mono type + bottom-centre slot (hud.css) so it
        reads as the same instrument, and is persisted across the swap like the
        canvas. Hidden until warpTransition.ts sets data-warp-readout-active. */}
    <div class="warp-readout hud-compass" data-warp-readout transition:persist aria-hidden="true">
      <p class="hud-compass-read">
        <span class="hud-compass-prompt">[ </span>
        <span class="hud-compass-label" data-warp-label>ENGAGING HYPERDRIVE</span>
        <span class="hud-compass-prompt"> ]</span>
      </p>
    </div>
    {/* Sitewide custom cursor — covers both layout branches below. */}
    <CustomCursor />
    {
      bare ? (
        <Fragment>
          {/* First focusable element in the body: a skip link that jumps past
              the corner chrome / scene canvas straight to the main content. */}
          <a href="#main-content" class="skip-link">Skip to main content</a>

          {/* Fixed corner overlay: identity top-left, the blog micro-nav
              top-right. Everything else is the scene canvas behind it. */}
          <a class="overlay-brand bh-identity-lockup" href={href('')}>
            <span class="bh-identity-name">{BRAND_NAME}</span>
            <span class="bh-identity-role">{BRAND_ROLE}</span>
          </a>

          {/* The corner nav, top-right — THE site navigation in its scene skin
              (see SiteNav.astro): the five canonical sections as quiet mono
              labels that dim at rest and brighten/lift once the HUD activates
              at the black hole, plus the GitHub/X brand links. On the home
              scene it carries the HUD power button; on the About overlay it is
              statically lit, swaps the power button for a Close control, and
              locks its own section. */}
          <SiteNav
            surface="scene"
            showPower={!isAboutOverlay}
            isStatic={isAboutOverlay}
            showSceneToggle={isAboutOverlay}
          />

          {/* Boot transition layers — driven entirely by body.hud-booting (added for
              the ~3.6s power-on window by the FSM script below). Fixed, full-
              viewport, pointer-events:none layers + a bottom-centre readout, all CSS-
              off the body class (see hud.css → "HUD boot sequence"); aria-hidden so
              none of it ever announces:
                • .hud-boot-flicker — a light layer that surges/settles (power surge).
                • .hud-boot-static  — VHS tape-static field: faint grayscale grain
                                      over the whole frame, shuffling in steps,
                                      loud while the signal acquires, dead by
                                      ignition.
                      (The other VHS layer — tracking slips — needs no element:
                      hud.css steps the scene CANVAS itself sideways, so the
                      picture jumps like a deck hunting for tracking.)
                • .hud-boot-panels  — the cockpit BEZEL: four edge seams that etch in
                                      clockwise around the viewport (a current tracing
                                      the canopy frame) with corner joints that weld
                                      lit as the trace passes; fades out at ignition.
                • .hud-boot         — the status readout + a stuttering progress bar.
              The .hud-boot-label TEXT is swapped by the FSM through the boot window
              (LOADING → CALIBRATING → ALIGNING → SYSTEMS NOMINAL) so the readout
              reads like a machine running its start-up self-check. */}
          <div class="hud-boot-flicker" aria-hidden="true"></div>
          <div class="hud-boot-static" aria-hidden="true"></div>
          <div class="hud-boot-panels" aria-hidden="true">
            <span class="hud-boot-seam" data-edge="top"></span>
            <span class="hud-boot-seam" data-edge="right"></span>
            <span class="hud-boot-seam" data-edge="bottom"></span>
            <span class="hud-boot-seam" data-edge="left"></span>
            <span class="hud-boot-joint" data-corner="tl"></span>
            <span class="hud-boot-joint" data-corner="tr"></span>
            <span class="hud-boot-joint" data-corner="br"></span>
            <span class="hud-boot-joint" data-corner="bl"></span>
          </div>
          <div class="hud-boot" aria-hidden="true">
            <span class="hud-boot-label">LOADING</span>
            <span class="hud-boot-bar"></span>
          </div>

          {/* HUD POWER STATE MACHINE — the single, explicit owner of the HUD's body
              classes and its power sequences. A self-contained, zero-import bundled
              <script> (mirrors the project's CustomCursor convention) so it runs the
              moment the body parses, with no framework on the critical path.

              The machine has four states:
                • idle          — HUD off (observation deck: the spectacle, minimal chrome).
                • booting       — the power-ON sequence is playing (body.hud-booting).
                • ready         — HUD fully lit (body.hud-active → cockpit: instruments up).
                • shutting-down — the power-OFF sequence is playing (body.hud-shutting-down):
                                  the boot layers run IN REVERSE, then we land in idle.

              THE CONTRACT — "off by default; the pilot can power it up":
                • The HUD is OFF BY DEFAULT. A first-time visitor (and any visitor
                  whose storage can't record a choice — private mode) lands in `idle`
                  (dark, no boot sequence). The boot only plays when they power the HUD
                  ON. Scroll never drives power at all.
                • The power button toggles ONE bit: powered. One click, always. Its
                  aria-pressed mirrors the machine state (pressed = booting|ready), so
                  the button always reads exactly as lit as the HUD is.
                • Powering ON plays the boot sequence (booting → ready). Powering OFF
                  plays that same sequence IN REVERSE (ready → shutting-down → idle) —
                  the animation runs BOTH ways, symmetric.
                • The state persists: a returning visitor lands straight in `ready` or
                  `idle` exactly as they left it — no replayed sequence either way.

              transition(next) is the ONLY place body classes are mutated; it also
              mirrors { powered } to localStorage, restored on init.

              The class-string + storage-key literals below are the same ones
              centralized in src/hero/lib/constants.ts — this bundled island can't
              import that module, so the literals are spelled here and MUST be kept in
              sync with that file. Likewise BOOT_MS mirrors HUD_BOOT_DURATION_MS and is
              pushed into --hud-boot-dur so the CSS animation length can never drift
              from the JS timer (the shutdown reuses the SAME window, reversed). */}
          <script>
            // NOTE: this is a BUNDLED script (no `is:inline`) so it can re-run on
            // every ClientRouter swap. ClientRouter replaces document.body (and with
            // it the power button + boot-label nodes) on each navigation, so the FSM
            // is wrapped in an idempotent initHudFsm() that RE-QUERIES those nodes each
            // call and re-applies the persisted/current state to the fresh DOM. The
            // machine state itself (state / timers) lives ONCE on window.__bhHudFsm so
            // a re-init reuses it, and the per-node button listener is bound a single
            // time per actual button element across swaps.
            type HudState = 'idle' | 'booting' | 'ready' | 'shutting-down';
            // The machine state persisted on window across ClientRouter swaps. The
            // control function (togglePower) is re-pointed to the current DOM by each
            // init, so the once-per-node button listener always drives the live page.
            interface HudFsm {
              state: HudState;
              /** The pending boot→ready / shutdown→idle timer (0 when none). */
              seqEndTimer: number;
              lineTimers: number[];
              togglePower?: () => void;
            }
            function initHudFsm(): void {
              // --- Centralized literals (mirror src/hero/lib/constants.ts) ---------
              const ACTIVE_CLASS = 'hud-active'; // HUD_ACTIVE_BODY_CLASS  (ready)
              const BOOTING_CLASS = 'hud-booting'; // HUD_BOOTING_BODY_CLASS (booting)
              const SHUTDOWN_CLASS = 'hud-shutting-down'; // power-off (boot layers, reversed)
              const STATE_KEY = 'hud-state'; // HUD_STATE_STORAGE_KEY
              const BOOT_MS = 3600; // HUD_BOOT_DURATION_MS — keep in sync with --hud-boot-dur

              // RE-QUERY the per-swap DOM each init. body / btn / bootLabel are all
              // replaced when ClientRouter swaps the document, so capturing them once
              // (the old behaviour) would leave the FSM pointing at detached nodes.
              const body = document.body;
              const root = document.documentElement;
              const btn = document.querySelector<HTMLButtonElement>('.overlay-blog-power');
              const bootLabel = document.querySelector<HTMLElement>('.hud-boot-label');

              // Honour the OS reduced-motion preference: under it the sequence is a
              // calm, brief readout (no flicker/scan/stutter — those are dropped in
              // CSS) and we shorten the JS window so the readout doesn't linger.
              const reduceMotion =
                window.matchMedia &&
                window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              const seqMs = reduceMotion ? 700 : BOOT_MS;

              // Push the boot duration into the CSS var so the bar/flicker/scan
              // animation lengths track the JS timer from a single source (the
              // shutdown reuses the same layers reversed, so it shares this window).
              root.style.setProperty('--hud-boot-dur', BOOT_MS + 'ms');

              // The machine-startup status lines, cycled through the boot window so the
              // readout reads like a system check, not a flat bar. On power-OFF they
              // play in reverse (SYSTEMS NOMINAL → LOADING) so the readout counts down.
              const BOOT_LINES = ['LOADING', 'CALIBRATING', 'ALIGNING ARRAY', 'SYSTEMS NOMINAL'];

              // --- Persistence (try/catch — private mode must never throw) ---------
              // Blob shape: { powered }. Absence of a blob means FIRST VISIT → the HUD
              // defaults OFF (see init below). A thrown read (private mode / disabled
              // storage) is likewise `null` → OFF, so an incognito visitor lands dark.
              // Legacy blobs carried extra flags (forced / userChosen); we simply
              // ignore them and read `powered`.
              const readPowered = (): boolean | null => {
                try {
                  const raw = window.localStorage.getItem(STATE_KEY);
                  if (!raw) return null; // no choice recorded → default OFF
                  return JSON.parse(raw).powered === true;
                } catch (_) {
                  return null;
                }
              };
              const writePowered = (powered: boolean): void => {
                try {
                  window.localStorage.setItem(STATE_KEY, JSON.stringify({ powered: powered }));
                } catch (_) {
                  /* storage disabled — run without persistence */
                }
              };

              // --- Persisted machine across swaps ----------------------------------
              // The mutable state (current state, live timers) lives ONCE on window so
              // a re-init after a navigation continues the same machine rather than
              // resetting it. `state` here is a LOCAL working copy seeded from the
              // persisted machine; transition() writes it straight back to fsm so the
              // next init reads it. Typed accessor for the window-level machine (the
              // project's idiom for __bh* globals — see CustomCursor.astro).
              const fsmWindow = window as unknown as { __bhHudFsm?: HudFsm };
              const fsm: HudFsm = (fsmWindow.__bhHudFsm = fsmWindow.__bhHudFsm || {
                state: 'idle', // off by default; overridden below if storage says ready
                seqEndTimer: 0,
                lineTimers: [],
              });
              let state = fsm.state;
              const lineTimers = fsm.lineTimers;

              const clearLineTimers = () => {
                while (lineTimers.length) window.clearTimeout(lineTimers.pop());
              };
              const setBootLine = (text: string): void => {
                if (bootLabel) bootLabel.textContent = text;
              };
              // Schedule the status-line cadence across the sequence window. `reverse`
              // counts the lines down (power-off) instead of up (power-on).
              const scheduleBootLines = (reverse: boolean): void => {
                const lines = reverse ? BOOT_LINES.slice().reverse() : BOOT_LINES;
                setBootLine(lines[0]);
                if (reduceMotion) return;
                for (let i = 1; i < lines.length; i++) {
                  const at = (seqMs * i) / lines.length;
                  lineTimers.push(window.setTimeout(() => setBootLine(lines[i]), at));
                }
              };

              // Mirror the MACHINE state onto the power button's ARIA: pressed while
              // powering up or lit (booting | ready), released while shutting down or
              // off (shutting-down | idle) — so aria-pressed tracks the DESTINATION the
              // sequence is heading to. Matches the CSS, which lights the button gold
              // off body.hud-active / hud-booting. Called from every transition() + init.
              const applyPressed = () => {
                if (btn) {
                  const lit = state === 'booting' || state === 'ready';
                  btn.setAttribute('aria-pressed', lit ? 'true' : 'false');
                }
              };

              // transition(next) — the ONLY place the state classes change. Each call
              // sets the body classes for `next`, schedules any timers that state owns,
              // and persists the resulting power INTENT.
              const transition = (next: HudState): void => {
                if (next === state) return;
                // Leaving a sequence state: clear its timers so a fast opposite press
                // can cancel the in-flight boot/shutdown cleanly.
                if (state === 'booting' || state === 'shutting-down') {
                  window.clearTimeout(fsm.seqEndTimer);
                  clearLineTimers();
                }
                state = next;
                fsm.state = next;
                applyPressed();

                if (next === 'idle') {
                  body.classList.remove(BOOTING_CLASS, SHUTDOWN_CLASS, ACTIVE_CLASS);
                  writePowered(false);
                  return;
                }

                if (next === 'booting') {
                  // HUD stays DARK while the boot plays: add booting, ensure active +
                  // shutdown are OFF so the rail/compass/menu only ignite booting → ready.
                  body.classList.remove(ACTIVE_CLASS, SHUTDOWN_CLASS);
                  body.classList.add(BOOTING_CLASS);
                  scheduleBootLines(false); // LOADING → SYSTEMS NOMINAL
                  // Boot completes → ignite. A power-off press calls transition('shutting-down')
                  // which clears this timer.
                  fsm.seqEndTimer = window.setTimeout(() => transition('ready'), seqMs);
                  writePowered(true); // intent: we are powering up to ready
                  return;
                }

                if (next === 'shutting-down') {
                  // Power-OFF sequence: the SAME boot layers, played in reverse (CSS
                  // off body.hud-shutting-down). The HUD chrome goes dark immediately
                  // (drop active) while the reversed loader plays out, then we land idle.
                  body.classList.remove(ACTIVE_CLASS, BOOTING_CLASS);
                  body.classList.add(SHUTDOWN_CLASS);
                  scheduleBootLines(true); // SYSTEMS NOMINAL → LOADING (counting down)
                  fsm.seqEndTimer = window.setTimeout(() => transition('idle'), seqMs);
                  writePowered(false); // intent: we are powering down to idle
                  return;
                }

                if (next === 'ready') {
                  // Boot finished (or restored): drop the sequence classes, light the
                  // HUD. NOW the rail cascade + compass + menu chrome ignite together.
                  body.classList.remove(BOOTING_CLASS, SHUTDOWN_CLASS);
                  body.classList.add(ACTIVE_CLASS);
                  writePowered(true);
                  return;
                }
              };

              // --- Input: the power toggle. ONE bit, one click. Powering ON plays the
              // boot (idle/shutting-down → booting → ready); powering OFF plays it in
              // reverse (ready/booting → shutting-down → idle). Pressing mid-sequence
              // reverses course: a press during booting starts the shutdown, a press
              // during shutting-down starts the boot. Factored onto fsm so the
              // once-per-node button listener always invokes the LATEST closure (each
              // init rewrites fsm.togglePower to point at the current DOM).
              const togglePower = (): void => {
                if (state === 'ready' || state === 'booting') transition('shutting-down');
                else transition('booting'); // idle | shutting-down → power up
              };
              fsm.togglePower = togglePower;

              // Power button — toggles the power state. The button node is REPLACED on
              // every swap (fresh node = no prior listener), but initHudFsm() can also
              // run twice against the SAME node on the very first paint (the direct
              // call + astro:page-load). A per-node dataset flag makes the bind
              // exactly-once per actual button element.
              if (btn && !btn.dataset.hudPowerBound) {
                btn.dataset.hudPowerBound = '1';
                // Invoke the LATEST closure via fsm so a node bound on an earlier init
                // still toggles the live machine (never a stale first-init local).
                btn.addEventListener('click', () => {
                  if (fsmWindow.__bhHudFsm && fsmWindow.__bhHudFsm.togglePower) {
                    fsmWindow.__bhHudFsm.togglePower();
                  }
                });
              }

              // --- Init: apply the resting power state to the (possibly fresh) DOM,
              // no flash and no replayed sequence. On a swap this RE-APPLIES the live
              // state to the fresh body/button. First visit (no stored choice) defaults
              // the HUD OFF. A mid-sequence swap (booting/shutting-down) is rare, but we
              // settle it to its destination rather than leave the loader half-drawn on
              // a brand-new body that never scheduled its timers.
              const stored = readPowered(); // true | false | null(first visit → OFF)
              const powered = stored === true; // only an explicit stored ON powers up
              if (powered) {
                // Land straight in ready (returning-lit visitor, or repainting a
                // mid-boot swap onto the fresh body — no replayed boot).
                state = 'ready';
                fsm.state = 'ready';
                body.classList.remove(BOOTING_CLASS, SHUTDOWN_CLASS);
                body.classList.add(ACTIVE_CLASS);
              } else {
                // Default-off first visit, private mode, or a stored OFF: land dark.
                // Also repaints a mid-shutdown swap straight to idle.
                state = 'idle';
                fsm.state = 'idle';
                body.classList.remove(BOOTING_CLASS, SHUTDOWN_CLASS, ACTIVE_CLASS);
              }
              // Repaint the fresh button's ARIA whatever path we took.
              applyPressed();
            }

            // Re-run on every ClientRouter navigation (fires on the initial load too),
            // so the FSM rebinds to each swapped-in body. Idempotent, so the extra
            // direct call on first paint below is harmless — it just guarantees the
            // classes are applied even if astro:page-load is missed on the very first
            // render.
            document.addEventListener('astro:page-load', initHudFsm);
            initHudFsm();
          </script>

          <main id="main-content" class="bare-main">
            <slot />
          </main>
        </Fragment>
      ) : (
        <div class="wrap">
          {/* First focusable element in the body: a skip link that jumps past
              the header / nav straight to the main content. */}
          <a href="#main-content" class="skip-link">Skip to main content</a>

          {/* Sub-page HUD nav (.subnav) — the standard reading-page header wearing
              the hero design language WITHOUT the live-scene coupling: no scroll-
              gated unfurl, no power button, no scene toggle. Brand lockup hard-left;
              the section rail hard-right is THE site navigation in its page skin
              (SiteNav.astro) — same five sections, same order, same wording as the
              hero corner nav, destination bright over its celestial body dim. The
              CURRENT section is "locked": corner ticks, brighter --fg, and a
              two-digit mono index — driven by aria-current. */}
          <header class="subnav" transition:name="subnav" transition:animate="none">
            <a class="subnav-brand bh-identity-lockup" href={href('')}>
              <span class="bh-identity-name">{BRAND_NAME}</span>
              <span class="bh-identity-role">{BRAND_ROLE}</span>
            </a>
            <SiteNav surface="page" />
          </header>

          <main id="main-content">
            <slot />
          </main>

          {/* Quiet instrument footer — one row in the subnav's language: top
              hairline, a mono copyright readout brand-side, small mono-uppercase
              link labels right (same underline-sweep hover as .subnav-link). Pinned
              across SPA swaps like the header (transition:name + animate none) so
              the chrome holds still while only the page content moves. Carries the
              two social profiles plus the Behind the Build case study, surfaced
              site-wide. */}
          <footer class="site-footer" transition:name="site-footer" transition:animate="none">
            <span class="site-footer-brand">© {year} — {BRAND_NAME}</span>
            <nav class="site-footer-links" aria-label="Footer links">
              {SOCIALS.github && <a href={SOCIALS.github}><span class="site-footer-label" data-decode>GitHub</span></a>}
              {SOCIALS.twitter && <a href={SOCIALS.twitter}><span class="site-footer-label" data-decode>Twitter</span></a>}
              <a
                href={href('behind-the-build')}
                aria-current={isCurrentPage('behind-the-build') ? 'page' : undefined}
              ><span class="site-footer-label" data-decode>Behind the build</span></a>
            </nav>
          </footer>
        </div>
      )
    }

    {/* RESURFACE — runs on every ClientRouter navigation (and the initial load).
        If we arrived via a dive (the sessionStorage flag set by HeroIsland), the
        persisted overlay is sitting at its capped soft bloom over the freshly-swapped
        page, so we ease it back out and play the content rise-up. Otherwise we make sure
        the overlay is hidden instantly (a normal nav must never flash). The flag is
        single-use (removed on read), so a manual reload of the destination never
        replays the resurface. Lives outside the bare/standard branches so it covers
        both. Bundled (no is:inline) so it re-binds across swaps.
        FRAMED GUARD: Astro DEV pre-loads destination pages that carry client:only
        islands (every post's backdrop) in a hidden same-origin IFRAME
        (prepareForClientOnlyComponents) to collect their styles — that iframe runs
        this script too, and its astro:page-load would CONSUME the single-use bh:dive
        flag from the SHARED sessionStorage before the real swap reads it (silently
        eating the resurface in dev; prod never builds the iframe). The site is never
        legitimately framed, so the listener simply doesn't bind when framed. */}
    <script>
      document.addEventListener('astro:page-load', () => {
        // Framed = the dev pre-load iframe (or a hostile embed): bail before the
        // flag read below so the real navigation still finds it intact.
        if (window.self !== window.top) return;
        const overlay = document.querySelector<HTMLElement>('[data-dive-overlay]');
        let dived = false;
        try {
          dived = sessionStorage.getItem('bh:dive') === '1';
          sessionStorage.removeItem('bh:dive');
        } catch (_) {
          /* private mode — no flag, treat as a normal nav */
        }
        if (!overlay) return;
        if (dived) {
          // Arriving from a dive: the overlay is sitting at its capped soft veil →
          // ease it out + rise the content. The body[data-resurface] attribute gates
          // the content keyframe in hero.css (and is auto-removed when that animation
          // ends). The recede is lengthened to 0.8s and reuses the project's eased
          // curve (--ease-out-quint, resolved from the computed root style so we don't
          // re-literalise the cubic-bezier) — a softer, gentler dissolve that matches
          // the lower-peak veil instead of the old abrupt 0.6s ease-out.
          const easeQuint =
            getComputedStyle(document.documentElement)
              .getPropertyValue('--ease-out-quint')
              .trim() || 'ease-out';
          overlay.style.transition = `opacity 0.8s ${easeQuint}`;
          requestAnimationFrame(() => {
            overlay.style.opacity = '0';
          });
          document.body.setAttribute('data-resurface', '');
          // Clear the attribute once the resurface animation finishes. animationend
          // BUBBLES, and the hero/HUD subtree fires many unrelated animations, so we
          // must filter to OUR keyframe (dive-resurface) — otherwise a stray child
          // animationend would strip data-resurface mid-rise and snap the content in.
          // Fallback timer id (assigned below): under reduced motion the resurface
          // keyframe is gated off in CSS, so our animationend never fires — the timer
          // clears the attribute and detaches so nothing lingers or leaks the listener.
          let fallback = 0;
          const onEnd = (e: AnimationEvent) => {
            if (e.animationName !== 'dive-resurface') return;
            document.body.removeAttribute('data-resurface');
            document.body.removeEventListener('animationend', onEnd);
            window.clearTimeout(fallback);
          };
          document.body.addEventListener('animationend', onEnd);
          fallback = window.setTimeout(() => {
            document.body.removeAttribute('data-resurface');
            document.body.removeEventListener('animationend', onEnd);
          }, 1200);
        } else {
          // Normal nav / fresh load: ensure the overlay is hidden with no fade so a
          // page that wasn't reached via a dive never shows the white layer.
          overlay.style.transition = 'none';
          overlay.style.opacity = '0';
        }
        // Clear the per-state bloom tint + origin in BOTH branches. The overlay is
        // transition:persist'ed across swaps, so a stale data-bloom-state / --bloom-x/y
        // would otherwise carry the previous dive's hue + off-centre origin into the
        // NEXT dive's opening frame (and any normal nav). Reset to the defaults: the
        // warm-bone --bloom-active and a centred origin (the CSS fallbacks).
        delete overlay.dataset.bloomState;
        overlay.style.removeProperty('--bloom-x');
        overlay.style.removeProperty('--bloom-y');
      });
    </script>

    {/* NAVIGATION CHOREOGRAPHY ARBITER — one before-swap hook that decides which
        motion system owns each ClientRouter navigation (see transitions.css):
          • Every SPA nav stamps html[data-astro-nav] onto the INCOMING document
            (swapRootAttributes copies it to the live root), which gates the
            hard-load entrance choreography OFF — the view-transition settle/rise
            owns SPA arrivals, so the two moves can never stack into a double rise.
          • A DIVE nav (the bh:dive sessionStorage flag HeroIsland sets before
            navigate()) already has its own choreography — the bloom veil covers
            the swap and dive-resurface plays on arrival — so the view-transition
            is skipped outright (skipTransition: the swap still happens, just with
            no snapshot animation doubling up under the bloom). The flag is only
            READ here; the astro:page-load resurface handler above still consumes
            (removes) it. Bundled (no is:inline) so it re-binds across swaps;
            document-level listener, bound once per script execution. Framed
            (the dev pre-load iframe — see the resurface script) never navigates,
            but the guard keeps the two scripts' behaviour symmetric.
          • A NON-DIVE nav resets the persisted overlay here (opacity 0, bloom
            state/origin cleared) so a back-nav to '/' can never inherit a stale
            veil from a prior dive — even if astro:page-load fires late or the
            dev pre-load iframe ate the page-load event. The dived path owns its
            own overlay choreography and is left untouched. */}
    {/* DECODE HOVER — the sitewide scramble-resolve gesture for mono labels
        ([data-decode]). One delegated listener pair on `document`, bound once;
        see src/scripts/decodeHover.ts for the rules (mono-only, pointer-only,
        reduced-motion no-op, original text always restored). */}
    <script>
      import '../scripts/decodeHover';
      // Scene toggle — the circular corner control that parks the backdrop
      // scenes sitewide (body.backdrop-off), persisted across visits/swaps.
      import '../scripts/sceneToggle';
      // Warp transition — the hyperspace-streak jump into the About page. One
      // capture-phase click listener claims About links and drives the persisted
      // .warp-overlay canvas across the swap (jump-out → nav → decelerate-in).
      import '../scripts/warpTransition';
    </script>

    <script>
      document.addEventListener('astro:before-swap', (event) => {
        if (window.self !== window.top) return;
        event.newDocument.documentElement.setAttribute('data-astro-nav', '');
        let dived = false;
        let warped = false;
        try {
          dived = sessionStorage.getItem('bh:dive') === '1';
          // The warp jump owns its own choreography (the hyperspace-streak canvas
          // in warpTransition.ts covers the swap), so like a dive it must SKIP the
          // native view-transition — otherwise a snapshot cross-fade would double
          // up under the streaks. The flag is only READ here; warpTransition's
          // page-load handler consumes (removes) it on arrival.
          warped = sessionStorage.getItem('bh:warp') === '1';
        } catch (_) {
          /* private mode — treat as a normal nav */
        }
        if ((dived || warped) && event.viewTransition) {
          // Skipping rejects the native transition's `ready` promise (AbortError
          // "Transition was skipped") and nothing else awaits it — swallow it so
          // every dive/warp doesn't log an unhandled rejection.
          event.viewTransition.ready.catch(() => {});
          event.viewTransition.skipTransition();
        }
        if (!dived) {
          // Reset the transition:persist'd overlay before the swap so the
          // incoming page starts clean regardless of how the previous page
          // left it. The dived path owns its own choreography; leave it alone.
          const overlay = document.querySelector<HTMLElement>('[data-dive-overlay]');
          if (overlay) {
            overlay.style.transition = 'none';
            overlay.style.opacity = '0';
            delete overlay.dataset.bloomState;
            overlay.style.removeProperty('--bloom-x');
            overlay.style.removeProperty('--bloom-y');
          }
        }
      });
    </script>
  </body>
</html>
