              {SOCIALS.email && <a href={`mailto:${SOCIALS.email}`}>email</a>}
            </span>
          </footer>
        </div>
      )
    }

    {/* RESURFACE — runs on every ClientRouter navigation (and the initial load).
        If we arrived via a dive (the sessionStorage flag set by HeroIsland), the
        persisted overlay is sitting at full white over the freshly-swapped page, so
        we ease it back out and play the content rise-up. Otherwise we make sure the
        overlay is hidden instantly (a normal nav must never flash white). The flag is
        single-use (removed on read), so a manual reload of the destination never
        replays the resurface. Lives outside the bare/standard branches so it covers
        both. Bundled (no is:inline) so it re-binds across swaps. */}
    <script>
      document.addEventListener('astro:page-load', () => {
        const overlay = document.querySelector<HTMLElement>('[data-dive-overlay]');
        let dived = false;
        try {
          dived = sessionStorage.getItem('bh:dive') === '1';
          sessionStorage.removeItem('bh:dive');
        } catch (_) {
          /* private mode — no flag, treat as a normal nav */
        }
        if (!overlay) return;
        if (dived) {
          // Arriving from a dive: overlay is full-white → ease it out + rise the
          // content. The body[data-resurface] attribute gates the content keyframe
          // in hero.css (and is auto-removed when that animation ends).
          overlay.style.transition = 'opacity 0.6s ease-out';
          requestAnimationFrame(() => {
            overlay.style.opacity = '0';
          });
          document.body.setAttribute('data-resurface', '');
          // Clear the attribute once the resurface animation finishes. animationend
          // BUBBLES, and the hero/HUD subtree fires many unrelated animations, so we
          // must filter to OUR keyframe (dive-resurface) — otherwise a stray child
          // animationend would strip data-resurface mid-rise and snap the content in.
          // Fallback timer id (assigned below): under reduced motion the resurface
          // keyframe is gated off in CSS, so our animationend never fires — the timer
          // clears the attribute and detaches so nothing lingers or leaks the listener.
          let fallback = 0;
          const onEnd = (e: AnimationEvent) => {
            if (e.animationName !== 'dive-resurface') return;
            document.body.removeAttribute('data-resurface');
            document.body.removeEventListener('animationend', onEnd);
            window.clearTimeout(fallback);
          };
          document.body.addEventListener('animationend', onEnd);
          fallback = window.setTimeout(() => {
            document.body.removeAttribute('data-resurface');
            document.body.removeEventListener('animationend', onEnd);
          }, 1200);
        } else {
          // Normal nav / fresh load: ensure the overlay is hidden with no fade so a
          // page that wasn't reached via a dive never shows the white layer.
          overlay.style.transition = 'none';
          overlay.style.opacity = '0';
        }
      });
    </script>
  </body>
</html>
