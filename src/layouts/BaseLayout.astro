          </header>

          <main id="main-content">
            <slot />
          </main>

          <footer class="site-footer">
            <span>© {year} {SITE_TITLE}</span>
            <span class="socials">
              {SOCIALS.github && <a href={SOCIALS.github}>github</a>}
