---
/**
 * TesseractBackdrop — a bespoke, per-post backdrop layer.
 *
 * Scoped to the single post whose frontmatter sets `backdrop: 'tesseract'` (the
 * INSPIRATION / 01 page). It REPLACES the default dimmed live `<BlackHole backdrop>`
 * photon-ring scene for that one post; every other post keeps the live scene.
 *
 * The Interstellar bookcase corridor is a REAL-TIME WebGL scene built from REAL 3D
 * geometry: `buildTesseract` (→ `tesseract.glsl.ts` beam material) draws a dense lattice
 * of solid extruded BEAMS (one InstancedMesh of unit boxes) — the backs of bookshelves
 * stacked as a square shaft of streak-walls + cross-frames receding to a luminous
 * vanishing point — NOT a raymarch and NOT a static photo. It reads as cinematic
 * ATMOSPHERE: vignetted to near-black at the edges so the reading column floats, dimmed
 * to a deep-room level, with a soft scrim behind the centred copy and a light film grain
 * on top. The WebGL canvas sits UNDER those CSS overlays (vignette + scrim + grain),
 * which are unchanged from the image version. The lattice look lives in the rig + beam
 * shader; the framing/dimming lives in hero.css under `.tesseract-backdrop*`; this
 * component owns the markup + the mount script.
 *
 * Depth: position:fixed; inset:0; z-index:0 (mirrors `.bh-stage`), so it sits BEHIND
 * the reading column (`.prose` is z-index:1) and UNDER the `.dive-overlay` (z 9999).
 * Falling through the home-page black hole therefore resolves INTO this corridor:
 * the destination `<main>` rises via `body[data-resurface] main` while this fixed
 * layer stays put behind it.
 *
 * Interaction = pointer "look-around" + READING dolly. The mount script hands a -1..1
 * pointer offset to the rig's `setLook`, which eases the CAMERA pan + look target toward
 * the cursor so you peer down different axes of the lattice (the vanishing point slides),
 * like the film. ARTICLE SCROLL drives `setProgress`, which biases the camera's Z baseline
 * forward — a subtle scroll-coupled DOLLY DOWN the corridor as you read, in the spirit of
 * the scene-journey treatment on the other posts (but on this bespoke backdrop). Ambient:
 * the rig's own rAF loop advances time + a slow bounded breathe along Z (layered ON TOP
 * of the dolly baseline). Under `prefers-reduced-motion` the script renders ONE static
 * frame (no rAF, no look-around, no scroll-coupled dolly) — still the corridor, just
 * frozen. `aria-hidden` — it's mood.
 *
 * A passive reading-progress RAIL (rendered alongside the canvas markup below) reuses the
 * .article-hud / .article-hud-rail styles from article.css — same mono-gold instrument
 * language as the other articles' HUD, WITHOUT the section readout (this post has no
 * `##` headings, so a 00/00 sectioned HUD would be nonsense). The mount script sets the
 * rail's --article-progress custom property from window scroll. The rail keeps updating
 * under reduced motion (a CSS height fill is not vestibular motion).
 */
---

<div class="tesseract-backdrop" data-tesseract-backdrop aria-hidden="true">
  {/* The live corridor. The mount script (below) attaches a WebGL renderer to this
      canvas and renders the solid-beam lattice (InstancedMesh) each frame. Sits UNDER
      the vignette + grain. */}
  <canvas class="tesseract-backdrop-canvas" data-tesseract-canvas></canvas>
  {/* Near layer: vignette + reading-column scrim. Pure CSS gradients (unchanged). */}
  <div class="tesseract-backdrop-vignette"></div>
  {/* Film grain on top — static, low opacity, overlay-blended texture. */}
  <div class="tesseract-backdrop-grain"></div>
</div>

{/* Reading-progress rail. Reuses the .article-hud / .article-hud-rail styling so the
    gauge speaks the same mono-gold instrument language as every other article, WITHOUT
    the section readout (this post has no `##` sections — a sectioned HUD would track
    00/00 nonsense). The mount script sets `--article-progress` on the rail from window
    scroll. Pointer-transparent + position:fixed via .article-hud, so it never crowds
    the prose column. */}
<div class="article-hud tesseract-progress" data-tesseract-rail aria-hidden="true">
  <div class="article-hud-rail">
    <div class="article-hud-rail-fill"></div>
  </div>
</div>

{/* WebGL mount + pointer look-around driver. Bundled (no is:inline) so the
    `buildTesseract` import is processed by Vite and re-runs across ClientRouter swaps.
    Idempotent + SSR-guarded. Mounts the corridor on the canvas, drives `setLook` from
    pointermove (the rig lerps internally), resizes with the viewport, and disposes on
    `astro:before-swap`. Under prefers-reduced-motion it renders ONE static frame (no
    rAF, no look, no push-in) and binds no listeners. */}
<script>
  import { buildTesseract, type TesseractRig } from '../scene/buildTesseract';

  async function initTesseractBackdrop(): Promise<void> {
    if (typeof window === 'undefined') return;
    const layer = document.querySelector<HTMLElement>('[data-tesseract-backdrop]');
    if (!layer) return;
    const canvas = layer.querySelector<HTMLCanvasElement>('[data-tesseract-canvas]');
    if (!canvas) return;

    // Re-init guard: ClientRouter can swap the body and re-run this. Mount exactly once.
    const flagged = layer as HTMLElement & { dataset: DOMStringMap };
    if (flagged.dataset.tesseractMounted === '1') return;
    flagged.dataset.tesseractMounted = '1';

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let rig: TesseractRig;
    try {
      rig = buildTesseract({ canvas, maxPixelRatio: 2, dim: 0.62 });
    } catch {
      // No WebGL (or context creation failed): leave the dimmed CSS layers; the
      // reading column still floats in near-black. Release the guard so a later
      // navigation back can retry on a fresh canvas.
      flagged.dataset.tesseractMounted = '';
      return;
    }

    const sizeToViewport = (): void => {
      rig.resize(window.innerWidth, window.innerHeight);
    };
    sizeToViewport();

    // Reading-progress rail — same custom property contract as ArticleHud's rail
    // (article.css cascades `--article-progress` down to .article-hud-rail-fill's
    // height). Kept here so the rail stays driven even when scroll-coupled dolly is
    // suppressed by reduced motion.
    const rail = document.querySelector<HTMLElement>('[data-tesseract-rail]');
    const computeReadProgress = (): number => {
      // Anchor to the article body so the rail tracks PROSE scroll, not page chrome:
      // 0 when the article top hits the viewport top, 1 when its bottom hits the
      // viewport bottom. Falls back to whole-document scroll if the article element
      // is absent (defensive — the layout always renders it for posts).
      const article = document.querySelector<HTMLElement>('article.prose');
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      if (!article) {
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        return Math.min(1, Math.max(0, scrollY / max));
      }
      const start = article.offsetTop;
      const range = Math.max(1, article.offsetHeight - window.innerHeight);
      return Math.min(1, Math.max(0, (scrollY - start) / range));
    };
    const updateProgress = (): void => {
      const p = computeReadProgress();
      if (rail) rail.style.setProperty('--article-progress', String(p));
      // Reduced motion suppresses the scroll-coupled dolly (the rig stays frozen on
      // its single static frame); the rail still moves because a CSS height fill is
      // not vestibular motion. The check is re-evaluated below.
      rig.setProgress(p);
    };

    // Reduced motion: one frozen frame, no rAF, no pointer or scroll-coupled dolly.
    // The progress rail STILL updates from scroll — it's a passive readout, not motion
    // that could trigger vestibular discomfort.
    if (reduceMotion) {
      rig.renderOnce();
      if (rail) {
        const onScrollReduced = (): void => {
          const p = computeReadProgress();
          rail.style.setProperty('--article-progress', String(p));
        };
        onScrollReduced();
        window.addEventListener('scroll', onScrollReduced, { passive: true });
        document.addEventListener(
          'astro:before-swap',
          () => {
            window.removeEventListener('scroll', onScrollReduced);
            rig.dispose();
          },
          { once: true },
        );
        return;
      }
      document.addEventListener('astro:before-swap', () => rig.dispose(), { once: true });
      return;
    }

    // Pointer look-around: normalise the cursor to -1..1 and hand it to the rig, which
    // eases its own `uLook` toward it so the view direction shears down the tunnel
    // toward the cursor (the vanishing point slides) — the "peer around inside the
    // tesseract" move. Passive listener; the rig owns the smoothing + the rAF loop.
    const onPointerMove = (event: PointerEvent): void => {
      const nx = (event.clientX / window.innerWidth) * 2 - 1;
      const ny = (event.clientY / window.innerHeight) * 2 - 1;
      rig.setLook(nx, -ny); // flip Y so "up" on screen looks up the corridor
    };
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    // Scroll-coupled dolly + rail. The rig eases its OWN current toward the target each
    // frame, so the listener is a cheap setter — no rAF coalescing needed here. The
    // initial call seeds the dolly + rail to the article's current scroll position
    // (mid-page resurfaces and back-nav land already-scrolled).
    const onScroll = (): void => updateProgress();
    updateProgress();
    window.addEventListener('scroll', onScroll, { passive: true });

    const onResize = (): void => {
      sizeToViewport();
      updateProgress(); // viewport size affects the progress range
    };
    window.addEventListener('resize', onResize, { passive: true });

    rig.start();

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        rig.dispose();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', initTesseractBackdrop);
  void initTesseractBackdrop();
</script>
